procedure TfmParametrosAuditoria.CargarDet;
// Objetivo...: Cargar Determinación
var
  i: Integer;
  n: boolean;
Begin
  nomeclatura.getDatos(codex.Text);
  detex.Caption := nomeclatura.descrip;

  // Anexamos el Items
  n := false;
  if (length(trim(codex.Text)) = 4) then
    if (obsocial.Buscar(codosex.Text)) and (nomeclatura.Buscar(codex.Text)) then n := true;
  if (length(trim(codex.Text)) = 6) then
    if (obsocial.Buscar(codosex.Text)) and (nbu.Buscar(codex.Text)) then n := true;
  if (n) then begin
    For i := 1 to D.RowCount do Begin
      if Length(Trim(D.Cells[0, i])) = 0 then Break;
      if D.Cells[0, i] = codex.Text then Break;
    end;
    D.Cells[0, i] := codex.Text;
    D.Cells[1, i] := detex.Caption;
    D.Row         := i;

    auditoriacb.RegistrarDetRechazada(codosex.Text, codex.Text);
    CargarDetRech;

    codex.Text := ''; detex.Caption := '';
  end;
end;

procedure TfmParametrosAuditoria.CargarDetRech;
// Objetivo...: Cargar Determinaciones
var
  l: TObjectList;
  objeto: TTAuditoriaCCB;
  i: Integer;
Begin
  StatusBar1.Panels[0].Text := 'Cargando Datos ...!'; StatusBar1.Refresh;
  obsocial.getDatos(codosex.Text);
  grid.BorrarRenglon_SinRenumerar(D);
  l := auditoriacb.setDetRechazadas(codosex.Text);
  For i := 1 to l.Count do Begin
    objeto := TTAuditoriaCCB(l.Items[i-1]);
    D.Cells[0, i] := objeto.Codigo;
    if (obsocial.Factnbu = 'N') or (length(trim(objeto.Codigo)) = 4) then Begin
      nomeclatura.getDatos(D.Cells[0, i]);
      D.Cells[1, i] := nomeclatura.descrip;
    end;
    if (obsocial.Factnbu = 'S') and (length(trim(objeto.Codigo)) = 6) then Begin
      nbu.getDatos(D.Cells[0, i]);
      D.Cells[1, i] := nbu.Descrip;
    end;
  end;
  if (i > 0) then D.Row := i else D.Row := 1;  
  D.Refresh;
  l.Free; l := Nil;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

procedure TfmParametrosAuditoria.CargarDatosObraSocial2;
Begin
  obsocial.getDatos(codosex.Text);
  nosex.Caption := obsocial.Nombre;
  if obsocial.Factnbu = 'N' then codex.EditMask := '9999;1; ';
  if obsocial.Factnbu = 'S' then codex.EditMask := '999999;1; ';
  CargarDetRech;
  codex.SetFocus;
end;

procedure TfmParametrosAuditoria.CargarDatosObraSocial3;
Begin
  obsocial.getDatos(codosmc.Text);
  label94.Caption := obsocial.Nombre;
  CargarMedicosCabecera;
  idprofmc.SetFocus;
end;

procedure TfmParametrosAuditoria.CargarMedicosCabecera1;
// Objetivo...: Cargar datos Médico de Cabecera
Begin
  medico.getDatos(idprofmc.Text);
  Label97.Caption := medico.Nombre;
  CargarCapitas;
  cantcapitas.SetFocus;
end;

procedure TfmParametrosAuditoria.CargarMedicosCabecera;
// Objetivo...: Cargar Medicos de Cabecera
var
  l: TStringList;
  i, p: Integer;
Begin
  StatusBar1.Panels[0].Text := 'Cargando Datos ...!'; StatusBar1.Refresh;
  grid.IniciarGrilla(M);
  l := medcab.setListaMedicosCabecera(codosmc.Text);
  M.Row := 1;
  For i := 1 to l.Count do Begin
    p := Pos(';1', l.Strings[i-1]);
    M.Cells[0, i] := Copy(l.Strings[i-1], p+2, 4);
    M.Cells[1, i] := Copy(l.Strings[i-1], 1, p-1);
    M.Cells[2, i] := Trim(Copy(l.Strings[i-1], p+6, 10));
    if M.Cells[0, i] = idprofmc.Text then M.Row := i;
  end;
  l.Destroy;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

procedure TfmParametrosAuditoria.CargarCapitas;
// Objetivo...: Cargar Capitas
var
  l: TObjectList;
  objeto: TTMedicosCabCCB;
  i, j: Integer;
Begin
  grid.IniciarGrilla(C);
  C.Row := 1; j := 0;
  l := medcab.setCapitas(codosmc.Text, idprofmc.Text);
  For i := l.Count downto 1 do Begin
    Inc(j);
    objeto := TTMedicosCabCCB(l.Items[i-1]);
    C.Cells[0, j] := objeto.Periodo;
    C.Cells[1, j] := FloatToStr(objeto.Cantcapitas);
    if objeto.Periodo = periodo.Text then C.Row := j;
  end;
  l.Free; l := Nil;
end;

