procedure TfmObsociales.UKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_INSERT then Begin
    grid.InsertarLineasSinRenumerar(U);
    modifica := True;
    Inc(it);
  end;
  if Key = VK_DELETE then
    if utiles.BajaRegistro('Seguro que desea Eliminar Análisis ' + U.cells[1, U.Row] + ' ?') then Begin
      obsocial.BorrarUnidadNBU(codosnbu1.Caption, U.cells[0, U.Row]);
      grid.BorrarRenglon_SinRenumerar(U);
      grid.RegenerarItems(U, 3);
      Dec(it);
      ActualizarUnidadesNBU;
    end;
  if Key = VK_RETURN then Begin
    UDblClick(Sender);
    ActiveControl := codnbu;
  end;
end;

