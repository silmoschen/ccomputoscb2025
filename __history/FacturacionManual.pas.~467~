procedure TfmFactManual.enviarClick(Sender: TObject);
var
  datosok: Boolean;
  errores: array[1..4] of Boolean;
  i, j: Integer; con: Cardinal;
  Prioridad, ReqAut: Integer; UsuarioSMTP, PassSMTP: String;

  procedure CargarDatosConfigSMTP;
  var
    v1, v2, v3, v4, v5: String;
  begin
    if FileExists(dbs.DirSistema + '\smtpautenticado.ini') then Begin
      AssignFile(archivo, dbs.DirSistema + '\smtpautenticado.ini');
      Reset(archivo);
      ReadLn(archivo, v1);
      ReadLn(archivo, v2);
      ReadLn(archivo, v3);
      ReadLn(archivo, v4);
      ReadLn(archivo, v5);
      serverSMTP.Text  := v1;
      Prioridad        := StrToInt(v2);
      ReqAut           := StrToInt(v3);
      UsuarioSMTP      := v4;
      PassSMTP         := v5;
      closeFile(archivo);
    end;
  end;

begin
  if utiles.Sionoct('@', De.Text, 'De: direccion de E-Mail Incorrecta ...!') then errores[1] := True;
  if utiles.Sionoct('@', email.Text, 'Para: direccion de E-Mail Incorrecta ...!') then errores[2] := True;
  if Length(Trim(serverSMTP.Text)) = 0 then utiles.msgError('No se especifico Servidor SMTP para el Envio de Mensajes ...!') else errores[3] := True;
  j := 0;
  for i := 1 to E.RowCount do Begin
    if Length(Trim(E.Cells[0, i])) = 0 then Break;
    if E.Cells[2, i] = 'S' then Inc(j);
  end;
  if j = 0 then utiles.msgError('No ha Seleccionado Laboratorio a Exportar ...!') else errores[4] := True;
  if (errores[1]) and (errores[2]) and (errores[3]) and (errores[4]) then Begin
    i := 0; j := 0;
    iniciarClick(Sender);

    if not conexionDirecta.Checked then Begin
      Application.CreateForm(TAutoForm, AutoForm);
      Application.CreateForm(TConfigureAutoForm, ConfigureAutoForm);
      Application.CreateForm(TAboutForm, AboutForm);
      Application.CreateForm(TRasDialerForm, RasDialerForm);
      Application.CreateForm(TTimeAutoForm, TimeAutoForm);
      datosok := False;
      if Length(Trim(RasDialerForm.setIPAdress)) = 0 then   // Si No esta conectado
        if utiles.msgSiNo('Los Información a Exportar se Generó Correctamente,', 'Desea Conectarse a Internet y Realizar la Transferencia ?') then Begin
          RasDialerForm.ShowModal;
          con := RasDialerForm.hRasConn;
          datosok := True;
        end;
    end;

    if (Length(Trim(RasDialerForm.setIPAdress)) > 0) or (conexionDirecta.Checked) then Begin  // Significa que hay conexión
      Application.CreateForm(TfmMessageEditor, fmMessageEditor);
      fmMessageEditor.edtTo.Text      := email.Text;
      fmMessageEditor.edtSubject.Text := asunto.Text;
      fmMessageEditor.Memo1.Lines.Add('Facturación Período: ' + periodoExport.Text);
      for j := 1 to E.RowCount do Begin
        if Length(Trim(E.Cells[0, j])) = 0 then Break;
        if PM.Cells[0, j] = 'S' then fmMessageEditor.Memo1.Lines.Add(E.Cells[1, j] + '   ' + E.Cells[0, j] + '.bck');
      end;
      For i := 1 to attach.Lines.Count do Begin
        {$IFDEF VER140}
        TIdAttachment.Create(fmMessageEditor.IdMsgSend.MessageParts, attach.Lines[i-1]);
        {$ENDIF}
        {$IFDEF VER185}
        TIdAttachmentFile.Create(fmMessageEditor.IdMsgSend.MessageParts, attach.Lines[i-1]);
        {$ENDIF}
      end;
      StatusBar1.Panels[0].Text := 'Enviando Datos ...!'; StatusBar1.Refresh;

      CargarDatosConfigSMTP;

      fmMessageEditor.smtpSERVER            := serverSMTP.Text;
      fmMessageEditor.smtpPUERTO            := StrToInt(puerto.Text);
      fmMessageEditor.smtpDe                := de.Text;
      // Autenticación SMTP
      fmMessageEditor.SmtpAuthType          := ReqAut;
      fmMessageEditor.cboPriority.ItemIndex := Prioridad;
      fmMessageEditor.SmtpServerUser        := usuarioSMTP;
      fmMessageEditor.SmtpServerPassword    := passSMTP;

      fmMessageEditor.Label1.Caption   := 'Si No tiene Ajustes que hacer, Solo Haga Click en Enviar.';
      fmMessageEditor.conexion_directa := conexionDirecta.Checked;
      fmMessageEditor.ShowModal;
      fmMessageEditor.Release; fmMessageEditor := nil;
      StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
      CargarLaboratoriosExportados(il);
    end else Begin
      utiles.msgError('Actualmente está Sin Conexión a Internet,' + chr(13) + 'Imposible Realizar la Operación de Transferencia ...!');
      CargarLaboratoriosExportados('');
    end;

    CheckBox3.Checked := False;
    if CheckBox3.Checked then  Panel37.Visible := True else Panel37.Visible := False;

    if (datosok) and (Length(Trim(RasDialerForm.setIPAdress)) > 0) and not (conexionDirecta.Checked) then   // Si solo nos conectamos a Internet para transferir
      if utiles.msgSiNo('Los Datos se Transfirieron Correctamente', 'Quiere Desconectarse de Internet Ahora ?') then Begin
        StatusBar1.Panels[0].Text := 'Desconectando ...!'; Refresh;
        Application.CreateForm(TRasDialerForm, RasDialerForm);
        RasDialerForm.hRasConn := con;
        RasDialerForm.CancelButtonClick(Sender);
        StatusBar1.Panels[0].Text := ''; Refresh;
      end;

    if Assigned(RasDialerForm) then Begin
      RasDialerForm.Release; RasDialerForm := nil;
    end;
    if Assigned(ConfigureAutoForm) then Begin
      ConfigureAutoForm.Release; ConfigureAutoForm := nil;
    end;
    if Assigned(AboutForm) then Begin
      AboutForm.Release; AboutForm := nil;
    end;
    if Assigned(TimeAutoForm) then Begin
      TimeAutoForm.Release; TimeAutoForm := nil;
    end;

    facturacion.CopiarDatosExportados('0');   // 0 para que no copie... solo elimine los archivos temporales
    DriveComboBox.Enabled := False;
    CheckBox3.Enabled     := False;
    E.Row := 1; E.Refresh;
  end;
end;

