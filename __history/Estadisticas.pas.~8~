procedure TfmEstadisticas.ExportaraExcel20001Click(Sender: TObject);
begin
  if RadioButton7.Checked then Begin
    if Length(Trim(id.Caption)) = 0 then Begin
      utiles.msgError('No hay Obra Social Seleccionada ...!');
    end else Begin
      StatusBar1.Panels[0].Text := RadioButton7.Caption; StatusBar1.Refresh;
      facturacion.ProcesarDatosCentrales(periodo.Text);
      estadisticaCCB.InicidenciaPorDeterminacion_Detallada(periodo.Text, id.Caption, '', 'X', infobrasocial.Checked, separarCodigos.Checked, false, CheckBox2.Checked);
      estadisticaCCB.Listar('X');
    end;
  end;

  if RadioButton8.Checked then Begin
    if Length(Trim(id.Caption)) = 0 then Begin
      utiles.msgError('No hay Obra Social Seleccionada ...!');
    end else Begin
      StatusBar1.Panels[0].Text := RadioButton8.Caption; StatusBar1.Refresh;
      if (perunificados.Checked) then Begin
        facturacion.ProcesarDatosCentrales(periodo.Text);
        periodo.Text := facturacion.setPeriodoUnificacion;
        facturacion.ProcesarUnificados;
        estadisticaCCB.InicidenciaPorDeterminacion_Detallada(periodo.Text, id.Caption, facturacion.setPeriodoUnificacion, 'X', infobrasocial.Checked, separarCodigos.Checked, true, CheckBox2.Checked);
      End else Begin
        facturacion.ProcesarDatosCentrales(periodo.Text);
        estadisticaCCB.InicidenciaPorDeterminacion_Detallada(periodo.Text, id.Caption, '', 'X', infobrasocial.Checked, separarCodigos.Checked, true, CheckBox2.Checked);
      End;
      estadisticaCCB.Listar('X');
    end;
   end;

   if not (RadioButton7.Checked) and not (RadioButton8.Checked) then
     utiles.msgError('Operación No Soportada para este Informe ...!');

   salir.SetFocus;
end;

