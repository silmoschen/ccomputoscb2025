procedure TfmFactManual.CargarItemsDeterminacion;
var
  i, j: Integer;
begin
  // Cargamos el items
  if not modifica then Begin
    Inc(items);
    i := items;
  end else
    i := A.Row;

  // Si se esta modificando, el items que se agrega obligatoriamente debe ser del mismo paciente
  if CheckBox1.Checked then Begin
    if i = 1 then Begin
      codpac.Text := C.cells[0, i+1];
      pac.Caption := C.cells[1, i+1];
      gravadoiva.Caption := C.cells[2, i+1];
    end;

    if i > 1 then Begin
      codpac.Text := C.cells[0, i-1];
      pac.Caption := C.cells[1, i-1];
      gravadoiva.Caption := C.cells[2, i-1];
    end;
    C.cells[0, i] := codpac.Text;
    //if paciente.Buscar(idprof.Text, codpac.Text) then DatosPaciente;
  end;

  if (Length(Trim(codpac.Text)) = 0) and (A.Row > 1) then Begin
    pac.Caption := A.cells[4, i];
    codpac.Text := A.cells[5, i];
    gravadoiva.Caption := A.cells[9, i];
  end;

  A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
  A.cells[1, i] := codanalisis.Text;
  if obsocial.FactNBU = 'N' then A.cells[2, i] := nomeclatura.descrip;
  if obsocial.FactNBU = 'S' then A.cells[2, i] := nbu.descrip;
  if Length(Trim(A.cells[4, i])) = 0 then Begin
    A.cells[4, i] := pac.Caption;
    A.cells[5, i] := codpac.Text;
    A.cells[9, i] := gravadoiva.Caption;
  end;
  A.cells[6, i] := codos.Text;
  A.cells[7, i] := os.Caption;
  if not CheckBox1.Checked then A.cells[3, i] := id.Text else
  if Length(Trim(A.cells[3, i])) = 0 then
    if Length(Trim(A.cells[3, i-1])) > 0 then A.cells[3, i] := A.cells[3, i-1] else A.cells[3, i] := id.Text;
  A.Cells[8, i] := periodo1.Text;
  A.cells[9, i] := gravadoiva.Caption;

  // Corregimos todos los periodos si es un ajuste
  if (CheckBox1.Checked) then begin
    for j := 1 to A.RowCount do begin
      if (length(trim(A.Cells[0, j])) = 0) then break;
      if (A.cells[3, j] = id.Text) then A.cells[8, j] := periodo1.Text;
    end;
  end;   

  A.row         := i;

  A.Enabled         := True;
  finalizar.Enabled := True;
  cancelar.Enabled  := True;
  codanalisis.Text  := '';
  modifica          := False;
  ActiveControl := codanalisis;
end;

procedure TfmFactManual.BorrarRenglon;
//Objetivo...: Eliminar una Linea de detalle de la Factura
var
  i, x: integer;
begin
  //Quitamos el Renglon Seleccionado
  For i := A.row to A.RowCount do
    //Subimos un Renglon para Recortar el Eliminado
    if Length(Trim(A.cells[0, i])) > 0 then For x := 1 to A.ColCount do A.cells[x - 1, i] := A.cells[x - 1, i + 1];
  RegenerarItems;
  Dec(items);
  if CheckBox1.Checked then Begin
    if items = 0 then BorrarOperacionesObSoc {else RegistrarItems};
  End;
  //if items > 0 then A.Row := items;
end;

procedure TfmFactManual.InsertarLinea;
// Objetivo...: Insertar un movimiento en el Asiento
var
  i, x, t: integer; s, n, c, j: String;
begin
  x := A.RowCount;
  t := A.row;
  if A.Row > 1 then Begin     // Replicamos los valores a reutilzar
    s := A.cells[3, A.row-1];
    n := A.cells[4, A.row-1];
    c := A.cells[5, A.row-1];
    j := A.cells[9, A.row-1];
  end else Begin
    s := A.cells[3, A.row];
    n := A.cells[4, A.row];
    c := A.cells[5, A.row-1];
    j := A.cells[9, A.row-1];
  end;
  codpac.Text := c; pac.Caption := n; gravadoiva.Caption := j;
  while x > t do
    begin
      //Subimos un Renglon para Recortar el Eliminado
      For i := 1 to A.ColCount do A.cells[i - 1, x] := A.cells[i - 1, x - 1];
      A.cells[i - 1, x] := utiles.sLlenarIzquierda(IntToStr(A.row - 1), 3, '0');
      Dec(x);
    end;
  For x := 1 to A.ColCount do A.cells[x - 1, A.row] := '  ';
  A.cells[0, A.row] := '00';
  A.cells[3, A.row] := s;
  A.cells[4, A.row] := n;
  A.cells[5, A.row] := c;
  A.cells[9, A.row] := j;
  RegenerarItems;
  modifica := True;
end;

procedure TfmFactManual.RegenerarItems;
