  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_UP then ActiveControl := dc;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if utiles.Sionoct(string(ac.Text), 'SN', 'Opción Incorrecta ...!') then ActiveControl := av;
end;

