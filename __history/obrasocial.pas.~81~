procedure TfmObsociales.btnAjustarClick(Sender: TObject);
var
  i: integer;
begin
  Application.CreateForm(TfmAjusteLote, fmAjusteLote);

  if (CheckBox4.Checked) then begin
    grid.Sortgrid(A,0,1);
    for i := 1 to A.RowCount do begin
      if (length(trim(A.Cells[0, i])) = 0) then break;
      fmAjusteLote.B.Cells[0, i] := A.Cells[0, i];
      fmAjusteLote.B.Cells[1, i] := A.Cells[1, i];
      fmAjusteLote.B.Cells[3, i] := A.Cells[2, i];
      fmAjusteLote.B.Cells[4, i] := A.Cells[3, i];
      fmAjusteLote.B.Cells[5, i] := A.Cells[4, i];
      fmAjusteLote.B.Cells[6, i] := A.Cells[5, i];
      fmAjusteLote.B.Cells[7, i] := A.Cells[0, i];
    end;
  end else begin
    grid.Sortgrid(B,0,1);
    for i := 1 to B.RowCount do begin
      if (length(trim(B.Cells[0, i])) = 0) then break;
      fmAjusteLote.B.Cells[0, i] := B.Cells[0, i];
      fmAjusteLote.B.Cells[1, i] := B.Cells[1, i];
      fmAjusteLote.B.Cells[3, i] := B.Cells[2, i];
      fmAjusteLote.B.Cells[4, i] := B.Cells[3, i];
      fmAjusteLote.B.Cells[5, i] := B.Cells[4, i];
      fmAjusteLote.B.Cells[6, i] := B.Cells[5, i];
      fmAjusteLote.B.Cells[7, i] := B.Cells[6, i];
    end;
  end;

  fmAjusteLote.ShowModal;

  Refresh;

  if (fmAjusteLote.operacion = 1) then begin // Actualiza
    grid.Sortgrid(A,0,1);
    for i := 1 to fmAjusteLote.B.RowCount do begin
      if (length(trim(fmAjusteLote.B.Cells[0, i])) = 0) then break;
      if (fmAjusteLote.B.Cells[2, i] = 'S') then begin
        codanalisis.Text := fmAjusteLote.B.Cells[1, i];
        des.Caption := fmAjusteLote.B.Cells[3, i];
        periodoaf.Text := fmAjusteLote.B.Cells[9, i];
        importe.Text := fmAjusteLote.B.Cells[8, i];
        CargarGrilla;
        codanalisis.Text := ''; periodoaf.Text := ''; periodohasta.Text := ''; importe.Text := utiles.FormatearNumero('0');
        montosmod := true;
      end;
    end;
  end;

  if (fmAjusteLote.operacion = 2) then begin // Bajas
    for i := 1 to fmAjusteLote.B.RowCount do begin
      if (length(trim(fmAjusteLote.B.Cells[0, i])) = 0) then break;
      if (fmAjusteLote.B.Cells[2, i] = 'S') then begin
        if (factnbu.Text = 'N') then
          obsocial.BajaPeriodoMontoFijo(codos.Text, fmAjusteLote.B.Cells[7, i], fmAjusteLote.B.Cells[6, i]);
        if (factnbu.Text = 'S') then
          obsocial.BajaPeriodoMontoFijoNBU(codos.Text, fmAjusteLote.B.Cells[7, i], fmAjusteLote.B.Cells[6, i]);
      end;
    end;

    CargarDeterminacionesMontoFijo;
    
  end;

  codanalisis.SetFocus;

  fmAjusteLote.Release; fmAjusteLote := nil;
end;

