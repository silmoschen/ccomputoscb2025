procedure TfmObsociales.CargarGrilla;
var
  i, l, j: integer;
begin
  modifica := BuscarAnalisis(codanalisis.Text);

  For j := 1 to A.RowCount do Begin
    it := j;
    if Length(Trim(A.Cells[0, j])) = 0 then Break;
  end;

  if not modifica then i := it else i := A.row;

  l := obtenerlinea(codanalisis.Text, periodoaf.Text);  // Buscamos la Ranura para Mantener el orden con los códigos
  if l > 0 then Begin
    if not modifica then Begin
      //if l > 1 then l := l + 1;
      if l > 1 then l := l + 1 else
        if Length(Trim(A.Cells[0, l+1])) > 0 then l := l + 1;

      A.Row := l;
      grid.InsertarLinea(A, 3);
      i := l;
    end;

    if modifica then Begin
      A.Row := l;
      i     := l;
