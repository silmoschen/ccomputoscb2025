procedure TfmExportarOrdenesSoporteMagnetico.btnAllClick(Sender: TObject);
var
  i: integer;
begin
 if ( (listprof.Text = '0') or (listprof.Text = '1') ) then
   if not utiles.msgSiNo('Seguro para Aplicar está Opción ?') then exit;

 if (listprof.Text = '0') then begin
   for i := 1 to A.RowCount do begin
      if (length(trim(A.Cells[0, i])) = 0) then break;
      A.Cells[8, i] := tipo.Text;
      A.Cells[9, i] := sucursal.Text;
      A.Cells[10,i] := numero.Text;
      if (length(trim(fecha.Text)) = 8) then A.Cells[11,i] := fecha.Text else A.Cells[11,i] := '';
      exportObrasSociales.Registrar(periodo.Text, A.Cells[1, i], idos.Text, A.Cells[11,i], A.Cells[8,i], A.Cells[9,i], A.Cells[10,i]);
    end;
    btnEnviar.Enabled := true;
 end;

 if (listprof.Text = '1') then begin
   for i := 1 to A.RowCount do begin
      if (length(trim(A.Cells[0, i])) = 0) then break;
      if (A.Cells[13, i] = 'N') then begin
        A.Cells[8, i] := tipo.Text;
        A.Cells[9, i] := sucursal.Text;
        A.Cells[10,i] := numero.Text;
        if (length(trim(fecha.Text)) = 8) then A.Cells[11,i] := fecha.Text else A.Cells[11,i] := '';
        exportObrasSociales.Registrar(periodo.Text, A.Cells[1, i], idos.Text, A.Cells[11,i], A.Cells[8,i], A.Cells[9,i], A.Cells[10,i]);
      end;
    end;
    btnEnviar.Enabled := true;
 end;

 if (listprof.Text > '1') then begin
   for i := 1 to A.RowCount do begin
      if (length(trim(A.Cells[0, i])) = 0) then break;
      if (A.Cells[1, i] = listprof.Text) then begin
        A.Cells[8, i] := tipo.Text;
        A.Cells[9, i] := sucursal.Text;
        A.Cells[10,i] := numero.Text;
        if (length(trim(fecha.Text)) = 8) then A.Cells[11,i] := fecha.Text else A.Cells[11,i] := '';
        exportObrasSociales.Registrar(periodo.Text, A.Cells[1, i], idos.Text, A.Cells[11,i], A.Cells[8,i], A.Cells[9,i], A.Cells[10,i]);
      end;
    end;
    btnEnviar.Enabled := true;
 end;

end;

procedure TfmExportarOrdenesSoporteMagnetico.btnEnviarClick(Sender: TObject);
begin
  if (idregla.Text = '10') then begin
    utiles.msgError('Esta Obra Social se debe Exportar desde la Solapa Exportación por Regla');
    exit;
  end;


  if not (utiles.msgSiNo('Este Proceso Generará y Enviará los Archivos Correspondientes.')) then exit;

  if (idregla.Text = '3') then generarArchivoR1;   // Jerarquicos
  if (idregla.Text = '1') then generarArchivoR2;   // ACA SALUD
  if (idregla.Text = '5') then generarArchivoR3;   // SANCOR
  if (idregla.Text = '6') then generarArchivoR6;   // FEDERADA
  if (idregla.Text = '13') then generarArchivoR13;   // DASUTEN

end;

procedure TfmExportarOrdenesSoporteMagnetico.btnGenerarArchClick(
  Sender: TObject);
begin
  if (reglanumero.Text = '10') then generarArchivoR10;   // Fe Salud

end;

procedure TfmExportarOrdenesSoporteMagnetico.btnMontosClick(Sender: TObject);
begin
  if (utiles.msgSiNo('Este Proceso puede Demorar. No lo Interrumpa. Seguro para Iniciar ?') = false) then exit;
  StatusBar1.Panels[0].Text := 'Procesando ...!'; StatusBar1.refresh;
  facturacion.recalcularMontosAnalisisRI(periodo.Text, idos.Text);
  Refresh;
  facturacion.ConectarTotalesProf;
  recalcular := true;
  cargarObrasSociales;
  facturacion.DesconectarTotalesProf;
  recalcular := false;
  StatusBar1.Panels[0].Text := ''; StatusBar1.refresh;
end;

procedure TfmExportarOrdenesSoporteMagnetico.btnMostrarDatosClick(
  Sender: TObject);
var
  r: TQuery;
  i: integer;
begin
  Application.CreateForm(TfmDetalleFacturado, fmDetalleFacturado);

  fmDetalleFacturado.Caption := 'Detalle Facturado - Período: ' + periodo.text;
  fmDetalleFacturado.A.Cells[0, 0] := 'Fecha';
  fmDetalleFacturado.A.Cells[1, 0] := 'Tipo';
  fmDetalleFacturado.A.Cells[2, 0] := 'Sucursal';
  fmDetalleFacturado.A.Cells[3, 0] := 'Número';
  fmDetalleFacturado.A.Cells[4, 0] := 'Monto';
  fmDetalleFacturado.A.Cells[5, 0] := 'Profesional';

  r := facturacion.exportarReglaFacturasRI(periodo.text);
  r.open; i := 0;
  while not r.eof do begin
    inc(i);
    fmDetalleFacturado.A.Cells[0, i] := r.fieldbyname('op1').asstring;
    fmDetalleFacturado.A.Cells[1, i] := r.fieldbyname('tipo').asstring;
    fmDetalleFacturado.A.Cells[2, i] := r.fieldbyname('sucursal').asstring;
    fmDetalleFacturado.A.Cells[3, i] := r.fieldbyname('numero').asstring;
    fmDetalleFacturado.A.Cells[4, i] := utiles.FormatearNumero(r.fieldbyname('monto').asstring);
    profesional.getDatos(r.fieldbyname('idprof').asstring);
    fmDetalleFacturado.A.Cells[5, i] := profesional.codigo + ' - ' + profesional.nombre;

    r.next;
  end;
  r.close; r.free;

  r := facturacion.exportarReglaFacturasRM(periodo.text);
  r.open;
  while not r.eof do begin
    inc(i);
    fmDetalleFacturado.A.Cells[0, i] := r.fieldbyname('op1').asstring;
    fmDetalleFacturado.A.Cells[1, i] := r.fieldbyname('tipo').asstring;
    fmDetalleFacturado.A.Cells[2, i] := r.fieldbyname('sucursal').asstring;
    fmDetalleFacturado.A.Cells[3, i] := r.fieldbyname('numero').asstring;
    fmDetalleFacturado.A.Cells[4, i] := utiles.FormatearNumero(r.fieldbyname('monto').asstring);
    fmDetalleFacturado.A.Cells[5, i] := '*** ASOCIACION ***';

    r.next;
  end;
  r.close; r.free;

  fmDetalleFacturado.ShowModal;

  fmDetalleFacturado.Release; fmDetalleFacturado := nil;
end;

