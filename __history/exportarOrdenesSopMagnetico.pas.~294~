procedure TfmExportarOrdenesSoporteMagnetico.generarArchivoR2;
var
  importe, archivo, nroafiliado, convenio, sepa: string;
  arch: TextFile;
  i: integer;
  total, monto1, total2: real;
  r: TIBQuery;
begin
  if not (DirectoryExists(dbs.DirSistema + '\work\exportsopmag')) then utilesarchivos.CrearDirectorio(dbs.DirSistema + '\work\exportsopmag');
  archivo := dbs.DirSistema + '\work\exportsopmag\' + idos.Text + '_' + utiles.StringRemplazarCaracteres(periodo.Text, '/', '_') + '.txt';
  AssignFile(arch, archivo);
  rewrite(arch);

  obsocial.getRegla(idos.Text);
  convenio := obsocial.Convenio;

  obsocial.SincronizarPosicionFiscal(idos.Text, periodo.Text);

  r := facturacion.getListItemsFacturados(periodo.Text, idos.Text);
  //r := facturacion.getListItemsFacturadosProfesional(periodo.Text, idos.Text, '211081');
  r.open; i := 1; total := 0;

  //sepa := ';';
  sepa := '';
           
  while not r.eof do begin

    auditoriacb.getDatos(r.FieldByName('nroauditoria').AsString);

    nbu.getDatos(r.FieldByName('codanalisis').asString);
    profesional.getDatos(r.FieldByName('idprof').asString);

    // Prorrateamos comprobante
    exportObrasSociales.getDatos(periodo.Text, r.FieldByName('idprof').asstring, idos.Text);

    monto1 := r.FieldByName('iva').AsFloat * (obsocial.retencioniva * 0.01);
    total  := total + (r.FieldByName('monto').asfloat + monto1);
    total2 := r.FieldByName('monto').asfloat + monto1;

    nroafiliado := utiles.sLlenarIzquierda(trim(copy(r.FieldByName('nroafiliado').AsString, 1, 8)), 10, '0');

    write(arch, utiles.sLlenarDerecha(nroafiliado, 10, ' ') + sepa);
    write(arch, utiles.sLlenarDerecha(trim(auditoriacb.Transaccion), 10, ' ') + sepa);
    write(arch, utiles.sExprFecha2000(auditoriacb.Fecha) + sepa);
    write(arch, utiles.sExprFecha2000(auditoriacb.Fepedido) + sepa);

    write(arch, 'FAC' + exportObrasSociales.Tipo + sepa);
    write(arch, exportObrasSociales.Tipo + sepa);
    write(arch, exportObrasSociales.Sucursal + sepa);
    write(arch, exportObrasSociales.Numero + sepa);
    write(arch, utiles.sLlenarDerecha(auditoriacb.Idprof, 10, ' ') + sepa);
    write(arch, utiles.sLlenarDerecha(r.FieldByName('idprof').AsString, 10, ' ') + sepa);
    write(arch, utiles.sLlenarDerecha(r.FieldByName('codanalisis').AsString, 10, ' ') + sepa);
    importe :=  utiles.FormatearNumero(r.FieldByName('monto').asString);
    //importe :=  utiles.FormatearNumero(FloatToStr(total2));
    write(arch, utiles.sLlenarIzquierda(utiles.StringRemplazarCaracteres(importe, ',', '.'), 10, '0') + sepa);
    writeLn(arch, utiles.sLlenarIzquierda(profesional.Nrocuit, 13, '0') + sepa);

    //monto1 := r.FieldByName('iva').AsFloat * (obsocial.retencioniva * 0.01);
    //total := total + (r.FieldByName('monto').asfloat + monto1);

    r.next;
  end;

  closeFile(arch);

  montoexport.Caption := utiles.FormatearNumero(FloatToStr(total));
end;

