procedure TfmIngreso.DDrawCell(Sender: TObject; ACol, ARow: Integer;
  Rect: TRect; State: TGridDrawState);
var
  Grid      : TStringGrid;
  Texto     : String;
begin
  if (ACol = 0) or (ARow = 0) then ALINEACION := DT_LEFT else ALINEACION := DT_RIGHT;

  Grid := TStringGrid(Sender);
  objeto := Grid.Name;

  if (ARow < Grid.FixedRows) or (ACol < Grid.FixedCols)
  then
    Grid.Canvas.Brush.Color := clBtnFace
  else
    Grid.Canvas.Brush.Color := clWhite;

  Grid.Canvas.FillRect(Rect);
  Texto := ' ' + Grid.Cells[ACol,ARow] + '  ';
  DrawText( Grid.Canvas.Handle,
            PChar(Texto),
            StrLen(PChar(Texto)),
            Rect,
            ALINEACION);

  if Sender = A then DrawCell(A, ACol, ARow, Rect, State);
  if Sender = D then DrawCell(D, ACol, ARow, Rect, State);
  if Sender = M then DrawCell(M, ACol, ARow, Rect, State);
end;

