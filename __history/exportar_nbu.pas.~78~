               '''' + t.FieldByName('efector').AsString + '''' + ', ' +
               '''' + t.FieldByName('fecha').AsString + '''' + ', ' +
               '''' + t.FieldByName('codos').AsString + '''' + ', ' +
               '''' + t.FieldByName('idzona').AsString + '''' + ', ' +
               '''' + t.FieldByName('nrodoc').AsString + '''' + ', ' +
               '''' + t.FieldByName('idprof').AsString + '''' + ', ' +
               '''' + t.FieldByName('observacion').AsString + '''' + ', ' +
               '''' + t.FieldByName('fepedido').AsString + '''' + ', ' +
               '''' + pc + '''' + ', ' +
               '''' + t.FieldByName('iddiag').AsString + '''' + ', ' +
               '''' + t.FieldByName('diferida').AsString + '''' + ', ' +
               '''' + au + '''' + ', ' +
               '''' + t.FieldByName('anulada').AsString + '''' + ', ' +
               '''' + 'administ' + '''' + ');');

    t.Next;
  end;
  t.Close;
  closeFile(a);
  Close;
