procedure TfmBajarActualizaciones.Panel1Resize(Sender: TObject);
begin
  redim := True;
end;

procedure TfmBajarActualizaciones.SiClick(Sender: TObject);
begin
  if Length(Trim(S.cells[0, S.row])) > 0 then Begin
    if S.cells[1, S.row] <> 'S' then S.cells[1, S.row] := 'S' else S.cells[1, S.row] := ' ';
    if (S.row < S.rowcount) and (Length(Trim(S.cells[0, S.row + 1])) > 0) then S.row := S.row + 1;
    S.Refresh;
  end;
end;

procedure TfmBajarActualizaciones.TodosClick(Sender: TObject);
var
  i: integer;
begin
  For i := 1 to S.RowCount do Begin
    if Length(Trim(S.Cells[0, i])) = 0 then Break;
    S.cells[1, i] := 'S';
  end;
  S.Refresh;
end;

procedure TfmBajarActualizaciones.NingunoClick(Sender: TObject);
var
  i: integer;
begin
  For i := 1 to S.RowCount do Begin
    if Length(Trim(S.Cells[0, i])) = 0 then Break;
    S.cells[1, i] := '';
  end;
  S.Refresh;
end;

procedure TfmBajarActualizaciones.SKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_SPACE then SiClick(Self);
  if Key = VK_RETURN then
    if transferir.Enabled then transferir.setFocus;
end;

procedure TfmBajarActualizaciones.actualizarClick(Sender: TObject);
var
  lista: TStringList;
  i: Integer;
begin
  lista := TStringList.Create;
  for i := 1 to S.RowCount do Begin
    if Length(Trim(S.Cells[0, i])) = 0 then Break;
    if S.Cells[1, i] = 'S' then lista.Add(S.Cells[0, i]);
  end;

  if lista.Count = 0 then utiles.msgError('No hay Obras Sociales Seleccionadas para Actualizar ...!') else Begin
    Actualizar(lista);
    Cerrar.SetFocus;
  end;

  lista.Destroy; lista := Nil;
end;

end.
