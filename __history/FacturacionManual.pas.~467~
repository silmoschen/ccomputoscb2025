procedure TfmFactManual.btnExportWebClick(Sender: TObject);
var
  a: string;
begin
  if (RadioButton4.Checked) or (RadioButton5.Checked) then else begin
    utiles.msgError('Opción No Soportada para Distribución en la Web ...!');
    exit;
  end;
  if (utiles.msgSiNo('Seguro para Exportar Informes Facturaciones a Profesionales a la Web ?') = false) then exit;
  refresh;

  a := altopag.Text;
  altopag.Text := '100';
  facturacion.exporta_web := true;
  emitirClick(Self);
  facturacion.exporta_web := false;
  altopag.Text := a;

  Application.CreateForm(TfmUploadFTP, fmUploadFTP);
  if (RadioButton4.Checked) then fmUploadFTP.modulo.Caption := 'Facturación';
  if (RadioButton5.Checked) then fmUploadFTP.modulo.Caption := 'Resumen Facturación';
  fmUploadFTP.ShowModal;
  per.SetFocus;
end;

procedure TfmFactManual.ArancelesDifClick(Sender: TObject);
begin
  if fmEleObraSociales.cantidadSel = 1 then Begin
    if ArancelesDif.Checked then Begin
      Application.CreateForm(TfmListObrasSociales, fmListObrasSociales);
      fmListObrasSociales.introSalir := True;
      fmListObrasSociales.ShowModal;
      Refresh;
      if fmListObrasSociales.seleccionOK then Begin
        osdif.Caption := '(' + obsocial.tabla.FieldByName('codos').AsString + ')';
        dispSalida.SetFocus;
      end else Begin
        osdif.Caption := '';
        ArancelesDif.Checked := False;
      end;
      fmListObrasSociales.Release; fmListObrasSociales := nil;
    end else Begin
      osdif.Caption := '';
      per.SetFocus;
    end;
  end else Begin
    if ArancelesDif.Checked then utiles.msgError('Es Necesario Seleccionar Previamente una Obra Social,' + chr(13) + ' actualmente hay (' + IntToStr(fmEleObraSociales.cantidadSel) + ') Seleccionadas ...!');
    ArancelesDif.Checked := False;
  end;
end;

procedure TfmFactManual.ConsultarClick(Sender: TObject);
var
  s, nrocol: String;
  list: TStringList;
begin
  if profesional.Buscar(idprof.Text) then Begin
    s := StatusBar1.Panels[0].Text;
    StatusBar1.Panels[0].Text := 'Gen. Inf. Controles Finales ...!'; StatusBar1.Refresh;
    nrocol := inf6.Text;
    if Length(Trim(nrocol)) = 0 then nrocol := '5';
    if obsocial.Buscar(codos.Text) then Begin
      list := TStringList.Create;
      list.Add(codos.Text);
    end else
      list := Nil;
    facturacion.DireccionarLaboratorio(periodo.Text, idprof.Text);
    facturacion.ListarControlesFinales(periodo.Text, titulo.Text, nrocol, fmEleProfesional.lista, list, True, 'P');
    StatusBar1.Panels[0].Text := s;
  end else
    utiles.msgError('No hay Profesional Ingresado ...!');
end;

procedure TfmFactManual.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_F5 then
    if PageControl1.ActivePage = TabSheet1 then ConsultarClick(Self);
end;

