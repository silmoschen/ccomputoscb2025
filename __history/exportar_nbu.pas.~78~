procedure TfmExportarNBU.Button7Click(Sender: TObject);
var
  t, s, d: TTable;
  a, b, c: TextFile;
  diag: string;
begin
  AssignFile(a, 'c:\cab_auditoria.sql');
  AssignFile(b, 'c:\det_auditoria.sql');
  AssignFile(c, 'c:\bioqafil.sql');
  rewrite(a);
  rewrite(b);
  rewrite(c);
  t := datosdb.openDB('cab_auditoria', '', '', 'datos');
  s := datosdb.openDB('det_auditoria', '', '', 'datos');
  d := datosdb.openDB('diagnosticos_oms', '', '', 'datos');
  //datosdb.Filtrar(t, 'codos = ' + '''' + '121005' + '''' + ' and fecha >= ' + '''' + '20090101' + '''');
  datosdb.Filtrar(t, 'codos = ' + '''' + '000129' + '''' + ' and fecha >= ' + '''' + '20090101' + '''');
  t.Open;
  s.Open;
  d.open;
  d.indexfieldnames := 'codrap';
  while not t.Eof do begin
    d.FindKey([t.FieldByName('iddiag').AsString]);
    diag := d.FieldByName('oms_cod').AsString;
    writeln(a, 'insert into cab_auditoria(nroauditoria, fecha, codos, idzona, nrodoc, idprof, diagnostico, federivacion, nroderivacion, observacion, idfact, fechafac, laboratorio, codosfact, fepedido, profcab, iddiag, nombre, diferida, auditada, anulada, efector) values ' +
           '(' + '''' + t.FieldByName('nroauditoria').AsString + '''' + ', ' + '''' + t.FieldByName('fecha').AsString + '''' + ', ' + '''' + t.FieldByName('codos').AsString + '''' + ', ' + '''' + t.FieldByName('idzona').AsString + '''' + ', ' + '''' + utiles.sLlenarIzquierda(t.FieldByName('nrodoc').AsString, 8, '0') + '''' + ', ' +
           '''' + t.FieldByName('idprof').AsString + '''' + ', ' + '"' + t.FieldByName('diagnostico').AsString + '"' + ', ' + '''' + t.FieldByName('federivacion').AsString + '''' + ', ' + '''' + t.FieldByName('nroderivacion').AsString + '''' + ', ' + '"' + t.FieldByName('observacion').AsString + '"' + ', ' +
           '''' + t.FieldByName('idfact').AsString + '''' + ', ' + '''' + t.FieldByName('fechafac').AsString + '''' + ', ' + '''' + t.FieldByName('laboratorio').AsString + '''' + ', ' + '''' + t.FieldByName('codosfact').AsString + '''' + ', ' + '''' + t.FieldByName('fepedido').AsString + '''' + ', ' +
           '''' + t.FieldByName('profcab').AsString + '''' + ', ' + '''' + diag + '''' + ', ' + '"' + t.FieldByName('nombre').AsString + '"'  +
           ', ' + '''' + 'S' + '''' + ', ' + '''' + 'S' + '''' + ', ' + '''' + 'N' + '''' + ', ' + '''' + t.FieldByName('laboratorio').AsString + '''' +
           ');');
    s.IndexFieldNames := 'nroauditoria;items';
    s.SetKey;
    s.FieldByName('nroauditoria').AsString := t.FieldByName('nroauditoria').AsString;
    s.FieldByName('items').AsString := '001';
    //utiles.msgError(t.FieldByName('nroauditoria').AsString);
    if s.GotoKey then begin
      while not s.eof do begin
        if s.FieldByName('nroauditoria').AsString <> t.FieldByName('nroauditoria').AsString then break;
        writeln(b, 'insert into det_auditoria(nroauditoria, items, codigo, monto, estado, montodif, efector, fecha, codos, nrodoc, anulada) values ' +
           '(' + '''' + s.FieldByName('nroauditoria').AsString + '''' + ', ' + '''' + s.FieldByName('items').AsString + '''' + ', ' + '''' + s.FieldByName('codigo').AsString + '''' + ', ' + utiles.StringRemplazarCaracteres(s.FieldByName('monto').AsString, ',', '.') + ', ' + '''' + s.FieldByName('estado').AsString + '''' + ', ' +
           utiles.StringRemplazarCaracteres(s.FieldByName('montodif').AsString, ',', '.') + ', ' + '''' + utiles.sLlenarIzquierda(t.FieldByName('laboratorio').AsString, 6, '0') + '''' + ', ' + '''' + t.FieldByName('fecha').AsString + '''' + ', ' + '''' + t.FieldByName('codos').AsString + '''' + ', ' + '''' + utiles.sLlenarIzquierda(t.FieldByName('nrodoc').AsString, 8, '0') + '''' + ', ' + '''' + 'N' + '''' +
           ');' );
        s.Next;
      end;
    end;
    //writeln(c, 'insert into bioqafil(codos, nrodoc, nombre) values (' + '''' + t.FieldByName('codos').AsString + '''' + ', ' + '''' + t.FieldByName('nrodoc').AsString + '''' + ', ' + '''' + t.FieldByName('nombre').AsString + '''' + ');');
    t.Next;
  end;
  t.Close;
  s.Close;
  closeFile(a);
  closeFile(b);
  closeFile(c);
  Close;
end;

