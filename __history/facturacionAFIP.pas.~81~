  facturacion.desconectar;
  empresa.desconectar;
  obsocial.desconectar;
  configform.Guardar(fmFacturacionAfip, redim);
  grid.GuardarAnchoColumnas(fmFacturacionAfip, D);
  Release; fmFacturacionAfip := nil;
end;

