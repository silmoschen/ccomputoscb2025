procedure TfmFactManual.iniciarClick(Sender: TObject);
var
  i, j: Integer; Continuar: Boolean; d, tExport: Char;
  listOS: TStringList;
begin
  j := 0;
  for i := 1 to E.RowCount do Begin
    if Length(Trim(E.Cells[0, i])) = 0 then Break;
    if E.Cells[2, i] = 'S' then Inc(j);
  end;
  if j = 0 then begin
    utiles.msgError('No ha Seleccionado Laboratorio a Exportar ...!');
    CheckBox10.Checked := false;
    exit;
  end;

  listOS := TStringList.Create;

  if CheckBox3.Checked then tExport := 'E' else tExport := 'D';   // E (email) D (diskette)
  if CheckBox10.Checked then tExport := 'R';

  Continuar := True; attach.Lines.Clear;

  // Control de las obras sociales que se exportan
  il := '';
  if selOS.Checked then     // Recuperamos las obras sociales seleccionadas
    For i := 1 to O.RowCount do
      if Length(Trim(O.Cells[0, i])) = 0 then Break else
        if O.Cells[1, i] = 'S' then listOS.Add(O.Cells[0, i]);

  if not (CheckBox7.Checked) then begin
    if ((Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'a') or (Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'b')) and (tExport = 'D') then Begin
      if Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'a' then d := 'a';
      if Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'b' then d := 'b';
      ShowMessage('Inserte un Diskette en la Unidad ' + (UpperCase(Copy(DriveComboBox.Text, 1, 1))) + ': para Formatearlo,' + CHR(13) + 'este paso es Obligatorio, si lo omite no podrá' + CHR(13) + 'completar el Proceso de Exportación.');
      Continuar := utilesarchivos.FormatearDiskette(d);
      if Continuar then ShowMessage('El Disco ha sido Formateado Satisfactoriamente, ' + CHR(13) + 'se Procedera a Transferir los Datos al mismo.');
    end;
  end else
    Continuar := true;

  if Continuar then Begin
    StatusBar1.Panels[0].Text := 'Procesando datos a Exportar ...!'; StatusBar1.Refresh;
    For i := 1 to E.RowCount do Begin
      if Length(Trim(E.cells[0, i])) = 0 then Break;
      E.Row := i; E.Refresh;
      if E.cells[2, i] = 'S' then Begin
        facturacion.ExportarTotalesProfInscriptosIVA := true;
        facturacion.Exportar(periodoExport.Text, E.cells[0, i], E.cells[1, i], listOS, ExportarPac.Checked);
        il := E.cells[0, i];
        if tExport = 'E' then   // Extraemos la lista de archivos exportados para generar el attach
          if Length(Trim(facturacion.attach)) > 0 then Begin
            if attach.Lines.Count = 0 then attach.Lines.Add(facturacion.attach) else
               attach.Lines.Add(facturacion.attach);
           end;
        StatusBar1.Panels[0].Text := 'Laboratorio: ' + E.cells[0, i] + '  ' + E.cells[1, i]; StatusBar1.Refresh;
      end;
    end;

    StatusBar1.Panels[0].Text := 'Transfiriendo datos Exportados ...!'; StatusBar1.Refresh;

    if (tExport <> 'E') and (tExport <> 'R') then Begin  // Copiamos al medio si los datos no se transfieren por e-mail
      if not (CheckBox7.Checked) then  // Copia a diskette
        facturacion.CopiarDatosExportados(Copy(DriveComboBox.Text, 1, 2));
      if (CheckBox7.Checked) then begin  // Elegimos la Carpeta donde Copiarlo
        Application.CreateForm(TfmSelectCarpeta, fmSelectCarpeta);
        fmSelectCarpeta.ShowModal;
        if (length(trim(fmSelectCarpeta.sel)) > 0) then begin
          if utiles.msgSiNo('Exportar Datos a ' + fmSelectCarpeta.sel + ' ?') then begin
            Refresh;
            facturacion.CopiarDatosExportados(fmSelectCarpeta.sel);
          end;
        end;

        fmSelectCarpeta.Release; fmSelectCarpeta := Nil;
        CheckBox7.Checked := false;
      end;
      iniciar.Enabled := False;
      ActiveControl := periodoExport;
    end;

    if (tExport = 'R') then begin
      utilesarchivos.CrearDirectorio(dbs.DirSistema + '\exportar\ftp');
      utilesarchivos.BorrarArchivos(dbs.DirSistema + '\exportar\ftp', '*.bck');
      facturacion.CopiarDatosExportados(dbs.DirSistema + '\exportar\ftp');
    end;

    StatusBar1.Panels[0].Text := '';
    selOS.Checked := False;

    CargarLaboratoriosExportados(il);

    if CheckBox3.Checked then  Panel37.Visible := True else Panel37.Visible := False;
    //ExportarPac.Checked := False;     29/04/2014

  end else utiles.msgError('Se ha producido un Error, la Operación ha Fracasado ...!');
end;

