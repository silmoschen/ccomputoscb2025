function  TfmObsociales.BuscarAnalisis(xcodanalisis: string): boolean;
var
  i: integer;
begin
  Result := False;
  For i := 1 to A.RowCount do
    if A.cells[0, i] = xcodanalisis then Begin
      Result := True;
      Break;
    end;
end;

