begin
  if Key = VK_UP then idinsumo.SetFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if Length(Trim(cantidad.Text)) > 0 then Begin
      cantidad.Text := utiles.FormatearNumero(cantidad.Text);
