unit refacturar;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, ExtCtrls, CFacturacionCCB, IBQuery;

type
  TfmRF = class(TForm)
    Panel2: TPanel;
    ScrollBox: TScrollBox;
    Panel3: TPanel;
    F: TStringGrid;
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    periodo, codos: string;
  end;

var
  fmRF: TfmRF;

implementation

{$R *.dfm}

procedure TfmRF.FormShow(Sender: TObject);
var
  r: TIBQuery;
  i: integer;
begin
  r := facturacion.getLaboratoriosARefacturar(periodo, codos);

  r.open; i := 0;
  while not r.eof do begin
    inc(i);
    F.Cells[0, i] := r.fieldbyname('idprof').asstring;
    r.next;
  end;

  r.close; r.free;

end;


end.
