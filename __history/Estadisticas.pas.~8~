procedure TfmEstadisticas.dispSalidaClick(Sender: TObject);
begin
  if not Assigned(Dispositivo) then Application.CreateForm(TDispositivo, Dispositivo);
  Dispositivo.ShowModal;
  salida := 'P';
  if Dispositivo.Impresor.Checked then
    if not impresiontxt.Checked then salida := 'I' else salida := 'T';
  if salida = 'T' then estadisticaccb.LineasPag := StrToInt(lineas.Text);
  ActiveControl := emitir;
end;

procedure TfmEstadisticas.FormShow(Sender: TObject);
var
  m, e, s: String;
begin
  Application.CreateForm(TfmEleObraSociales, fmEleObraSociales);
  Application.CreateForm(TfmEleMedicos, fmEleMedicos);
  Application.CreateForm(TfmEleMedicosCabecera, fmEleMedicosCabecera);
  if not configform.Setear(fmEstadisticas) then Begin
    Height := 355; Width := 421; Top := 25; Left := 178;
  end;
  periodo.Text  := utiles.setPeriodoActual;
  salida        := 'P';
  ActiveControl := periodo;
  if FileExists(dbs.DirSistema + '\modulo_estadistica.ini') then Begin
    AssignFile(archivo, dbs.DirSistema + '\modulo_estadistica.ini');
    Reset(archivo);
    ReadLn(archivo, m);
    ReadLn(archivo, e);
    ReadLn(archivo, s);
    if m = 'S' then impresiontxt.Checked := True;
    lineas.Text := e;
    sep.Text    := s;
    closeFile(archivo);
  end;
  if FileExists(dbs.DirSistema + '\est_entidad.ini') then Begin
    AssignFile(archivo, dbs.DirSistema + '\est_entidad.ini');
    Reset(archivo);
    ReadLn(archivo, e);
    ReadLn(archivo, m);
    closeFile(archivo);
    Entidad.Text := e;
    if m = '1' then separarCodigos.Checked := True else separarCodigos.Checked := False;
  end;
  lista := TStringList.Create;
  redim := False;
end;

procedure TfmEstadisticas.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  if redim then utiles.msgError('s');

  configform.Guardar(fmEstadisticas, redim);
  if Assigned(fmEleObraSociales) then Begin
    fmEleObraSociales.Release; fmEleObraSociales := Nil;
  end;
  if Assigned(fmEleMedicos) then Begin
    fmEleMedicos.Release; fmEleMedicos := Nil;
  end;
  if Assigned(fmEleMedicosCabecera) then Begin
    fmEleMedicosCabecera.Release; fmEleMedicosCabecera := Nil;
  end;

  AssignFile(archivo, dbs.DirSistema + '\modulo_estadistica.ini');
  Rewrite(archivo);
  if impresiontxt.Checked then WriteLn(archivo, 'S') else WriteLn(archivo, 'N');
  WriteLn(archivo, lineas.Text);
  WriteLn(archivo, sep.Text);
  closeFile(archivo);
  Release; fmEstadisticas := nil;
end;

procedure TfmEstadisticas.emitirClick(Sender: TObject);
var
  archivo, p: String;
  l: Boolean;
begin
  if impresiontxt.Checked then Begin
    estadisticaCCB.LineasPag     := StrToInt(lineas.Text);
    estadisticaCCB.lineas_blanco := StrToInt(sep.Text);
  end;

  estadisticaCCB.Entidad := Entidad.Text;
  l := False;
  p := periodo.Text;
  if emitir.Caption = '&Exportar Datos' then Begin
    salida := 'T'; archivo := '';
    SaveDialog.Execute;
    if SaveDialog.FilterIndex = 1 then archivo := SaveDialog.FileName + '.txt' else archivo := SaveDialog.FileName;
    estadisticaCCB.ExportarDatos(archivo);
    Refresh;
  end;

  if (RadioButton1.Checked) or (RadioButton2.Checked) or (RadioButton3.Checked) or (RadioButton4.Checked) or
     (RadioButton5.Checked) or (RadioButton6.Checked) or (RadioButton7.Checked) or (practicasFact.Checked) or
     (EstadisticasProf.Checked) or (RadioButton8.Checked) then Begin
    if not perunificados.Checked then facturacion.ProcesarDatosCentrales(periodo.Text) else Begin
      facturacion.ProcesarDatosCentrales(periodo.Text);
      periodo.Text := facturacion.setPeriodoUnificacion;
      facturacion.ProcesarUnificados;
    end;
  end;

  if RadioButton1.Checked then Begin
    StatusBar1.Panels[0].Text := RadioButton1.Caption; StatusBar1.Refresh;
    estadisticaCCB.InicidenciaDeCadaObraSocial_Global(periodo.Text, salida);
  end;
  if RadioButton2.Checked then Begin
    StatusBar1.Panels[0].Text := RadioButton2.Caption; StatusBar1.Refresh;
    estadisticaCCB.InicidenciaPorDeterminacion_Global(periodo.Text, '', salida);
  end;
  if RadioButton3.Checked then Begin
    StatusBar1.Panels[0].Text := RadioButton3.Caption; StatusBar1.Refresh;
    estadisticaCCB.InicidenciaDeCadaProfesional_Global(periodo.Text, id.Caption, salida);
  end;

  if RadioButton4.Checked then
    if Length(Trim(id.Caption)) > 0 then Begin
      StatusBar1.Panels[0].Text := RadioButton4.Caption; StatusBar1.Refresh;
      estadisticaCCB.InicidenciaCodigosFactPesos(periodo.Text, id.Caption, salida);
    end;

  if RadioButton5.Checked then
    if Length(Trim(id.Caption)) > 0 then Begin
      StatusBar1.Panels[0].Text := RadioButton5.Caption; StatusBar1.Refresh;
      estadisticaCCB.InicidenciaPorDeterminacion_Global(periodo.Text, id.Caption, salida);
    end;

  if RadioButton6.Checked then
    if Length(Trim(id.Caption)) > 0 then Begin
      StatusBar1.Panels[0].Text := RadioButton6.Caption; StatusBar1.Refresh;
      estadisticaCCB.InicidenciaCodigosFacturadosPorProfesional(periodo.Text, id.Caption, salida);
    end;

  if RadioButton7.Checked then
    if Length(Trim(id.Caption)) = 0 then Begin
      utiles.msgError('No hay Obra Social Seleccionada ...!');
      l := True;
    end else Begin
      StatusBar1.Panels[0].Text := RadioButton7.Caption; StatusBar1.Refresh;
      estadisticaCCB.InicidenciaPorDeterminacion_Detallada(periodo.Text, id.Caption, '', salida, infobrasocial.Checked, separarCodigos.Checked, false, CheckBox2.Checked);
    end;

  if RadioButton8.Checked then
    if Length(Trim(id.Caption)) = 0 then Begin
      utiles.msgError('No hay Obra Social Seleccionada ...!');
      l := True;
    end else Begin
      StatusBar1.Panels[0].Text := RadioButton8.Caption; StatusBar1.Refresh;
      estadisticaCCB.InicidenciaPorDeterminacion_Detallada(periodo.Text, id.Caption, facturacion.setPeriodoUnificacion, salida, infobrasocial.Checked, separarCodigos.Checked, true, CheckBox2.Checked);
      //estadisticaCCB.InfRecuentoPorPractica(periodo.Text, Nil, salida);
    end;

  if practicasFact.Checked then
    if  fmEleObraSociales.cantidadSel > 0 then Begin
      StatusBar1.Panels[0].Text := practicasFact.Caption; StatusBar1.Refresh;
      estadisticaCCB.PracticasFacturadas_Global(periodo.Text, fmEleObraSociales.lista, salida);
    end else Begin
      utiles.msgError('No ha Seleccionado Obra(s) Social(es) ...!');
      l := True;
    end;

  if (RadioButton4.Checked) or (RadioButton5.Checked) or (RadioButton6.Checked) then Begin
    if Length(Trim(id.Caption)) = 0 then Begin
      utiles.msgError('No ha Seleccionado Obra(s) Social(es) ...!');
      l := True;
    end;
  end;

  if not l then Begin
    if (RadioButton1.Checked) or (RadioButton2.Checked) or (RadioButton3.Checked) or (RadioButton7.Checked) or (RadioButton8.Checked) then estadisticaCCB.Listar(salida);
    if (RadioButton4.Checked) or (RadioButton5.Checked) or (RadioButton6.Checked) then
      if Length(Trim(id.Caption)) > 0 then estadisticaCCB.Listar(salida);

    if emitir.Caption <> '&Exportar Datos' then
      if (practicasFact.Checked) and not (l) then estadisticaCCB.Listar(salida);
    if emitir.Caption = '&Exportar Datos' then estadisticaCCB.FinalizarExportacion;
  end;

  if EstadisticasProf.Checked then Begin
     StatusBar1.Panels[0].Text := EstadisticasProf.Caption; StatusBar1.Refresh;
     estadisticaCCB.InicidenciaDeCadaProfesionalDet_Global(periodo.Text, lista, listaos, salida);
  end;

  emitir.Caption := '&Generar Informe';
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  periodo.Text := p;
  ActiveControl := salir;
end;

