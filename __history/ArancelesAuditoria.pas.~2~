    if obsocial.factnbu <> 'S' then Begin
      if not nomeclatura.Buscar(codanalisis.Text) then BuscarProfClick(Sender) else Begin
        CargarDatosAnalisis;
        ActiveControl := periodoaf;
      end;
    end;
