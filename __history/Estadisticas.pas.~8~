procedure TfmEstadisticas.GenerarIPClick(Sender: TObject);
begin
  if infip1.Checked then Begin
    if utiles.PeriodoIntervaloMeses(perdesde.Text, perhasta.Text) > '12' then utiles.msgError('El Intérvalo No puede superar los 12 meses ...!') else Begin
      if salida <> 'X' then Begin
        salida := 'P';
        if Dispositivo.Impresor.Checked then salida := 'I';
      end;
      StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
      estadisticaCCB.Entidad := Entidad.Text;
      estadisticaCCB.InfComparacinProfesionales(codosip.Caption, perdesde.Text, perhasta.Text, salida);
      StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    end;
  end;
  if infip2.Checked then Begin
    if lista.Count = 0 then utiles.msgError('No hay Determinaciones Seleccionadas ...!') else Begin
      StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
      estadisticaCCB.Entidad := Entidad.Text;
      estadisticaCCB.InfRecuentoPorPractica(perdesde.Text, lista, salida);
      StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    end;
  end;
  SalirIP.SetFocus;
end;

