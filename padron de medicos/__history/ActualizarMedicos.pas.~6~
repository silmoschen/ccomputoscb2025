unit ActualizarMedicos;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls;

type
  TForm3 = class(TForm)
    Button1: TButton;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form3: TForm3;

implementation

{$R *.dfm}

procedure TForm3.Button1Click(Sender: TObject);
var
  archivo, salida: TextFile;
  linea, libro, folio, matricula, nombre: string;
  p, j: integer;
begin
  j := 0;
  AssignFile(archivo, 'listadogeneral.csv');
  AssignFile(salida, 'sal_med.txt');
  reset(archivo);
  rewrite(salida);
  while not eof(archivo) do begin
    inc(j);
    readln(archivo, linea);
    libro := copy(linea, 1, 2);
    folio := copy(linea, 4, 3);
    matricula := copy(linea, 8, 5);
    nombre := copy(linea, 15, 50);
    p := pos('|', nombre);
    nombre := copy(nombre, 1, p-1);
    if (j > 1) then
      writeln(salida, libro + ' ' + folio + ' ' + matricula + ' ' + nombre);
  end;
  closeFile(salida);
  closeFile(archivo);
  Close;
end;

end.
