  StatusBar1.Panels[0].Text := 'Gen. Inf. Retenciones I.V.A. ...!'; StatusBar1.Refresh;
  {
  list := TStringList.Create;
  r := obsocial.getReglas;
  r.Open;
  while not r.Eof do begin
    list.Add(r.FieldByName('codos').AsString);
    r.next;
  end;
  r.Close; r.free;
  }

  listprof := TStringList.Create;
  //r := profesional.setProfesionalesAlfRetIVA;
  r := profesional.setProfesionalesAlf;
  r.Open;
  while not r.eof do begin
    profesional.SincronizarListaRetIVA(per.Text, r.FieldByName('idprof').AsString);
    if (profesional.Retieneiva = 'S') then listprof.Add(r.FieldByName('idprof').AsString);
    r.next;
  end;
  r.close; r.free;

  facturacion.exporta_web := true;
  facturacion.IniciarFacturacionWeb(per.Text);
  //facturacion.ListarResumenRetencionesIVA(periodo.Text, titulo.Text, listprof, list, 'N', informeDet.Checked);
  //facturacion.ListarResumenRetencionesIVA(periodo.Text, titulo.Text, nil, list, 'P', informeDet.Checked);

  StatusBar1.Panels[0].Text := 'Exportando Totales I.V.A. ...!'; StatusBar1.Refresh;

  //a := altopag.Text;
  //altopag.Text := '100';
  facturacion.exporta_web := true;
  facturacion.ListarResumenAProfesionalesRI(per.Text, titulo.Text, '5', ruptura.Checked, listprof, list, 'T');
  facturacion.exporta_web := false;
  //altopag.Text := a;

  facturacion.exportarTotalesRI(per.Text);

  Application.CreateForm(TfmFTP, fmFTP);
  fmFTP.modulo.Caption := 'Totales Profesionales R.I.';
  fmFTP.ShowModal;

  per.SetFocus;
  //fmFTP.Release; fmFTP := nil;

  informeDet.Checked := false;
  CheckBox2.Checked := true;
  informeDet.Enabled := true;
  CheckBox2.Enabled := true;

  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;

  //utiles.msgError('Trabajo Terminado. Es Necesario Reiniciar Módulo.');
  //Close;
