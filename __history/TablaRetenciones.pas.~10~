  if Key = VK_UP then items.setFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if utiles.Sionoct(ret.Text, 'SN', 'Las Opciones son S ó N ...!') then retiva.setFocus;
end;

