procedure TfmLiquidacionOS.btnAplicarClick(Sender: TObject);
begin
  AssignFile(archivo, dbs.DirSistema + '\iniliq.dat');
  Rewrite(archivo);
  if impresiontxt.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 2);
  WriteLn(archivo, StrToInt(altopag.Text));
  if Length(Trim(anchocol.Text)) > 0 then WriteLn(archivo, StrToInt(anchocol.Text)) else WriteLn(archivo, 50);
  WriteLn(archivo, StrToInt(lineassep.Text));
  CloseFile(archivo);

  AssignFile(archivo, dbs.DirSistema + '\retdist.dat');
  Rewrite(archivo);
  if dist1.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  if dist2.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  CloseFile(archivo);
  CargarListaDist;

  AssignFile(archivo, dbs.DirSistema + '\saldarliq.ini');
  Rewrite(archivo);
  if CheckBox3.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  WriteLn(archivo, concepto.Text);
  if liq1.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  if liq2.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  if verFormula.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);

  closeFile(archivo);

  AssignFile(archivo, dbs.DirSistema + '\distgan.dat');
  Rewrite(archivo);
  if ga1.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  if ga2.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  if osiva.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  if liqIndi.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  CloseFile(archivo);

  AssignFile(archivo, dbs.DirSistema + '\becasgan.dat');
  Rewrite(archivo);
  if becasgan.Checked then WriteLn(archivo, 1) else WriteLn(archivo, 0);
  CloseFile(archivo);

  AssignFile(archivo, dbs.DirSistema + '\unifganancias.ini');
  Rewrite(archivo);
  if unifGanancias.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  closeFile(archivo);

  PageControl1.ActivePage := TabSheet1;
end;

