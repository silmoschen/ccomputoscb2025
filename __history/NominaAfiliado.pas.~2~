unit NominaAfiliado;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  Db, Grids, DBGrids, Buttons, DBCtrls, ExtCtrls, ComCtrls, StdCtrls, Mask;

type
  TfmListAfiliados = class(TForm)
    StatusBar1: TStatusBar;
    Panel1: TPanel;
    Panel2: TPanel;
    DBNavigator: TDBNavigator;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    SpeedButton3: TSpeedButton;
    DBGrid: TDBGrid;
    DTS: TDataSource;
    criterio: TComboBox;
    Label1: TLabel;
    expresion: TMaskEdit;
    Label2: TLabel;
    Splitter1: TSplitter;
    Panel3: TPanel;
    Label3: TLabel;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    desde: TMaskEdit;
    hasta: TMaskEdit;
    dispositivo: TComboBox;
    Panel4: TPanel;
    emitir: TBitBtn;
    cerrar: TBitBtn;
    Panel5: TPanel;
    codigo: TRadioButton;
    alfabetico: TRadioButton;
    Panel6: TPanel;
    entorno: TRadioButton;
    exclusion: TRadioButton;
    SpeedButton4: TSpeedButton;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure expresionChange(Sender: TObject);
    procedure criterioClick(Sender: TObject);
    procedure expresionKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure SpeedButton1Click(Sender: TObject);
    procedure SpeedButton2Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure DBGridKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure criterioChange(Sender: TObject);
    procedure SpeedButton4Click(Sender: TObject);
    procedure codigoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure codigoClick(Sender: TObject);
    procedure alfabeticoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure alfabeticoClick(Sender: TObject);
    procedure desdeKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure hastaKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure dispositivoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure emitirClick(Sender: TObject);
    procedure cerrarClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure desdeClick(Sender: TObject);
    procedure hastaClick(Sender: TObject);
    procedure SpeedButton3Click(Sender: TObject);
    procedure Panel2Resize(Sender: TObject);
  private
    { Private declarations }
    ordenact: string; control: byte;
    redim: Boolean;
    procedure ContarAfiliados;
  public
    { Public declarations }
    codos, os: String;
    introSalir, seleccionOK: boolean;
  end;

var
  fmListAfiliados: TfmListAfiliados;

implementation

uses CPadronOSCCB, CUtiles, Afiliados, CConfigForms;

{$R *.DFM}

procedure TfmListAfiliados.ContarAfiliados;
// Objetivo...: Contar registros
Begin
  StatusBar1.Panels[1].Text := 'Cant. Afil.: ' + IntToStr(padron.setCantidad);
end;

procedure TfmListAfiliados.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  StatusBar1.Panels[0].Text := 'Desconectando ...!'; StatusBar1.Refresh;
  configform.Guardar(fmListAfiliados, redim);
  if not introSalir then Begin
    padron.desconectar;
    Release; fmListAfiliados := nil;
  end;
end;

procedure TfmListAfiliados.expresionChange(Sender: TObject);
begin
  if criterio.Text = 'Nombre'    then padron.BuscarPorNombre(expresion.Text);
  if criterio.Text = 'Nro. Doc.' then padron.BuscarPorNrodoc(codos, expresion.Text);
end;

procedure TfmListAfiliados.criterioClick(Sender: TObject);
begin
  ActiveControl := expresion;
end;

procedure TfmListAfiliados.expresionKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_ESCAPE then Close;
  if Key = VK_INSERT then SpeedButton1Click(Sender);
  if (Key = VK_RETURN) or (Key = VK_DOWN) then ActiveControl := DBGrid;
end;

procedure TfmListAfiliados.SpeedButton1Click(Sender: TObject);
begin
  Application.CreateForm(TfmAfiliados, fmAfiliados);
  fmAfiliados.codos.Caption := codos;
  fmAfiliados.os.Caption    := os;
  if criterio.Text = 'Nro. Doc.' then
    fmAfiliados.nrodoc.Text := expresion.Text;
  if criterio.Text = 'Nombre' then
    fmAfiliados.nombre.Text := expresion.Text;
  fmAfiliados.ActiveControl := fmAfiliados.nombre;
  fmAfiliados.ShowModal;
  ContarAfiliados;
end;

procedure TfmListAfiliados.SpeedButton2Click(Sender: TObject);
begin
  DBGrid.Enabled := False;
  StatusBar1.Panels[0].Text := 'Iniciando Padrón ...!'; StatusBar1.Refresh;
  Application.CreateForm(TfmAfiliados, fmAfiliados);
  fmAfiliados.codos.Caption := codos;
  fmAfiliados.os.Caption    := os;
  if padron.Interbase <> 'S' then fmAfiliados.nrodoc.Text := padron.tabla.FieldByName('nrodoc').AsString;
  if padron.Interbase = 'S' then fmAfiliados.nrodoc.Text := padron.tablaIB.FieldByName('NRODOC').AsString;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  fmAfiliados.ShowModal;
  DBGrid.Enabled := True;
  ContarAfiliados;
end;

procedure TfmListAfiliados.FormCreate(Sender: TObject);
begin
  Left:=(Screen.Width - Width) div 2; Top:=(Screen.Height - Height) div 2;
end;

procedure TfmListAfiliados.DBGridKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_ESCAPE then Close;
  if Key = VK_INSERT then SpeedButton1Click(Sender);
  if Key = VK_DELETE then SpeedButton3Click(Sender);
  if Key = VK_RETURN then Begin
   if introSalir then Begin
     seleccionOk := True;
     Close;
   end else
     if Not Panel3.Visible then SpeedButton2Click(Sender) else Begin
        if control = 0 then Begin    // El control es del id
          if padron.Interbase <> 'S' then Begin
            if codigo.Checked then desde.Text := padron.tabla.FieldByName('nrodoc').AsString else desde.Text := padron.tabla.FieldByName('nombre').AsString;
          end;
          if padron.Interbase = 'S' then Begin
            if codigo.Checked then desde.Text := padron.tablaIB.FieldByName('NRODOC').AsString else desde.Text := padron.tablaIB.FieldByName('NOMBRE').AsString;
          end;
          ActiveControl := hasta;
        end;
        if control = 1 then Begin    // El control es de la descripción
          if padron.Interbase <> 'S' then Begin
            if codigo.Checked then hasta.Text := padron.tabla.FieldByName('nrodoc').AsString else hasta.Text := padron.tabla.FieldByName('nombre').AsString;
          end;
          if padron.Interbase = 'S' then Begin
            if codigo.Checked then hasta.Text := padron.tablaIB.FieldByName('NRODOC').AsString else hasta.Text := padron.tablaIB.FieldByName('NOMBRE').AsString;
          end;
          ActiveControl := dispositivo;
        end;
     end;
   end;
  if Key = VK_ESCAPE then Close;
end;

procedure TfmListAfiliados.criterioChange(Sender: TObject);
begin
  expresion.Text := '';
  expresionChange(Sender);
end;

procedure TfmListAfiliados.SpeedButton4Click(Sender: TObject);
begin
  ordenact := criterio.Text;
  if Not Panel3.Visible then Begin
    Panel3.Visible  := True;
    codigo.Checked  := True; entorno.Checked := True;
    desde.Text := ''; hasta.Text := ''; expresion.Text := '';
    criterio.Text   := 'Nro. Doc.';
    expresionChange(Sender);
    ActiveControl   := desde;
  end;
end;

procedure TfmListAfiliados.codigoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then ActiveControl := desde;
end;

procedure TfmListAfiliados.codigoClick(Sender: TObject);
begin
  criterio.Text := 'Nro. Doc.';
  expresionChange(Sender);
  desde.Text := ''; hasta.Text := ''; dispositivo.Text := 'Presentación Preliminar';
end;

procedure TfmListAfiliados.alfabeticoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then ActiveControl := desde;
end;

procedure TfmListAfiliados.alfabeticoClick(Sender: TObject);
begin
  Criterio.Text := 'Nombre';
  expresionChange(Sender);
  desde.Text := ''; hasta.Text := ''; dispositivo.Text := 'Presentación Preliminar';
end;

procedure TfmListAfiliados.desdeKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_UP then
    if codigo.Checked then ActiveControl := codigo else ActiveControl := alfabetico;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then Begin
    if Length(Trim(expresion.Text)) = 0 then ActiveControl := expresion else ActiveControl := hasta;
    control := 0;
  end;
end;

procedure TfmListAfiliados.hastaKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_UP then ActiveControl := desde;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then Begin
    if Length(Trim(expresion.Text)) = 0 then ActiveControl := expresion else ActiveControl := dispositivo;
    control := 1;
  end;
end;

procedure TfmListAfiliados.dispositivoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then ActiveControl := emitir;
end;

procedure TfmListAfiliados.emitirClick(Sender: TObject);
var
  salida, ordensalida, entornosal: char;
begin
  if (Length(Trim(desde.Text)) = 0) or (Length(Trim(hasta.Text)) = 0) then utiles.msgError('No se han definido suficientes parámetros ...!') else Begin
    StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
    DTS.DataSet := nil;
    salida := 'P'; ordensalida := 'C'; entornosal := 'E';
    if dispositivo.Text = 'Impresora' then salida := 'I';
    if alfabetico.Checked then ordensalida := 'A';
    if exclusion.Checked then entornosal := 'X';
    padron.Listar(codos, os, ordensalida, desde.Text, hasta.Text, entornosal, salida);
    if padron.Interbase <> 'S' then DTS.DataSet := padron.tabla;
    if padron.Interbase = 'S' then DTS.DataSet := padron.tablaIB;
    StatusBar1.Panels[0].Text := '';
  end;
  ActiveControl := cerrar;
end;

procedure TfmListAfiliados.cerrarClick(Sender: TObject);
begin
  Panel3.Visible := False;
  criterio.Text  := ordenact;
  expresionChange(Sender);
  ActiveControl  := expresion;
end;

procedure TfmListAfiliados.FormShow(Sender: TObject);
begin
  if not configform.Setear(fmListAfiliados) then Begin
    if FormStyle = fsMDIChild then Begin
      Height := 380; Width := 571; Top := 25; Left:=(Screen.Width - Width) div 2;
    end;
  end;
  if padron.Interbase <> 'S' then DTS.DataSet := padron.tabla;
  if padron.Interbase = 'S' then DTS.DataSet := padron.tablaIB;
  redim := False;
  ContarAfiliados;
  expresionChange(Sender);
end;

procedure TfmListAfiliados.desdeClick(Sender: TObject);
begin
  control := 0;
end;

procedure TfmListAfiliados.hastaClick(Sender: TObject);
begin
  control := 1;
end;

procedure TfmListAfiliados.SpeedButton3Click(Sender: TObject);
begin
  if not (introsalir) then begin
    Application.CreateForm(TfmAfiliados, fmAfiliados);
    fmAfiliados.codos.Caption := codos;
    fmAfiliados.os.Caption    := os;
    if padron.Interbase <> 'S' then Begin
      fmAfiliados.nrodoc.Text   := padron.tabla.FieldByName('nrodoc').AsString;
      fmAfiliados.nombre.Text   := padron.tabla.FieldByName('nombre').AsString;
    end;
    if padron.Interbase = 'S' then Begin
      fmAfiliados.nrodoc.Text   := padron.tablaIB.FieldByName('NRODOC').AsString;
      fmAfiliados.nombre.Text   := padron.tablaIB.FieldByName('NOMBRE').AsString;
    end;
    fmAfiliados.BajaClick(Sender);
    ActiveControl := DBGrid;
    ContarAfiliados;
    fmAfiliados.Release; fmAfiliados := Nil;
  end else
    utiles.msgError('La Opción Eliminar No esta Disponible durante la Selección ...!');
end;

procedure TfmListAfiliados.Panel2Resize(Sender: TObject);
begin
  redim := True;
end;

end.
