function TfmFactManual.RegistrarOrdenesAuditoria: Boolean;
// Objetivo...: Registrar Ordenes de Auditoría
var
  i: Integer;
Begin
  if verificarDatosAuditoria then Begin
    facturacion.PrepararDirectorio_OrdenesAuditadas(periodoaudit.Text, idprofaudit.Text);
    for i := 1 to FAudit.RowCount do begin // Recalculamos los items
      if Length(Trim(FAudit.Cells[0, i])) = 0 then Break;
      itemsaudit := i;
    end;
    for i := 1 to itemsaudit do Begin
      if Length(Trim(FAudit.Cells[0, i])) = 0 then Break;
      facturacion.RegistrarOrdenes(periodoaudit.Text, FAudit.Cells[0, i], FAudit.Cells[1, i], FAudit.Cells[3, i], FAudit.Cells[4, i], itemsaudit);
      if FAudit.Cells[4, i] = 'X' then Begin
        facturacion.MarcarOrdenAuditoria(periodoaudit.Text, FAudit.Cells[0, i], FAudit.Cells[1, i], FAudit.Cells[4, i]);
        act_ordenes.Checked := False;
      end;
    end;
    Result := True;
  end else
    Result := False;
end;

