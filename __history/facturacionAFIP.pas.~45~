procedure TfmFacturacionAfip.loaditems;
var
  r: TQuery;
  i: integer;
begin
  grid.IniciarGrilla(D);
  r := facturacion.getFacturas(periodo.Text);
  r.Open; i := 0;
  while not r.eof do begin
     inc(i);
     D.Cells[0, i] := r.FieldByName('periodo').AsString;
     D.Cells[1, i] := r.FieldByName('fecha').AsString;
     D.Cells[2, i] := r.FieldByName('codos').AsString;
     D.Cells[3, i] := r.FieldByName('obrasocial').AsString;
     D.Cells[4, i] := r.FieldByName('cuit').AsString;
     D.Cells[5, i] := utiles.FormatearNumero(r.FieldByName('monto').AsString);
     D.Cells[6, i] := r.FieldByName('cae').AsString;
     D.Cells[7, i] := r.FieldByName('vtocae').AsString;
     r.next;
  end;
  r.Close; r.free;
end;

