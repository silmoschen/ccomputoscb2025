begin
  StatusBar1.Panels[0].Text := 'Obteniendo Determinaciones ...!'; StatusBar1.Refresh;
  IniciarGrilla;

  if PageControl1.ActivePage = TabSheet1 then
    if periodo.Enabled then ActiveControl := periodo else ActiveControl := codos;

  if (facturacion.interbase = 'N') then begin
    if facturacion.Buscar(periodo.Text, idprof.Text, codos.Text) then datosok := true else
      datosok := facturacion.verificarMovimientosObraSocial(periodo.Text, idprof.Text, codos.Text);
  end else
    datosok := true;
    
  if (datosok) then begin
    if (facturacion.interbase = 'N') then begin
      r := facturacion.setItems;
      r.Open; r.First; i := 0;
      while not r.EOF do Begin
        Inc(i);
        if Length(Trim(r.FieldByName('codanalisis').AsString)) = 4 then nomeclatura.getDatos(r.FieldByName('codanalisis').AsString);
        if Length(Trim(r.FieldByName('codanalisis').AsString)) = 6 then nbu.getDatos(r.FieldByName('codanalisis').AsString);
        paciente.getDatos(r.FieldByName('idprof').AsString, r.FieldByName('codpac').AsString);
        A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
        A.cells[1, i] := r.FieldByName('codanalisis').AsString;
        if Length(Trim(r.FieldByName('codanalisis').AsString)) = 4 then A.cells[2, i] := nomeclatura.descrip;
        if Length(Trim(r.FieldByName('codanalisis').AsString)) = 6 then A.cells[2, i] := nbu.descrip;
        A.cells[3, i] := r.FieldByName('orden').AsString;
        if Length(Trim(r.FieldByName('nombre').AsString)) = 0 then A.cells[4, i] := paciente.nombre else A.cells[4, i] := r.FieldByName('nombre').AsString;
        A.cells[5, i] := r.FieldByName('codpac').AsString;
        A.cells[6, i] := codos.Text;
        A.cells[7, i] := os.Caption;
        A.cells[9, i] := r.FieldByName('retiva').AsString;
        if (length(trim(r.FieldByName('ref1').AsString)) = 7) then
          A.cells[8, i] := r.FieldByName('ref1').AsString
        else
          A.cells[8, i] := r.FieldByName('periodo').AsString;
        C.cells[0, i] := r.FieldByName('codpac').AsString;
        C.cells[1, i] := r.FieldByName('nombre').AsString;
        C.cells[2, i] := r.FieldByName('retiva').AsString;
        r.Next;
      end;
      r.Close; r.Free;
    end;

    if (facturacion.interbase = 'S') then begin
      s := facturacion.setItemsIB;
      s.Open; s.First; i := 0;
      while not s.EOF do Begin
        Inc(i);
        if Length(Trim(s.FieldByName('codanalisis').AsString)) = 4 then nomeclatura.getDatos(s.FieldByName('codanalisis').AsString);
        if Length(Trim(s.FieldByName('codanalisis').AsString)) = 6 then nbu.getDatos(s.FieldByName('codanalisis').AsString);
        paciente.getDatos(s.FieldByName('idprof').AsString, s.FieldByName('codpac').AsString);
        A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
        A.cells[1, i] := s.FieldByName('codanalisis').AsString;
        if Length(Trim(s.FieldByName('codanalisis').AsString)) = 4 then A.cells[2, i] := nomeclatura.descrip;
        if Length(Trim(s.FieldByName('codanalisis').AsString)) = 6 then A.cells[2, i] := nbu.descrip;
        A.cells[3, i] := s.FieldByName('orden').AsString;
        if Length(Trim(s.FieldByName('nombre').AsString)) = 0 then A.cells[4, i] := paciente.nombre else A.cells[4, i] := s.FieldByName('nombre').AsString;
        A.cells[5, i] := s.FieldByName('codpac').AsString;
        A.cells[6, i] := codos.Text;
        A.cells[7, i] := os.Caption;
        A.cells[9, i] := s.FieldByName('retiva').AsString;
        if (length(trim(s.FieldByName('ref1').AsString)) = 7) then
          A.cells[8, i] := s.FieldByName('ref1').AsString
        else
          A.cells[8, i] := s.FieldByName('periodo').AsString;
        C.cells[0, i] := s.FieldByName('codpac').AsString;
        C.cells[1, i] := s.FieldByName('nombre').AsString;
        C.cells[2, i] := s.FieldByName('retiva').AsString;
        s.Next;
      end;
      s.Close; s.Free;
    end;

    if i > 0 then Begin
      Items := i;
      cancelar.Enabled  := True;
      PopupMenuMod.Items[0].Enabled := True;
    end else items := 0;


    if i > 0 then A.row := i else A.row := 1;

    if CheckBox1.Checked then Begin
      id.Text        := A.cells[3, 1];
      A.Enabled      := True;
      if PageControl1.ActivePage = TabSheet1 then ActiveControl  := A;
    end;

    verificarIntegridadItems;

  end else
    utiles.msgError('El Profesional No tiene Items Facturados en esta Obra Social ...!');

  A.Refresh;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
