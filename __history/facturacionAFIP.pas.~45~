  redim := true;
end;

procedure TfmFacturacionAfip.btnFacturarClick(Sender: TObject);
//VARIABLES DE RETORNO (ARRAYS DE VARIANTS)
var tokens: anyTypeArray;
var resultado: anyTypeArray;
//CREAMOS LOS ARRAYS NECESARIOS
var alicuotas : alicIvaArray;
var tributos : tributoArray;
var asociados: cbteAsocArray;
//VARIABLES QUE ALMACENAN LAS CREDENCIALES
var token:WideString;
var sign:WideString;

var _cuit, _fecha, s, t: string;
var numero, fila: Integer;
var monto: double;
begin
     if (length(trim(D.Cells[6, D.Row])) > 0) then begin
       utiles.msgError('La Obra Social ya está Facturada ...!');
       exit;
     end;

     if (utiles.msgSiNo('Seguro para Facturar ?') = false) then exit;

     _cuit := D.Cells[4, D.Row];
     if (length(trim(_cuit)) <> 13) then begin
       utiles.msgError('C.U.I.T. Obra Social Incorrecto ...!');
       exit;
     end;

     _cuit  := utiles.StringRemplazarCaracteres(D.Cells[4, D.Row], '-', '');
     cuitos := StrToInt64(_cuit);

     _fecha := utiles.sExprFecha2000(fecha.Text);
     s := copy(_fecha, 7, 2) + '/' + copy(_fecha, 5, 2) + '/' + copy(_fecha, 1, 4);

     numero:= servicio.obtUltNum(cuit, ptovta, tipo) + 1;  // Obtenemos el próximo número a facturar
     monto := StrToFloat(D.Cells[5, D.Row]);

    //servicio := HTTPRIO1 as FacturaService;
    tokens := servicio.login(); //GENERO LOS TOKENS


       //SET LOS ARRAYS VACIOS
       alicuotas := ((nil));
       tributos := ((nil));
       asociados := ((nil));

      resultado := servicio.facturar(
       cuit, //20260027655, //CUIT EMPRESA
       1,
       ptovta, // 4,
       tipo, //11,
       80, //96,   //DNI ES 96, CUIT ES 80
       cuitos, //27518700,
       numero, //47,
       numero, //47,
       _fecha, //'20181204',
       _fecha, //'20181204',
       _fecha, //'20181204',
       _fecha, //'20181204',
       monto,  //200.0,
       'PES',
       1,
       alicuotas,
       tributos,
       asociados);

    if (resultado <> nil) then
     begin
      if (Length(resultado) > 1) then begin
          D.Cells[6, D.Row] := resultado[2];  //MUESTRA  CAE
          t := copy(resultado[0], 7, 2) + '/' + copy(resultado[0], 5, 2) + '/' + copy(resultado[0], 1, 4);
          D.Cells[7, D.Row] := t;  // Vencimiento CAE
          facturacion.registrarCAE(D.Cells[0, D.Row], D.Cells[2, D.Row], D.Cells[6, D.Row], 'C',
            utiles.sLlenarIzquierda(Inttostr(ptovta), 4, '0'), utiles.sLlenarIzquierda(Inttostr(numero), 8, '0'),
            s, s, s, D.Cells[7, D.Row], IntToStr(tipo));
          fila := D.Row;
          loaditems;
          D.Row := fila;
      end else
          utiles.msgError(resultado[0]);   //MUESTRA  ERROR O MENSAJE
     end;

end;

