procedure TfmObsociales.RecuperarAranceles;
// Objetivo...: Obtener los ultimos aranceles para volcarlos a la Ficha
var
  l: TStringList;
  i: Integer;
  j: array[1..5] of byte;
begin
  grid.IniciarGrilla(AR);
  i := 0;
  if obsocial.Buscar(codos.Text) then Begin
    l := obsocial.setAranceles(codos.Text);
    For i := 1 to l.Count do Begin
      j[1] := Pos(';1', l.Strings[i-1]);
      j[2] := Pos(';2', l.Strings[i-1]);
      j[3] := Pos(';3', l.Strings[i-1]);
      j[4] := Pos(';4', l.Strings[i-1]);
      j[5] := Pos(';5', l.Strings[i-1]);
      AR.Cells[0, i] := Copy(l.Strings[i-1], 1, 7);
      AR.Cells[1, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[1]+2, (j[2]-j[1]) - 2));
      AR.Cells[2, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[2]+2, (j[3]-j[2]) - 2));
      AR.Cells[3, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[3]+2, (j[4]-j[3]) - 2));
      AR.Cells[4, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[4]+2, (j[5]-j[4]) - 2));
      AR.Cells[5, i] := Copy(l.Strings[i-1], j[5]+2, 1);
      AR.Row := i;
    end;
    if AR.Row > 0 then Begin
      // Transferimos los ultimos datos a la Ficha
      if AR.Cells[5, i] = 'S' then topes.Checked := True else topes.Checked := False;
      periodo.Text := AR.Cells[0, AR.Row];
      UB.Text      := AR.Cells[1, AR.Row];
      UG.Text      := AR.Cells[2, AR.Row];
      RIEUB.Text   := AR.Cells[3, AR.Row];
      RIEUG.Text   := AR.Cells[4, AR.Row];
    end;
  end else
    if i > 0 then  utiles.msgError('La Obra Social No es Válida ...!');
end;

