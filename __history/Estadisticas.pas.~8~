procedure TfmEstadisticas.btnEleccionObsocialClick(Sender: TObject);
begin
  if not (infEstMedicoCabecera.Checked) and not (infEstDiagnostico.Checked) and not (infEstMedicoDiagnostico.Checked) and not (infautrechpac.Checked) then Begin
    if not Assigned(fmEleObraSociales) then Application.CreateForm(TfmEleObraSociales, fmEleObraSociales);
    fmEleObraSociales.CargarDatos(2);
    fmEleObraSociales.ShowModal;
    fadesde.SetFocus;
  end;
  if (infEstMedicoCabecera.Checked) or (infEstDiagnostico.Checked) or (infEstMedicoDiagnostico.Checked) then Begin
