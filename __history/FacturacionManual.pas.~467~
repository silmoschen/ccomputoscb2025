procedure TfmFactManual.CargarDatosAuditoria;
// objetivo...: Cargar las ordenes auditadas
var
  r: TQuery; s: TIBQuery; i: Integer;
Begin
  grid.IniciarGrilla(FAudit);
  FAudit.Enabled       := False;
  btnFinalizar.Enabled := False;
  btnRegistrar.Enabled := False;
  btnFacturar.Enabled  := False;
  recordenes.Enabled   := False;
  verpac.Enabled := false;
  FAudit.Row     := 1;

  facturacion.PrepararDirectorio(periodoaudit.Text, idprofaudit.Text);

  if (facturacion.interbase = 'N') then begin
    r := facturacion.setOrdenesAuditoria(periodoaudit.Text, idprofaudit.Text);
    if r <> nil then Begin
      r.Open; i := 0;
      profesional.getDatos(r.FieldByName('idprof').AsString);
      while not r.Eof do Begin
        Inc(i);
        FAudit.Cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
        FAudit.Cells[1, i] := r.FieldByName('idprof').AsString;
        FAudit.Cells[2, i] := profesional.nombre;
        FAudit.Cells[3, i] := r.FieldByName('nroauditoria').AsString;
        FAudit.Cells[4, i] := r.FieldByName('facturada').AsString;
        r.Next;
      end;
      r.Close; r.Free;
    End;
  end;

  if (facturacion.interbase = 'S') then begin
    s := facturacion.setOrdenesAuditoriaIB(periodoaudit.Text, idprofaudit.Text);

    if s <> nil then Begin
      s.Open; i := 0;
      profesional.getDatos(s.FieldByName('idprof').AsString);
      while not s.Eof do Begin
        Inc(i);
        FAudit.Cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
        FAudit.Cells[1, i] := s.FieldByName('idprof').AsString;
        FAudit.Cells[2, i] := profesional.nombre;
        FAudit.Cells[3, i] := s.FieldByName('nroauditoria').AsString;
        FAudit.Cells[4, i] := s.FieldByName('facturada').AsString;
        if (verpac.Checked) then FAudit.Cells[5, i] := auditoriacb.getPaciente(s.FieldByName('nroauditoria').AsString);
        s.Next;
      end;
      s.Close; s.Free;
    End;
  end;

  if (length(trim(FAudit.Cells[0, 1])) > 0) then Begin
    itemsaudit := i;
    FAudit.Enabled := True;
    FAudit.Row := i;
    Baja.Enabled := True;
    BorrarOperacionesObraSocial.Enabled  := False;
    BorrarOperacionesLaboratorio.Enabled := False;
    PeriodoCompleto.Enabled              := False;
    BorrarOrdenesAuditadas1.Enabled      := True;
    btnFinalizar.Enabled                 := True;
    btnRegistrar.Enabled                 := True;
    btnFacturar.Enabled                  := True;
    recordenes.Enabled                   := True;
    verpac.Enabled := false;
  end else
    Baja.Enabled                         := False;

end;

function  TfmFactManual.verificarOrdenInterna(xnroauditoria: string): Boolean;
// Objetivo...: verificar entre las ordenes que la misma no haya sido cargada
var
  i, p: Integer; tt: Boolean;
Begin
  Result := False;
  p      := FAudit.Row;
  for i := 1 to FAudit.RowCount do Begin
    if Length(Trim(FAudit.Cells[0, i])) = 0 then Break;
    if modificaaudit then
      if (utiles.sLlenarIzquierda(xnroauditoria, 10, '0') = FAudit.Cells[3, i]) and (i <> p) then tt := True;
    if not modificaaudit then
      if (utiles.sLlenarIzquierda(xnroauditoria, 10, '0') = FAudit.Cells[3, i]) then tt := True;
    if tt then Begin
      Result := True;
      Break;
    end;
  end;
end;

