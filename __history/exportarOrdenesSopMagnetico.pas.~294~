procedure TfmExportarOrdenesSoporteMagnetico.FormShow(Sender: TObject);
var
  r: TQuery;
  i: integer;
begin
  auditoriacb.conectar;
  facturacion.conectar;
  exportObrasSociales.conectar;
  r := obsocial.getReglas;
  r.open; i := 0;
  while not r.eof do begin
    obsocial.getDatos(r.FieldByName('codos').asstring);


    listaos.Items.Add(obsocial.Nombre + ' (' + r.FieldByName('codos').asstring + ')');
    idregla.Items.Add(r.FieldByName('regla').asstring);
    idos.Items.Add(r.FieldByName('codos').asstring);
    if (i = 0) then begin
      listaos.Text := obsocial.Nombre + ' (' + r.FieldByName('codos').asstring + ')';
      idos.Text := r.FieldByName('codos').asstring;
      idregla.Text := r.FieldByName('regla').asstring;
    end;
    i := 1;
    r.next;
  end;
  r.close; r.free;

  configform.Setear(fmExportarOrdenesSoporteMagnetico);

  grid.RecuperarAnchoColumnas(fmExportarOrdenesSoporteMagnetico, A);

  A.Cells[0, 0] := 'Período';
  A.Cells[1, 0] := 'Código';
  A.Cells[2, 0] := 'Obra Social';
  A.Cells[3, 0] := 'Monto';
  A.Cells[4, 0] := 'Grabado';
  A.Cells[5, 0] := 'Exento';
  A.Cells[6, 0] := 'Total';
  A.Cells[7, 0] := 'R';
  A.Cells[8, 0] := 'Tipo';
  A.Cells[9, 0] := 'Sucursal';
  A.Cells[10,0] := 'Número';
  A.Cells[11,0] := 'Fecha';
  A.Cells[12,0] := 'I.V.A.';
  A.Cells[13,0] := 'Grabado';

  periodo.Text := utiles.setPeriodoActual;

  {
  periodo.Text := '02/2020';
  tipo.Text := 'C';
  sucursal.Text := '0001';
  numero.Text := '00000005';
  fecha.Text := '29/02/20';
  }

  montoexport.Caption := utiles.FormatearNumero('0');

  facturacion.DireccionarLaboratorio(periodo.Text, '000000');

  listaOSChange(Self);

  periodo.SetFocus;

end;

