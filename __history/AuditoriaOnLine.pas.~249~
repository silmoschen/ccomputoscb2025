end;

procedure TfmAuditoriaOnLine.TodosClick(Sender: TObject);
var
  i: integer;
begin
  For i := 1 to E.RowCount do begin
    if (length(trim(E.Cells[0, i])) = 0) then break;
    E.cells[9, i] := 'S';
    E.Refresh;
  end;
  if (length(trim(E.Cells[0, 1])) > 0) then btnSubir.Enabled := true;
end;

