unit configaccesoremoto;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, DBCtrls, Grids, DBGrids, DB, IBDatabase, IBCustomDataSet, IBTable,
  ExtCtrls;

type
  TfmConfigFirebird = class(TForm)
    Panel1: TPanel;
    IBDatabase1: TIBDatabase;
    IBTable1: TIBTable;
    IBTransaction1: TIBTransaction;
    DataSource1: TDataSource;
    Panel2: TPanel;
    DBNavigator1: TDBNavigator;
    Panel3: TPanel;
    DBGrid1: TDBGrid;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fmConfigFirebird: TfmConfigFirebird;

implementation

{$R *.dfm}

procedure TfmConfigFirebird.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  IBTable1.Close;
  IBDatabase1.Close;
  fmConfigFirebird.Release; fmConfigFirebird := nil;
end;

procedure TfmConfigFirebird.FormShow(Sender: TObject);
begin
  Left:=(Screen.Width - Width) div 2;
  IBDatabase1.Open; 
  IBTable1.Open;
  IBTransaction1.Active := true;
end;

end.
