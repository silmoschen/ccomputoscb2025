procedure TfmFactManual.emitirClick(Sender: TObject);
var
  salida: char; salto: ShortInt; inf: Boolean; archivo, nrocol, pp, p1: String;
begin
  if ArancelesDif.Checked then Begin   // Aranceles Diferenciales
    obsocial.ArancelesDiferenciales := True;
    obsocial.Codosdif := Copy(osdif.Caption, 2, 6);
  end;

  pp := periodo.Text;
  p1 := facturacion.setPeriodoUnificacion;

  if general.Checked then Begin   // Reactivamos el período si es general
    pertrab.Text := per.Text;
    ProcesarDatosCentrales;
  end;

  if unificado.Checked then Begin   // Reactivamos el período Unificado
    if Length(Trim(p1)) = 7 then per.Text := p1;
    pertrab.Text := per.Text;
    ProcesarDatosUnificados;
  end;

  if CheckBox2.Visible then Begin
    facturacion.SC         := True;
    facturacion.ExcluirLab := CheckBox2.Checked;
  end;

  facturacion.listtotalboleta := tot_boletas.Checked;  

  if RadioButton6.Checked then nrocol := inf6.Text else nrocol := columnas.Text;
  if Length(Trim(lineas_blanco.Text)) > 0 then facturacion.lineas_blanco := StrToInt(lineas_blanco.Text) else facturacion.lineas_blanco := 0;
  if Length(Trim(nrocol)) = 0 then nrocol := '5';
  if not Assigned(Dispositivo) then Application.CreateForm(TDispositivo, Dispositivo);
  if not Assigned(fmEleObraSociales) then Application.CreateForm(TfmEleObraSociales, fmEleObraSociales);
  salida := 'P'; inf := True;

  if (RadioButton9.Checked) then begin
    if Dispositivo.Impresor.Checked then salida := 'I';
    StatusBar1.Panels[0].Text := 'Gen. Inf. Coseguros Obras Sociales ...!'; StatusBar1.Refresh;
    facturacion.PrepararDirectorio(periodo.Text, '000000');
    facturacion.ListarCosegurosFacturados(per.Text, salida);
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    exit;
  end;

  facturacion.LineasPag := StrToInt(altopag.Text);
  facturacion.ruptura   := ruptura.Checked;
  if Length(Trim(nroOrdenes.Text)) > 0 then facturacion.lineas_audit := StrToInt(nroOrdenes.Text) else facturacion.lineas_audit := 5;
  if (individual.Checked) and not (facturacion.LaboratorioActivo) and (Length(Trim(idlab.Text)) > 0) then DatosProfesional;
  if not (facturacion.LaboratorioActivo) and not (RadioButton7.Checked) and (individual.Checked) then utiles.msgError('No hay Laboratorio Seleccionado o ' + CHR(13) + ' el mismo no tiene Operaciones Registradas  ...!') else
  if Length(Trim(per.Text)) < 7 then utiles.msgError('No ha expecificado el Período a Emitir ...!') else Begin
    if emitir.Caption = '&Generar Informe' then Begin
      if Dispositivo.Impresor.Checked then
        if not impresiontxt.Checked then salida := 'I' else salida := 'T';
      if ruptura.Checked then salto := 1 else salto := 0;
    end else Begin
      salida := 'T';
      SaveDialog.Execute;
      Refresh;
      if SaveDialog.FilterIndex = 1 then archivo := SaveDialog.FileName + '.txt';
      if Length(Trim(SaveDialog.FileName)) > 0 then facturacion.ExportarInforme(archivo) else inf := False;
    end;


  if individual.Checked then Begin
    if ((facturacion.verificicarSiExisteLaboratorio(per.Text, idlab.Text)) and (inf)) and not (facturacion.ProcesandoDatosCentrales) then inf := True else Begin
      utiles.msgError('El Laboratorio No Tiene Operaciones Registradas en este Período ...!');
      inf := False;
    end;
  end;

  if general.Checked then inf := True;

  if inf then Begin
    if RadioButton1.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Facturación a Obras Sociales ...!'; StatusBar1.Refresh;
      facturacion.ConfigurarInforme(RadioButton1.Caption, StrToInt(cantcopias.Text), salto);
      facturacion.ListarResumenPrestacionesPorObraSocial(periodo.Text, titulo.Text, nrocol, fmEleObraSociales.lista, salida);
    end;
    if RadioButton2.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Resumen Por Obra Social ...!'; StatusBar1.Refresh;
      facturacion.ConfigurarInforme(RadioButton2.Caption, StrToInt(cantcopias.Text), salto);
      facturacion.ListarResumenPorObraSocial(periodo.Text, titulo.Text, fmEleObraSociales.lista, salida, informeDet.Checked);
    end;
    if RadioButton3.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Listado de Totales Generales por Obra Social ...!'; StatusBar1.Refresh;
      facturacion.ConfigurarInforme(RadioButton3.Caption, StrToInt(cantcopias.Text), salto);
      facturacion.ListarTotGralesObrasSociales(periodo.Text, titulo.Text, fmEleObraSociales.lista, salida);
    end;
    if RadioButton4.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Resumen por Profesionales ...!'; StatusBar1.Refresh;
      facturacion.ConfigurarInforme(RadioButton4.Caption, StrToInt(cantcopias.Text), salto);
      facturacion.ListarResumenAProfesionales(periodo.Text, titulo.Text, nrocol, ruptura.Checked, fmEleProfesional.lista, fmEleObraSociales.lista, salida);
    end;
    if RadioButton5.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Facturación por Profesionales ...!'; StatusBar1.Refresh;
      facturacion.ConfigurarInforme(RadioButton5.Caption, StrToInt(cantcopias.Text), salto);
      facturacion.ListarResumenPorProfesional(periodo.Text, titulo.Text, fmEleProfesional.lista, fmEleObraSociales.lista, salida);
    end;
    if RadioButton8.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Retenciones I.V.A. ...!'; StatusBar1.Refresh;
      facturacion.ConfigurarInforme(RadioButton8.Caption, StrToInt(cantcopias.Text), salto);
      facturacion.ListarResumenRetencionesIVA(periodo.Text, titulo.Text, fmEleProfesional.lista, fmEleObraSociales.lista, salida, informeDet.Checked);
    end;

    if RadioButton6.Checked then Begin
      facturacion.ConfigurarInforme(RadioButton6.Caption, StrToInt(cantcopias.Text), salto);
      if general.Checked then utiles.msgError('Los Controles Finales solo se Emiten a Nivel Individual ...!');
      if individual.Checked then Begin
        if Length(Trim(idLab.Text)) > 0 then DatosProfesional;
        if (aud.Checked) and (fac.Checked) then Begin
          StatusBar1.Panels[0].Text := 'Gen. Inf. Controles Finales ...!'; StatusBar1.Refresh;
          facturacion.ListarControlesFinales(periodo.Text, titulo.Text, nrocol, fmEleProfesional.lista, fmEleObraSociales.lista, False, salida);
          facturacion.ListarOrdenesAuditadas(periodo.Text, fmEleProfesional.lista, True, salida);
        end else Begin
          if fac.Checked then facturacion.ListarControlesFinales(periodo.Text, titulo.Text, nrocol, fmEleProfesional.lista, fmEleObraSociales.lista, True, salida);
          if aud.Checked then facturacion.ListarOrdenesAuditadas(periodo.Text, fmEleProfesional.lista, True, salida);
        end;
      end;
    end;

    if RadioButton7.Checked then Begin
      StatusBar1.Panels[0].Text := 'Gen. Inf. Controles de Auditoría ...!'; StatusBar1.Refresh;
      facturacion.ListarContorlesAuditoria(periodo.Text, salida);
    end;

  end;
  end;

  per.Text     := pp;
  periodo.Text := pp;
  osel.Caption := ''; np.Caption := '';
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;

  ExportarInf.Checked := False;
  Refresh;

  obsocial.ArancelesDiferenciales := False;
  obsocial.Codosdif := '';

  ActiveControl := per;
end;

