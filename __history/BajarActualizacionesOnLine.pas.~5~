procedure TfmBajarActualizaciones.conectarFTP;
begin
  if IdFTP1.Connected then try
    if TransferrignData then IdFTP1.Abort;
    IdFTP1.Quit;
    finally
  end else with IdFTP1 do try
    {$IFDEF VER140}
    User := usuario.Text;
    {$ENDIF}
    {$IFDEF VER185}
    UserName := usuario.Text;
    {$ENDIF}
    Password := contrasenia.Text;
    Host     := ftphost.Text;
    Connect;
    Self.ChageDir(dirftp.Text);
  finally
  end;
end;

procedure TfmBajarActualizaciones.DesconectarFTP;
begin
  if IdFTP1.Connected then try
    IdFTP1.Disconnect;
    finally
  end
end;

procedure TfmBajarActualizaciones.ChageDir(DirName: String);
begin
  try
    IdFTP1.ChangeDir(DirName);
    {$IFDEF VER140}
    IdFTP1.TransferType := ftASCII;
    {$ENDIF}
    {$IFDEF VER185}
    IdFTP1.TransferType := ftASCII;
    {$ENDIF}

    estado.Lines.Add('');
    estado.Lines.Add('Cambiando a Directorio ' + DirName);
  finally
  end;
end;

procedure TfmBajarActualizaciones.conectarInternet;
Begin
  Application.CreateForm(TAutoForm, AutoForm);
  Application.CreateForm(TConfigureAutoForm, ConfigureAutoForm);
  Application.CreateForm(TAboutForm, AboutForm);
  Application.CreateForm(TRasDialerForm, RasDialerForm);
  Application.CreateForm(TTimeAutoForm, TimeAutoForm);
  datosok := False;
  if Length(Trim(RasDialerForm.setIPAdress)) = 0 then   // Si No esta conectado
    if utiles.msgSiNo('Los Información a Transferir se Generó Correctamente,', 'Desea Conectarse a Internet y Realizar la Transferencia ?') then Begin
      RasDialerForm.ShowModal;
      con := RasDialerForm.hRasConn;
      datosok := True;
    end;
end;

procedure TfmBajarActualizaciones.DesconectarInternet;
Begin
  if (datosok) and (Length(Trim(RasDialerForm.setIPAdress)) > 0) then   // Si solo nos conectamos a Internet para transferir
    if utiles.msgSiNo('Los Datos se Transfirieron Correctamente', 'Quiere Desconectarse de Internet Ahora ?') then Begin
      StatusBar1.Panels[0].Text := 'Desconectando ...!'; Refresh;
      Application.CreateForm(TRasDialerForm, RasDialerForm);
      RasDialerForm.hRasConn := con;
      RasDialerForm.CancelButtonClick(nil);
      StatusBar1.Panels[0].Text := ''; Refresh;
    end;

  if Assigned(RasDialerForm) then Begin
    RasDialerForm.Release; RasDialerForm := nil;
  end;
  if Assigned(ConfigureAutoForm) then Begin
    ConfigureAutoForm.Release; ConfigureAutoForm := nil;
  end;
  if Assigned(AboutForm) then Begin
    AboutForm.Release; AboutForm := nil;
  end;
  if Assigned(TimeAutoForm) then Begin
    TimeAutoForm.Release; TimeAutoForm := nil;
  end;
end;

procedure TfmBajarActualizaciones.Actualizar(xlista: TStringList);
// Objetivo...: Actualizar a Partir de los datos transferidos
begin
  StatusBar1.Panels[0].Text := 'Procesando Datos ...!'; StatusBar1.Refresh;
  estado.Lines.Clear;
  estado.Lines.Add('Procesando Actualizaciones'); estado.Lines.Add('');
  //obsocial.DescompactarArchivosActualizaciones;
  obsocial.conectar;
  if act1.Checked then Begin
    estado.Lines.Add('Actualizando Determinaciones con Monto Fijo');
    obsocial.ImportarAnalisisMontoFijoXML(xlista);
  end;
  if act2.Checked then Begin
    estado.Lines.Add('Actualizando Padrón de Obras Sociales');
    obsocial.ImportarObrasSocialesXML(xlista);
  end;
  if act3.Checked then Begin
    estado.Lines.Add('Actualizando Aranceles Obras Sociales');
    obsocial.ImportarArancelesXML(xlista);
  end;
  if act4.Checked then Begin
    estado.Lines.Add('Actualizando Aranceles Nomenclador');
    nomeclatura.ImportarNomecladorXML;
  end;
  if act5.Checked then Begin
    estado.Lines.Add('Actualizando Posición Fiscal Obras Sociales');
    obsocial.ImportarPosicionFiscalXML(xlista);
  end;
  if act6.Checked then Begin
    estado.Lines.Add('Actualizando Aranceles NBU');
    obsocial.ImportarArancelesNBUXML(xlista);
    unidadesNBU.conectar;
    unidadesNBU.importar;
    unidadesNBU.desconectar;

  end;
  if act7.Checked then Begin
    estado.Lines.Add('Actualizando Montos Fijos NBU');
    obsocial.ImportarAnalisisMontoFijoNBU(xlista);
  end;
  if act8.Checked then Begin
    estado.Lines.Add('Actualizando Unidades NBU');
    obsocial.ImportarUnidadesNBU(xlista);
  end;
  if act9.Checked then Begin
    estado.Lines.Add('Actualizando Nomenclador Nacional Normalizado');
    nomeclatura.ImportarNomecladorXML;
  end;
  if act10.Checked then Begin
    estado.Lines.Add('Actualizando NBU');
    nbu.conectar;
    nbu.Importar;
    nbu.desconectar;
  end;

  obsocial.desconectar;
  estado.Lines.Add('');
  estado.Lines.Add('Fin de las Actualizaciones');
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  transferir.Enabled := True;
end;

