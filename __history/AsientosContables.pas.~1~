procedure TfmLibroDiario.GenerarAsientosAjusteInflacionClick(Sender: TObject);
var
  r, s: TQuery;
  indice1, indice2, indice, saldo: double;
  i: integer;
begin
  // Totales cuentas
  StatusBar1.Panels[0].Text := ' Preparando ...!'; StatusBar1.Refresh;
  ldiario.BorrarAsientoAutomatico(per.periodo, 'A');
  StatusBar1.Panels[0].Text := ' Procesando Datos ...!'; StatusBar1.Refresh;
  balgen.conectar;
  balgen.TotalDiario(per.Periodo, per.dfecha, per.hfecha, 'T');
  balgen.desconectar;

  // Recuperamos indices
  s := ContIndiceAI.getIndices(per.dfecha, per.hfecha);
  s.open; s.first; i := 0;
  while not s.eof do begin
    if (i = 0) then begin
      indice1 := s.FieldByName('indice').asfloat;
      i := 1;
    end;
    indice2 := s.FieldByName('indice').asfloat;
    s.next;
  end;

  indice := indice2 - indice1;

  // Cuentas a ajustar
  r := planctas.getCuentasAjustePorInflacion;
  r.Open; r.first;
  while not r.eof do begin
    saldo := r.FieldByName('totaldebe').asfloat - r.FieldByName('totalhaber').asfloat;
    //saldo  

    r.next;
  end;
  r.close; r.free;

  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

end.
