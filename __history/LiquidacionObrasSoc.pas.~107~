procedure TfmLiquidacionOS.perLiqKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  por: Real;
begin
  if Key = VK_UP then ActiveControl := codos;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if utiles.verificarPeriodo(perLiq.Text) then Begin
      RecalcularTotalOS;

      montofact.Caption := utiles.FormatearNumero(FloatToStr(facturacion.setTotalFactObraSocial(perLiq.Text, codos.Text)));

      por := distribucionos.verificarPeriodoLiq(perLiq.Text, codos.Text);

      if por > -1 then utiles.msgError('El Período está Liaquidado, Porcentaje: ' + utiles.FormatearNumero(FloatToStr(por))  + ' ...!');

      if distribucionos.Buscar(periodo.Text, codos.Text, perLiq.Text) then Begin
        CargarDatos;
        DireccionarOS;
        if S.Cells[5, S.Row] = codos.Text then Begin
          ajustesIndi.Enabled := True;
          ajustesIndi.SetFocus;
        end else
          porcentaje.SetFocus;
      end else Begin
        if Length(Trim(porcentaje.Text)) = 0 then porcentaje.Text := utiles.FormatearNumero('0');
        ActiveControl := porcentaje;
      end;
    end;
end;

