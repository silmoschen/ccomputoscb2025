  NewHeight: Integer; var Resize: Boolean);
begin
  redim := true;
end;

procedure TfmEstadisticasIAPOS.periodo1KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (Key = VK_UP) then codos1.setFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if (utiles.verificarPeriodo(periodo1.Text)) then codos1.SetFocus;
end;

procedure TfmEstadisticasIAPOS.periodoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (Key = VK_UP) then codos.setFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if (utiles.verificarPeriodo(periodo.Text)) then unidad.SetFocus;
end;

procedure TfmEstadisticasIAPOS.SDblClick(Sender: TObject);
begin
  if (Length(trim(S.Cells[0, S.Row])) > 0) then begin
    periodo.Text := S.Cells[0, S.Row];
    unidad.Text  := S.Cells[1, S.Row];
    periodo.setFocus;
  end else
    utiles.msgError('El Registro Seleccionado es Incorrecto ...!');
end;

procedure TfmEstadisticasIAPOS.SKeyDow(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (Key = VK_RETURN) then SDblClick(Self);
  if (Key = VK_DELETE) then begin
    if (Length(trim(S.Cells[0, S.Row])) > 0) then begin
      if (utiles.msgSiNo('Seguro para Borrar Período ' + S.Cells[0, S.Row] + ' ?')) then begin
        uref.Borrar(codos.Text, S.Cells[0, S.Row]);
        CargarUnidades;
        periodo.setFocus;
      end
    end else
      utiles.msgError('El Registro Seleccionado es Incorrecto ...!');
  end;
end;

procedure TfmEstadisticasIAPOS.TabSheet1Show(Sender: TObject);
begin
  periodo1.setFocus;
end;

procedure TfmEstadisticasIAPOS.TabSheet2Hide(Sender: TObject);
begin
  if (utiles.verificarPeriodo(perLiq.Caption, '')) and (Length(trim(perLiq.Caption)) = 7)  then begin
    estadisticaccb.DesconectarDebitosProfesionales;
  end;
end;

procedure TfmEstadisticasIAPOS.TabSheet2Show(Sender: TObject);
var
  rs: TQuery;
  i: integer;
begin
  perliq.Caption := periodo1.Text;
  if (utiles.verificarPeriodo(perLiq.Caption, '')) and (length(trim(perLiq.Caption)) = 7) then begin
    grid.IniciarGrilla(R);
    StatusBar1.Panels[0].Text := 'Cargando Montos Obras Sociales ...!'; StatusBar1.Refresh;
    Panel7.Enabled := true; Panel9.Enabled := true;
    Refresh;
    estadisticaccb.ConectarDebitosProfesionales(perLiq.Caption);
    rs := estadisticaCCB.getTotalesInicidenciaPorDeterminacion_Detallada(perliq.Caption);
    if (r <> nil) then begin
      rs.Open; i := 0;
      grid.IniciarGrilla(E);
      while not rs.Eof do begin
        obsocial.getDatos(rs.FieldByName('codos').AsString);
        Inc(i);
        E.Cells[0, i] := rs.FieldByName('periodo').AsString;
        E.Cells[1, i] := obsocial.codos + '-' + obsocial.Nombre;
        E.Cells[2, i] := utiles.FormatearNumero(rs.FieldByName('total1').AsString);
        E.Cells[3, i] := utiles.FormatearNumero(rs.FieldByName('total2').AsString);
        rs.Next;
      end;
      rs.Close; rs.Free;
      if (i > 0) then CargarTotales;
    end;

    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  end else begin
    Panel7.Enabled := false; Panel9.Enabled := false;
  end;
end;

procedure TfmEstadisticasIAPOS.TabSheet3Show(Sender: TObject);
begin
  codos.setFocus;
end;

procedure TfmEstadisticasIAPOS.unidadKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (Key = VK_UP) then periodo.setFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then begin
    unidad.Text := utiles.FormatearNumero(unidad.Text);
    if (obsocial.Buscar(codos.Text)) and (utiles.verificarPeriodo(periodo.Text, '')) and (StrToFloat(unidad.Text) > 0) then begin
      uref.Registrar(codos.Text, periodo.Text, StrToFloat(unidad.Text));
      CargarUnidades;
      periodo.Text := ''; unidad.Text := '';
    end else
      utiles.msgError('Verifique, hay Datos Incorrectos o Incompletos ...!');
    codos.setFocus;
  end;
end;

procedure TfmEstadisticasIAPOS.btnRecalcularClick(Sender: TObject);
var
  i: integer;
begin
  for i := 1 to R.RowCount do begin
    if (length(trim(R.Cells[0, i])) = 0) then break;

    R.Cells[3, i] := utiles.FormatearNumero( FloatToStr (StrToFloat(R.Cells[2, i]) * (StrToFloat(porcentaje.Text) * 0.01) ));
    R.Row := i;
    estadisticaccb.AjustarDebito( R.Cells[6, R.Row], perliq.Caption, R.Cells[0, R.Row], StrToFloat(R.Cells[5, R.Row]), StrToFloat(R.Cells[3, R.Row]));
  end;
  R.Row := 1;
end;

procedure TfmEstadisticasIAPOS.BuscarOS1Click(Sender: TObject);
begin
  Application.CreateForm(TfmListObrasSociales, fmListObrasSociales);
  fmListObrasSociales.introSalir := True;
  fmListObrasSociales.ShowModal;
  codos1.Text := obsocial.tabla.FieldByName('codos').AsString;
  Refresh;
  if fmListObrasSociales.seleccionOK then Begin
    if Length(Trim(codos1.Text)) > 0 then Begin
      DatosObraSocial1;
    end else ActiveControl := codos1;
  end;
  fmListObrasSociales.Release; fmListObrasSociales := nil;
end;

