unit DividirArchivos;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls;

type
  TForm3 = class(TForm)
    Label1: TLabel;
    archivo: TEdit;
    Button1: TButton;
    Label2: TLabel;
    tope: TEdit;
    Label3: TLabel;
    Label4: TLabel;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form3: TForm3;

implementation

{$R *.dfm}

procedure TForm3.Button1Click(Sender: TObject);
var
  narchivo, salida: textfile;
  linea, n: string;
  lineas, bloque: integer;
begin
  lineas := 0; bloque := 1;
  assignfile(narchivo, archivo.text);
  assignfile(salida, 'salida' + inttostr(bloque) + '.sql');
  reset(narchivo);
  rewrite(salida);
  Label4.Caption := 'segmento ' + inttostr(bloque); Label4.Refresh;
  while not EOF(narchivo) do begin
    readln(narchivo, linea);
    n := trimright(copy(linea, 34, 20));
    n := utiles.StringRemplazarCaracteres(n, '''' + '''' + '''', ' ');
    n := utiles.StringRemplazarCaracteres(n, '''' + '`' + '''', ' ');

    if (length(trim(copy(linea, 25, 9))) > 0) then begin
      writeln(salida, 'insert into bioqafil (codos, nrodoc, nombre, fechanac) values (' +
            '"' + codos.Text + '"' + ', ' + '"' + trim(copy(linea, 25, 9)) + '"' + ', ' +
            '"' + n + '"' + ', ' + '"' + copy(linea, 65, 2) + '/' + copy(linea, 63, 2) + '/' + copy(linea, 59, 4) + '"' + ');');
      label3.Caption := linea; label3.Refresh;
    end;
    inc(lineas);
    if (lineas > strtoint(tope.Text)) then begin
      closeFile(salida);
      Inc(bloque);
      assignfile(salida, 'salida' + inttostr(bloque) + '.sql');
      rewrite(salida);
      Label4.Caption := 'segmento ' + inttostr(bloque); Label4.Refresh;
      lineas := 0;
    end;
  end;
  closeFile(narchivo);
  closeFile(salida);
end;

end.
