procedure TfmBajarActualizaciones.btnAplicarClick(Sender: TObject);
begin
  AssignFile(archivo, dbs.DirSistema + '\ftp.ini');
  Rewrite(archivo);
  WriteLn(archivo, ftphost.Text);
  WriteLn(archivo, dirftp.Text);
  WriteLn(archivo, usuario.Text);
  WriteLn(archivo, contrasenia.Text);
  closeFile(archivo);
  AssignFile(archivo, dbs.DirSistema + '\actftp.ini');
  Rewrite(archivo);
  if act1.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act2.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act3.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act4.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act5.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if cond.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act6.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act7.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  if act8.Checked then WriteLn(archivo, '1') else WriteLn(archivo, '0');
  closeFile(archivo);
end;

procedure TfmBajarActualizaciones.FormShow(Sender: TObject);
var
  vhost, vftp, vusuario, vpassword, a1, a2, a3, a4, a5, c1, a6, a7, a8, a9, a10: String;
begin
  configform.Setear(fmBajarActualizaciones);
  Left:=(Screen.Width - Width) div 2; //Top:=(Screen.Height - Height) div 2;
  if FileExists(dbs.DirSistema + '\ftp.ini') then Begin
    AssignFile(archivo, dbs.DirSistema + '\ftp.ini');
    Reset(archivo);
    ReadLn(archivo, vhost);
    ReadLn(archivo, vftp);
    ReadLn(archivo, vusuario);
    ReadLn(archivo, vpassword);
    closeFile(archivo);
    ftphost.Text     := vhost;
    dirftp.Text      := vftp;
    usuario.Text     := vusuario;
    contrasenia.Text := vpassword;
  end;
  if FileExists(dbs.DirSistema + '\actftp.ini') then Begin
    AssignFile(archivo, dbs.DirSistema + '\actftp.ini');
    Reset(archivo);
    ReadLn(archivo, a1);
    ReadLn(archivo, a2);
    ReadLn(archivo, a3);
    ReadLn(archivo, a4);
    ReadLn(archivo, a5);
    ReadLn(archivo, c1);
    ReadLn(archivo, a6);
    ReadLn(archivo, a7);
    ReadLn(archivo, a8);
    ReadLn(archivo, a9);
    ReadLn(archivo, a10);
    closeFile(archivo);
    if a1 = '1' then act1.Checked := True else act1.Checked := False;
    if a2 = '1' then act2.Checked := True else act2.Checked := False;
    if a3 = '1' then act3.Checked := True else act3.Checked := False;
    if a4 = '1' then act4.Checked := True else act4.Checked := False;
    if a5 = '1' then act5.Checked := True else act5.Checked := False;
    if c1 = '1' then cond.Checked := True else cond.Checked := False;
    if Length(Trim(a6)) > 0 then Begin
      if a6 = '1' then act6.Checked := True else act6.Checked := False;
    end;
    if Length(Trim(a7)) > 0 then Begin
      if a7 = '1' then act7.Checked := True else act7.Checked := False;
    end;
    if Length(Trim(a8)) > 0 then Begin
      if a8 = '1' then act8.Checked := True else act8.Checked := False;
    end;
    if Length(Trim(a9)) > 0 then Begin
      if a9 = '1' then act9.Checked := True else act9.Checked := False;
    end;
    if Length(Trim(a10)) > 0 then Begin
      if a10 = '1' then act10.Checked := True else act10.Checked := False;
    end;

  end;
  S.Cells[0, 0] := 'Código'; S.Cells[1, 0] := 'S'; S.Cells[2, 0] := 'Obra Social';
  redim := False;
end;

procedure TfmBajarActualizaciones.CargarListaObrasSociales;
var
  r: TQuery;
  i: Integer;
Begin
  grid.IniciarGrilla(S);
  r := obsocial.setObrasSocialesImportadas;
  r.Open; i := 0;
  while not r.Eof do Begin
    Inc(i);
    S.Cells[0, i] := r.FieldByName('codos').AsString;
    S.Cells[2, i] := r.FieldByName('nombre').AsString;
    r.Next;
  end;
  r.Close; r.Free;
end;

procedure TfmBajarActualizaciones.transferirClick(Sender: TObject);
var
  continuar, transf, conectado: Boolean;
  d: char;
  l: TStringList;
  i, j: Integer;
  Name: String;

begin
  StatusBar1.Panels[0].Text := 'Transfiriendo Datos'; StatusBar1.Refresh;
  estado.Lines.Add('Estableciendo Conexión ...'); estado.Lines.Add('');
  utilesarchivos.BorrarArchivos(dbs.DirSistema + '\actualizaciones_online\download', '*.*');
  transf := False;
  if RadioButton1.Checked then Begin  // Transferir a Medio
    if ((Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'a') or (Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'b') or (Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'c')) then Begin
      if Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'a' then d := 'a';
      if Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'b' then d := 'b';
      if Lowercase(Copy(DriveComboBox.Text, 1, 1)) = 'c' then d := 'c';
      if utilesarchivos.verificarSiHayDiskette(d) then Continuar := True else utiles.msgError('La Unidad ' + UpperCase(d) + ': no está Preparada ...!');
      if d = 'c' then Continuar := True;
      Refresh;
    end;
    if Continuar then Begin
      estado.Lines.Add('Iniciando Proceso de Transferencia ...');
      utilesarchivos.CopiarArchivos(d + ':', '*.bck', dbs.DirSistema + '\actualizaciones_online\download');
      StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
      estado.Lines.Add('Datos Transferidos OK !');
      transf := True;
    end;
  end;

  if RadioButton2.Checked then Begin   // Transferir Vía FTP
    if not cond.Checked then Begin
      conectarInternet;
      if Length(Trim(RasDialerForm.setIPAdress)) > 0 then conectado := True;
    end else
      conectado := True;
    if conectado then Begin
      conectarFTP;
      if IdFTP1.Connected then begin
        l := TStringList.Create;
        IdFTP1.List(l);
        for i := 1 to l.Count do Begin
          if ExtractFileExt(ExtractFileName(l.Strings[i-1])) = '.bck' then Begin
            Name := 'actol.bck'; //Copy(ExtractFileName(l.Strings[i-1]), Length(TrimRight(ExtractFileName(l.Strings[i-1]))) - 17, 18);
            j    := Pos(' ', Name);
            Name := Trim(Copy(Name, j, 18));
            if Pos('.bck', Name) > 0 then Begin
              estado.Lines.Add('Descargando ' + l.Strings[i-1] + ' de: ' + dirftp.Text);
              IdFTP1.TransferType := ftBinary;
              BytesToTransfer := IdFTP1.Size(ExtractFileName(l.Strings[i-1]));
              IdFTP1.Get(Name, dbs.DirSistema + '\actualizaciones_online\download\' + Name, true);
              transf := True;
            end;
          end;
        end;
        estado.Lines.Add('');
        estado.Lines.Add('Transferencia Finalizada');
      end;
      desconectarFTP;
    end else
      utiles.msgError('Error - No Hay Conexion Establecida ...!');
    if not cond.Checked then DesconectarInternet;
  end;

  if transf then Begin
    //Actualizar;
    obsocial.DescompactarArchivosActualizaciones;
    CargarListaObrasSociales;
    transferir.Enabled := True;
    S.SetFocus;
  end;
  estado.Lines.Add('Proceso Terminado ...!'); estado.Lines.Add('');
end;

