unit NominaDeDiagnosticosOMS;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  Db, Grids, DBGrids, Buttons, DBCtrls, ExtCtrls, ComCtrls, StdCtrls, Mask;

type
  TfmListDiagnosticosOMS = class(TForm)
    StatusBar1: TStatusBar;
    Panel1: TPanel;
    Panel2: TPanel;
    DBNavigator: TDBNavigator;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    SpeedButton3: TSpeedButton;
    DBGrid: TDBGrid;
    DTS: TDataSource;
    criterio: TComboBox;
    Label1: TLabel;
    expresion: TMaskEdit;
    Label2: TLabel;
    Splitter1: TSplitter;
    Panel3: TPanel;
    Label3: TLabel;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    desde: TMaskEdit;
    hasta: TMaskEdit;
    dispositivo: TComboBox;
    Panel4: TPanel;
    emitir: TBitBtn;
    cerrar: TBitBtn;
    Panel5: TPanel;
    codigo: TRadioButton;
    alfabetico: TRadioButton;
    Panel6: TPanel;
    entorno: TRadioButton;
    exclusion: TRadioButton;
    SpeedButton4: TSpeedButton;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure expresionChange(Sender: TObject);
    procedure criterioClick(Sender: TObject);
    procedure expresionKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure SpeedButton1Click(Sender: TObject);
    procedure SpeedButton2Click(Sender: TObject);
    procedure DBGridKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure criterioChange(Sender: TObject);
    procedure SpeedButton4Click(Sender: TObject);
    procedure codigoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure codigoClick(Sender: TObject);
    procedure alfabeticoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure alfabeticoClick(Sender: TObject);
    procedure desdeKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure hastaKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure dispositivoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure emitirClick(Sender: TObject);
    procedure cerrarClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure desdeClick(Sender: TObject);
    procedure hastaClick(Sender: TObject);
    procedure SpeedButton3Click(Sender: TObject);
  private
    { Private declarations }
    ordenact: string; control: byte;
  public
    { Public declarations }
    introSalir, seleccionOK: boolean;
  end;

var
  fmListDiagnosticosOMS: TfmListDiagnosticosOMS;

implementation

uses CDiagnosticosCCBOMS, CUtiles, tabladediagnosticosOMS;

{$R *.DFM}

procedure TfmListDiagnosticosOMS.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  if not introSalir then Begin
    diagnosticooms.desconectar;
    Release; fmListDiagnosticosOMS := nil;
  end;
end;

procedure TfmListDiagnosticosOMS.expresionChange(Sender: TObject);
begin
  if criterio.Text = 'Descripción' then diagnosticooms.BuscarPorDescrip(expresion.Text);
  if criterio.Text = 'Código'      then diagnosticooms.BuscarPorId(expresion.Text);
  if criterio.Text = 'Cód.Rápido'  then diagnosticooms.BuscarPorCodRap(expresion.Text);
end;

procedure TfmListDiagnosticosOMS.criterioClick(Sender: TObject);
begin
  ActiveControl := expresion;
end;

procedure TfmListDiagnosticosOMS.expresionKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_INSERT then SpeedButton1Click(Sender);
  if Key = VK_ESCAPE then Close;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then ActiveControl := DBGrid;
end;

procedure TfmListDiagnosticosOMS.SpeedButton1Click(Sender: TObject);
begin
  Application.CreateForm(TfmTablaDiagnosticosOMS, fmTablaDiagnosticosOMS);
  fmTablaDiagnosticosOMS.descrip.Text  := expresion.Text;
  fmTablaDiagnosticosOMS.NoCerrarFinal := True;
  fmTablaDiagnosticosOMS.ShowModal;
end;

procedure TfmListDiagnosticosOMS.SpeedButton2Click(Sender: TObject);
begin
  Application.CreateForm(TfmTablaDiagnosticosOMS, fmTablaDiagnosticosOMS);
  fmTablaDiagnosticosOMS.NoCerrarFinal := True;
  fmTablaDiagnosticosOMS.codigo.Text   := diagnosticooms.tabla.FieldByName('oms_cod').AsString;
  fmTablaDiagnosticosOMS.ShowModal;
end;

procedure TfmListDiagnosticosOMS.DBGridKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_INSERT then SpeedButton1Click(Sender);
  if Key = VK_RETURN then Begin
   if introSalir then Begin
     seleccionOk := True;
     Close;
   end else
     if Not Panel3.Visible then SpeedButton2Click(Sender) else Begin
        if control = 0 then Begin    // El control es del id
          if codigo.Checked then desde.Text := diagnosticooms.tabla.FieldByName('oms_cod').AsString else desde.Text := diagnosticooms.tabla.FieldByName('descrip').AsString;
          ActiveControl := hasta;
        end;
        if control = 1 then Begin    // El control es de la descripción
          if codigo.Checked then hasta.Text := diagnosticooms.tabla.FieldByName('oms_cod').AsString else hasta.Text := diagnosticooms.tabla.FieldByName('descrip').AsString;
          ActiveControl := dispositivo;
        end;
     end;
   end;
  if Key = VK_DELETE then SpeedButton3Click(Self); 
  if Key = VK_ESCAPE then Close;
end;

procedure TfmListDiagnosticosOMS.criterioChange(Sender: TObject);
begin
  expresion.Text := '';
  expresionChange(Sender);
end;

procedure TfmListDiagnosticosOMS.SpeedButton4Click(Sender: TObject);
begin
  ordenact := criterio.Text;
  if Not Panel3.Visible then Begin
    Panel3.Visible  := True;
    codigo.Checked  := True; entorno.Checked := True;
    desde.Text := ''; hasta.Text := ''; expresion.Text := '';
    criterio.Text   := 'Código';
    expresionChange(Sender);
    ActiveControl   := desde;
  end;
end;

procedure TfmListDiagnosticosOMS.codigoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then ActiveControl := desde;
end;

procedure TfmListDiagnosticosOMS.codigoClick(Sender: TObject);
begin
  criterio.Text := 'Código';
  expresionChange(Sender);
  desde.Text := ''; hasta.Text := ''; dispositivo.Text := 'Presentación Preliminar';
end;

procedure TfmListDiagnosticosOMS.alfabeticoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then ActiveControl := desde;
end;

procedure TfmListDiagnosticosOMS.alfabeticoClick(Sender: TObject);
begin
  Criterio.Text := 'Nombre';
  expresionChange(Sender);
  desde.Text := ''; hasta.Text := ''; dispositivo.Text := 'Presentación Preliminar';
end;

procedure TfmListDiagnosticosOMS.desdeKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_UP then
    if codigo.Checked then ActiveControl := codigo else ActiveControl := alfabetico;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then Begin
    if Length(Trim(expresion.Text)) = 0 then ActiveControl := expresion else ActiveControl := hasta;
    control := 0;
  end;
end;

procedure TfmListDiagnosticosOMS.hastaKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_UP then ActiveControl := desde;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then Begin
    if Length(Trim(expresion.Text)) = 0 then ActiveControl := expresion else ActiveControl := dispositivo;
    control := 1;
  end;
end;

procedure TfmListDiagnosticosOMS.dispositivoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_RETURN then ActiveControl := emitir;
end;

procedure TfmListDiagnosticosOMS.emitirClick(Sender: TObject);
var
  salida, ordensalida, entornosal: char;
begin
  if (Length(Trim(desde.Text)) = 0) or (Length(Trim(hasta.Text)) = 0) then utiles.msgError('No se han definido suficientes parámetros ...!') else Begin
    StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
    salida := 'P'; ordensalida := 'C'; entornosal := 'E';
    if dispositivo.Text = 'Impresora' then salida := 'I';
    if alfabetico.Checked then ordensalida := 'A';
    if exclusion.Checked then entornosal := 'X';
    diagnosticooms.Listar(ordensalida, desde.Text, hasta.Text, entornosal, salida);
    StatusBar1.Panels[0].Text := '';
  end;
  ActiveControl := cerrar;
end;

procedure TfmListDiagnosticosOMS.cerrarClick(Sender: TObject);
begin
  Panel3.Visible := False;
  criterio.Text  := ordenact;
  expresionChange(Sender);
  ActiveControl  := expresion;
end;

procedure TfmListDiagnosticosOMS.FormShow(Sender: TObject);
begin
  if FormStyle = fsMDIChild then Begin
    Height := 380; Width := 571; Top := 25; Left:=(Screen.Width - Width) div 2;
  end;
  DTS.DataSet := diagnosticooms.tabla;
  if not introSalir then diagnosticooms.conectar;
  expresionChange(Self);
end;

procedure TfmListDiagnosticosOMS.desdeClick(Sender: TObject);
begin
  control := 0;
end;

procedure TfmListDiagnosticosOMS.hastaClick(Sender: TObject);
begin
  control := 1;
end;

procedure TfmListDiagnosticosOMS.SpeedButton3Click(Sender: TObject);
var
  l: TStringList;
  i: Integer;
begin
  if not (introsalir) then begin
    if DBGrid.SelectedRows.Count = 0 then Begin
      Application.CreateForm(TfmTablaDiagnosticosOMS, fmTablaDiagnosticosOMS);
      fmTablaDiagnosticosOMS.codigo.Text := diagnosticooms.tabla.FieldByName('oms_cod').AsString;
      fmTablaDiagnosticosOMS.BajaClick(Sender);
      ActiveControl := DBGrid;
    end else Begin
      l := TStringList.Create;
      for i := 0 to DBGrid.SelectedRows.Count-1 do Begin
        diagnosticooms.tabla.GotoBookmark(pointer(DBGrid.SelectedRows.Items[i]));
        l.Add(diagnosticooms.tabla.FieldByName('oms_cod').AsString);
      end;
      if utiles.msgSiNo('Seguro para Borrar los Items Seleccionados ?') then
        for i := 1 to l.Count do diagnosticooms.Borrar(l.Strings[i-1]);

      diagnosticooms.BuscarPorDescrip('');
    end;
  end else
    utiles.msgError('La Opción Eliminar No esta Disponible durante la Selección ...!');
end;

end.
