procedure TfmLiquidacionOS.IniciarPeriodo;
// Objetivo...: Iniciar Período Liquidación
begin
  distribucionos.PrepararDirectorio(periodo.Text + nrodist.Text);
  if distribucionos.verificarPeriodo(periodo.Text + nrodist.Text) then Begin
    DebitosCreditosPersonales.Enabled := True;
    Panel21.Enabled   := DebitosCreditosPersonales.Enabled;
    Panel25.Enabled   := DebitosCreditosPersonales.Enabled;
    Panel4.Enabled    := DebitosCreditosPersonales.Enabled;
    GroupBox3.Enabled := DebitosCreditosPersonales.Enabled;
    if Panel21.Enabled then ActiveControl := codos;
  end;
  CargarLiqGanancias;
  codos.Text :=  ''; nos.Caption :=  ''; perLiq.Text := ''; porcentaje.Text := ''; importeing.Text := ''; fecha.Text := '';
  ObrasSocialesDistribucion;
end;

procedure TfmLiquidacionOS.ObrasSocialesDistribucion;
// Objetivo...: Cargar los pagos de las Obras Sociales en Curso
var
  l: TStringList;
  i, j: Integer;
  cos: string;
Begin
  StatusBar1.Panels[0].Text := 'Recuperando Datos Obras Sociales ...!'; StatusBar1.Refresh;
  l := distribucionos.setLiquidaciones(periodo.Text, nrodist.Text);
  grid.IniciarGrilla(S);
  if l.Count > 0 then Begin
    for i := 1 to l.Count do Begin
      S.Cells[0, i] := utiles.sFormatoFecha(Copy(l.Strings[i-1], 14, 8));
      S.Cells[1, i] := Copy(l.Strings[i-1], 7, 7);
      obsocial.getDatos(Copy(l.Strings[i-1], 1, 6));
      S.Cells[2, i] := Copy(obsocial.Nombre, 1, 30);
      j := Pos(';1', l.Strings[i-1]);
      S.Cells[3, i] := Trim(Copy(l.Strings[i-1], j+2, 8));
      S.Cells[4, i] := utiles.FormatearNumero(Trim(Copy(l.Strings[i-1], 22, j - (22))));
      S.Cells[5, i] := Copy(l.Strings[i-1], 1, 6);

      if (coseguro.getCoseguro(obsocial.codos, S.Cells[1, i]) <> 0) then S.Cells[6, i] := 'S' else S.Cells[6, i] := 'N';
    end;
    if i > 1 then S.Row := i-1 else S.Row := i;
  end;
  osliq.Caption := inttostr(i) + ' O.S. Liq.';
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

procedure TfmLiquidacionOS.DireccionarOS;
// Objetivo...: Iniciar Formulario
var
  i: Integer;
begin
  for i := 1 to S.RowCount do Begin
    if Length(Trim(S.Cells[0, i])) = 0 then Break;
    if Copy(S.Cells[2, i], 1, 30) = Copy(nos.Caption, 1, 30) then Break;
  end;
  if i > 0 then S.Row := i;
  S.Refresh;
end;

procedure TfmLiquidacionOS.IniciarAjustes;
// Objetivo...: Iniciar Formulario
begin
  ajustesindi.Enabled := False;
  codos.Text := ''; nos.Caption := ''; perLiq.Text := ''; montofact.Caption := '0'; montofact.Caption := utiles.FormatearNumero(montofact.Caption);
  dist.Caption := montofact.Caption; porcentaje.Text := ''; importeing.Text := montofact.Caption ; fecha.Text := '';
  ActiveControl       := codos;
end;

procedure TfmLiquidacionOS.DatosObraSocial;
begin
  DatosOS;
  montofact.Caption := utiles.FormatearNumero(FloatToStr(facturacion.setTotalFactObraSocial(perLiq.Text, codos.Text)));
  DireccionarOS;
  ActiveControl := perLiq;
end;

procedure TfmLiquidacionOS.DatosOS;
begin
  obsocial.getDatos(codos.Text);
  nos.Caption := Copy(obsocial.Nombre, 1, 40);
end;

procedure TfmLiquidacionOS.CargarDatos;
begin
  distribucionos.getDatos(periodo.Text, codos.Text, perliq.Text, nrodist.Text);
  if Length(Trim(perLiq.Text)) < 7 then perLiq.Text     := distribucionos.PeriodoLiq;
  porcentaje.Text := utiles.FormatearNumero(FloatToStr(distribucionos.Porcentaje));
  importeing.Text := utiles.FormatearNumero(FloatToStr(distribucionos.Importe));
  dist.Caption    := utiles.FormatearNumero(FloatToStr(StrToFloat(montofact.Caption) * (StrToFloat(porcentaje.Text)) * 0.01));
  fecha.Text      := distribucionos.Fecha;
  if StrToFloat(importeing.Text) = 0 then importeing.Text := dist.Caption;
  if Length(Trim(perLiq.Text)) < 7 then
    if distribucionos.ExisteLiquidacion then perLiq.Text := distribucionos.PeriodoLiq;
  Baja.Enabled    := distribucionos.ExisteLiquidacion;
end;

procedure TfmLiquidacionOS.DatosProfesional;
Begin
  profesional.getDatos(idlab.Text);
  np.Caption := profesional.nombre;
end;

procedure TfmLiquidacionOS.CargarConfigInformes(xinforme: String);
Begin
  distribucionos.getConfiguracionInforme(xinforme);
  cantcopias.Text := IntToStr(distribucionos.copias);
  if distribucionos.salto = 0 then ruptura.Checked := False else ruptura.Checked := True;
end;

procedure TfmLiquidacionOS.CargarNroDistribucion;
// Objetivo...: Cargar el Nro. de Distribución
Begin
  nrodist.Text    := distribucionos.setNroDistribucion(periodo.Text);
  if Length(Trim(nrodist.Text)) = 0 then nrodist.Text := '01';
  nrodistinf.Text := nrodist.Text;
end;

function TfmLiquidacionOS.ControlarNroDist(xnrodist: String): Boolean;
// Objetivo...: Controlar el Nro. de Distribución
Begin
  Result := False;
  if (xnrodist < '01') or (xnrodist > '02') then utiles.msgError('El Número Maximo de Distribuciones por Período son Dos ...!') else Result := True;
end;

procedure TfmLiquidacionOS.CargarListaDist;
// Objetivo...: Cargar el retenciones a liq. en Distribución
var
  d1, d2: String;
Begin
  listadist := TStringList.Create;
  if FileExists(dbs.DirSistema + '\retdist.dat') then Begin
    AssignFile(archivo, dbs.DirSistema + '\retdist.dat');
    Reset(archivo);
    ReadLn(archivo, d1);
    ReadLn(archivo, d2);
    CloseFile(archivo);
    if d1 = '1' then dist1.Checked := True else dist1.Checked := False;
    if d2 = '1' then dist2.Checked := True else dist2.Checked := False;
  end;
  if dist1.Checked then listadist.Add('01');
  if dist2.Checked then listadist.Add('02');
end;

procedure TfmLiquidacionOS.RecalcularMontos;
// Objetivo...: Recalcular Montos
var
  r: TQuery;
Begin
  l := TStringList.Create;
  r := profesional.setProfesionalesAlf;
  r.Open;
  while not r.Eof do Begin
    if PageControl1.ActivePage <> TabSheet6 then l.Add(r.FieldByName('idprof').AsString);
    if PageControl1.ActivePage = TabSheet6 then Begin
      profesional.getDatos(r.FieldByName('idprof').AsString);
      profesional.SincronizarListaRetIVA(per.Text, r.FieldByName('idprof').AsString);
      if profesional.Retieneiva = 'S' then l.Add(r.FieldByName('idprof').AsString);
    end;
    r.Next;
  end;
  r.Close; r.Free;

  StatusBar1.Panels[0].Text := 'Recalculando Montos ...!'; StatusBar1.Refresh;
  if PageControl1.ActivePage <> TabSheet6 then distribucionos.RecalcularDistribucionProfesional(per.Text + nrodistinf.Text, perLiq.Text + nrodistinf.Text, l, listadist, CheckBox2.Checked, unifganancias.Checked, recMontos.Checked, liqganancias.Text, nrodist.Text);
  if PageControl1.ActivePage = TabSheet6 then distribucionos.RecalcularDistribucionProfesional(periodogan.Text + distgan.Text, perLiq.Text + distgan.Text, l, listadist, CheckBox2.Checked, unifganancias.Checked, recMontos.Checked, 'N', nrodist.Text);
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

procedure TfmLiquidacionOS.CargarDatosProfesional;
// Objetivo...: Cargar Datos Profesionales
Begin
  profesional.getDatos(idprofdep.Text);
  npr.Caption := profesional.nombre;
  codbanco.SetFocus;
end;

procedure TfmLiquidacionOS.CargarDatosBanco;
// Objetivo...: Cargar Datos Profesionales
Begin
  entbcos.getDatos(codbanco.Text);
  nbco.Caption := entbcos.descrip;
  fechadep.SetFocus;
end;

procedure TfmLiquidacionOS.RegistrarDeposito;
// Objetivo...: Registrar Deposito
Begin
  if (profesional.Buscar(idprofdep.Text)) and (entbcos.Buscar(codbanco.Text)) and (utiles.ctrlFecha(fechadep.Text, '')) then Begin
    distribucionos.RegistrarDeposito(perdist.Caption + ndist.Caption, idprofdep.Text, codbanco.Text, fechadep.Text, observac.Text, ndist.Caption);
    CargarDepositos;
    idprofdep.Text := ''; npr.Caption := ''; codbanco.Text := ''; nbco.Caption := ''; fechadep.Text := ''; idprofdep.SetFocus;
  end else
    utiles.msgError('Verifique, hay Datos Incorrectos ...!');
end;

procedure TfmLiquidacionOS.CargarDepositos;
// Objetivo...: Cargar Depositos
var
  l: TStringList;
  i, j: Integer;
Begin
  StatusBar1.Panels[0].Text := 'Cargando Depósitos ...!'; StatusBar1.Refresh;
  grid.IniciarGrilla(P);
  j := 1;
  l := distribucionos.setDepositos(perdist.Caption + ndist.Caption, ndist.Caption);
  for i := 1 to l.Count do Begin
    P.Cells[0, i] := Copy(l.Strings[i-1], 1, 6);
    profesional.getDatos(P.Cells[0, i]);
    P.Cells[1, i] := profesional.nombre;
    P.Cells[2, i] := Copy(l.Strings[i-1], 7, 3);
    entbcos.getDatos(P.Cells[2, i]);
    P.Cells[3, i] := entbcos.descrip;
    P.Cells[4, i] := Copy(l.Strings[i-1], 10, 8);
    P.Cells[5, i] := Copy(l.Strings[i-1], 28, 150);
    P.Cells[6, i] := Copy(l.Strings[i-1], 18, 7);
    if P.Cells[0, i] = idprofdep.Text then j := i;
  end;
  P.Row := j;
  l.Destroy;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

procedure TfmLiquidacionOS.CargarLiqGanancias;
var
  g1, g2, g3, g4: String;
Begin
  if FileExists(dbs.DirSistema + '\distgan.dat') then Begin
    AssignFile(archivo, dbs.DirSistema + '\distgan.dat');
    Reset(archivo);
    ReadLn(archivo, g1);
    ReadLn(archivo, g2);
    ReadLn(archivo, g3);
    ReadLn(archivo, g4);
    ga1.Checked := False; ga2.Checked := False; osiva.Checked := False; liqIndi.Checked := False;
    if g1 = '1' then ga1.Checked := True else ga1.Checked := False;
    if g2 = '1' then ga2.Checked := True else ga2.Checked := False;
    if g3 = '1' then osiva.Checked := True else osiva.Checked := False;
    if g4 = '1' then liqIndi.Checked := True else liqIndi.Checked := False;
    CloseFile(archivo);
    liqganancias.Text := 'N';
    if not (ga1.Checked) and not (ga2.Checked) then liqganancias.Text := 'S';
    if ga1.Checked then
      if ga1.Caption = nrodistinf.Text then liqganancias.Text := 'S' else liqganancias.Text := 'N';
    if ga2.Checked then
      if ga2.Caption = nrodistinf.Text then liqganancias.Text := 'S' else liqganancias.Text := 'N';

    if ga1.Checked then liqganancias.Text := 'S';
    if ga2.Checked then liqganancias.Text := 'S';
  end;
end;

