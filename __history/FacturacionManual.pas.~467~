procedure TfmFactManual.ordenauditKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  i, j: Integer;
  l, nroInt, nroauditado: String;
  sigue, pornroref, continua, cancela: Boolean;
begin
  if Key = VK_ESCAPE then
    if verificarDatosAuditoria then btnFinalizarClick(Sender);
  if Key = VK_UP then idprofaudit.SetFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if Length(Trim(ordenaudit.Text)) > 0 then
      if (length(trim(ordenaudit.Text)) > 0) then Begin
        if (nap = 'shmsoftfccbcentrobioq.exe') or (nap = 'shmsoftfccbcentrobioqcont.exe') then l := auditoriacb.setLaboratorioFacturado(ordenaudit.Text) else l := '';

        nroauditado := ordenaudit.Text;
        pornroref := false; continua := false; cancela := false;
        if (auditonline.BuscarReferenciaSinProfesional(ordenaudit.Text)) and (length(trim(ordenaudit.text)) > 11) then begin
          pornroref   := true;
          continua    := true;
          nroauditado := auditonline.Nroauditoria;
        end;
        
        if facturacion.verificarOrden(idprofaudit.Text, utiles.sLlenarIzquierda(nroauditado, 10, '0')) then begin
          utiles.msgError('La Orden Esta Registrada para el Profesional ' + facturacion.NProfesional + ' ...!');
          sigue := false;
          continua := false;
        end else
          sigue := True;
        if (l <> idprofaudit.Text) and (Length(Trim(l)) > 0) and (continua) then Begin
           profesional.getDatos(l);
           sigue := utiles.msgSiNo('La Orden ' + nroauditado + ' está Facturada en el Laboratorio ' + chr(13) + l + ' - ' + profesional.nombre + ' ...!');
        end;

        if not continua then
          continua := sigue;

        if (continua) then Begin
          if verificarOrdenInterna(nroauditado) then Begin
            utiles.msgError('La Orden ya está Registrada ...!');
            ordenaudit.Text := '';
          end else Begin
            if not modificaaudit then Begin
              itemsaudit := 1;
              for j := 1 to FAudit.RowCount do begin
                if (length(trim(FAudit.Cells[0, j])) = 0) then break;
                itemsaudit := j+1;
              end;
              i := itemsaudit;
            end else
              i := FAudit.Row;

          if not (pornroref) then
            nroInt := utiles.sLlenarIzquierda(nroauditado, 10, '0')
          else begin
            if (continua) then
              nroInt := utiles.sLlenarIzquierda(auditonline.getNroInterno(ordenaudit.Text), 10, '0')
            else
              utiles.msgError('El Número de Orden es Incorrecto ...!');
          end;

          if (length(trim(nroInt)) = 10) then begin
           if (StrToInt(nroInt) > 0) and not (cancela) then begin
            FAudit.Cells[0, i]   := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
            FAudit.Cells[1, i]   := idprofaudit.Text;
            FAudit.Cells[2, i]   := profaudit.Caption;
            if not (pornroref) then
              FAudit.Cells[3, i]   := nroInt
            else begin
              if (continua) then
                FAudit.Cells[3, i] := nroInt
              else
                utiles.msgError('El Número de Orden es Incorrecto ...!');
            end;
            if (modificaaudit) and (Length(Trim(OA.Cells[0, 1])) > 0) then FAudit.Cells[4, i] := 'X' else FAudit.Cells[4, i] := '';
            FAudit.Row           := i;
            ordenaudit.Text      := '';
            modificaaudit        := False;
            audit_modif          := True;
            FAudit.Enabled       := True;
            btnFinalizar.Enabled := True;
           end else
            utiles.msgError('El Número de Orden es Incorrecto ...!');
          end else begin
            utiles.msgError('El Número de Orden es Incorrecto ...!');
            if not modificaaudit then
              itemsaudit := itemsaudit - 1;
          end;
        End;
      End;
    end;
end;

