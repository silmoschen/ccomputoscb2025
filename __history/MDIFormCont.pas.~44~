procedure TfmSistem.FormCreate(Sender: TObject);
var
  Sem: THandle;
var
  R: TRect;
begin
  dbs.DirSistema := Copy(ExtractFilePath(Application.ExeName), 1, Length(ExtractFilePath(Application.ExeName)) -1);

  SystemParametersInfo(SPI_GETWORKAREA, 0, @R, 0);
  SetBounds(R.Left, R.Top, R.Right-R.Left, R.Bottom-R.Top);
  Sem := CreateSemaphore(nil,0,1,'PROGRAM_NAME');
  if ((Sem <> 0) and (GetLastError = ERROR_ALREADY_EXISTS)) then
  begin
    CloseHandle( Sem );
    ShowMessage('Este programa ya se está ejecutando...');
    Halt;
  end;
  FIniFileName := dbs.dirSistema + '\ccomputoscb.ini';
end;

