procedure TfmObsociales.CargarGrillaUnidadesNBU;
var
  i, l, j: integer;
begin
  if not modifica then
    modifica := BuscarAnalisisNBU(codnbu.Text);

  For j := 1 to U.RowCount do Begin
    it := j;
    if Length(Trim(U.Cells[0, j])) = 0 then Break;
  end;

  if not modifica then i := it else i := U.row;

  l := obtenerlineaNBU(codnbu.Text, pernbudesde.Text);  // Buscamos la Ranura para Mantener el orden con los códigos
  if l > 0 then Begin
    if not modifica then Begin
      if l > 1 then l := l + 1 else
        if Length(Trim(U.Cells[0, l+1])) > 0 then l := l + 1;

      U.Row := l;
      grid.InsertarLinea(U, 3);
      i := l;
    end;

    if modifica then Begin
      U.Row := l;
      i     := l;
    end;
  end;

  U.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
  U.cells[1, i] := codnbu.Text;
  U.cells[2, i] := desnbu.Caption;
  U.cells[3, i] := valorunidadnbu.Text;
  if Length(Trim(pernbudesde.Text)) = 7 then U.cells[4, i] := pernbudesde.Text else U.Cells[4, i] := '';
  if Length(Trim(pernbuhasta.Text)) = 7 then U.cells[5, i] := pernbuhasta.Text else U.Cells[5, i] := '';
  modifica := False;
  U.row    := i;
end;

