procedure TfmExportarOrdenesSoporteMagnetico.cargarObrasSociales;
var
  r: TIBQuery;
  i: integer;
  total: double;
begin

  grid.IniciarGrilla(A);

  obsocial.getDatos(idos.Text);
  obsocial.SincronizarArancel(idos.Text, periodo.Text);

  listProfesionales.Items.Clear;
  listprof.items.Clear;

  btnEnviar.Enabled := false;

  listProfesionales.Items.Add('< Todos los Profesionales >');
  listprof.Items.Add('0');
  listProfesionales.Items.Add('< Responsables de Monotributo >');
  listprof.Items.Add('1');

  r := facturacion.getListPracticasFacturadas(periodo.Text, idos.Text);
  r.open; i := 0; total := 0;
  while not r.eof do begin
    profesional.getDatos(r.FieldByName('idprof').asstring);
    profesional.SincronizarListaRetIVA(periodo.Text, r.FieldByName('idprof').asstring);
    inc(i);
    A.Cells[0, i] := periodo.Text;
    A.Cells[1, i] := profesional.codigo;
    A.Cells[2, i] := profesional.Nombre;
    A.Cells[3, i] := utiles.FormatearNumero(r.FieldByName('monto').asstring);
    A.Cells[4, i] := utiles.FormatearNumero(r.FieldByName('iva').asstring);
    A.Cells[5, i] := utiles.FormatearNumero(r.FieldByName('exento').asstring);
    A.Cells[12,i] := utiles.FormatearNumero(FloatToStr (r.FieldByName('iva').asfloat * (obsocial.retencioniva * 0.01) ) );
    A.Cells[6, i] := utiles.FormatearNumero(FloatToStr(r.FieldByName('iva').asfloat + StrToFloat(A.Cells[12,i]) + r.FieldByName('exento').asfloat)); // + r.FieldByName('iva').asfloat + r.FieldByName('monto').asfloat) );
    if (profesional.Retieneiva = 'N') then begin
      A.Cells[6, i] := A.Cells[3, i];
    end;
    A.Cells[7, i] := idregla.Text;   // Regla de Exportación
    A.Cells[11,i] := utiles.setFechaActual;

    if (recalcular) then
      facturacion.GuardarTotalProfesionalDistribucion(periodo.Text, r.FieldByName('idprof').asstring, idos.Text,
        strtofloat(A.Cells[6, i]), r.FieldByName('monto').asfloat, r.FieldByName('iva').asfloat, r.FieldByName('exento').asfloat,
        StrToFloat(A.Cells[12,i]));

    A.Cells[13,i] := profesional.Retieneiva;

    // Ajustamos si la Obra Social no retiene Iva - 22/04/2026
    {
    if (obsocial.Retieneiva = 'N') then begin
       A.Cells[4, i] := utiles.FormatearNumero('0');
       A.Cells[5, i] := utiles.FormatearNumero('0');
       A.Cells[6, i] := A.Cells[3, i];
    end;
    }

    total := total + strtofloat( A.Cells[6, i] );

    if (profesional.Retieneiva = 'S') then begin
      listProfesionales.Items.Add(profesional.nombre);
      listprof.Items.Add(profesional.codigo);
    end;

    // Prorrateamos comprobante
    exportObrasSociales.getDatos(periodo.Text, r.FieldByName('idprof').asstring, idos.Text);
    A.Cells[8, i] := exportObrasSociales.Tipo;
    A.Cells[9, i] := exportObrasSociales.Sucursal;
    if (length(trim(exportObrasSociales.Numero)) > 0) then A.Cells[10,i] := utiles.sLlenarIzquierda(exportObrasSociales.Numero, 8, '0') else A.Cells[10,i] := '';
    A.Cells[11,i] := exportObrasSociales.Fecha;

    if (length(trim(exportObrasSociales.Tipo)) > 0) then btnEnviar.Enabled := true;

    

    r.next;
  end;
  r.Close; r.free;

  totalfact.Caption := utiles.FormatearNumero(FloatToStr(total));

  listProfesionales.ItemIndex := 0;
  listProf.ItemIndex := 0;
end;

