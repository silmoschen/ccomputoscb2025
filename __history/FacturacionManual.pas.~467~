procedure TfmFactManual.impClick(Sender: TObject);
var
  i, k: Integer;
  os: TStringList;
  la, lact: String;
begin
  os := TStringList.Create;
  periodo.Text := periodoImp.Text;
  k  := D.Row;   // Laboratorio Actual
  la := D.Cells[0, D.Row];
  grid.IniciarGrilla(OA); tls := 0;
  StatusBar1.Panels[0].Text := 'Importando ...!'; StatusBar1.Refresh;
  // Obtenemos las obras sociales seleccionadas
  if Panel44.Visible then Begin  // Cargamos los datos de las Obras Sociales Seleccionadas
    For i := 1 to P.RowCount do Begin
      if Length(Trim(P.Cells[0, i])) = 0 then Break;
      if P.Cells[1, i] = 'S' then os.Add(P.Cells[0, i]);
    end;
    if os.Count > 0 then Begin
      facturacion.TransferirDatosImportados(periodoImp.Text, D.Cells[0, D.Row], os);
      ImportarOrdenesAuditoria(periodoImp.Text, D.Cells[0, D.Row]);
      lact := D.Cells[0, D.Row];
    end else
      utiles.msgError('No ha Seleccionado Niguna Obra Social a Importar,' + chr(13) + 'Operación Incorrecta ...!');
  end else Begin                 // Cargamos todos los laboratorios con todas las obras sociales
    For i := 1 to D.RowCount do Begin
      if Length(Trim(D.Cells[0, i])) = 0 then Break;
      D.Row := i; D.Refresh;
      StatusBar1.Panels[0].Text := 'Importando Datos Laboratorio ' + D.Cells[0, i]; StatusBar1.Refresh;
      facturacion.TransferirDatosImportados(periodoImp.Text, D.Cells[0, i], os);
      ImportarOrdenesAuditoria(periodoImp.Text, D.Cells[0, i]);
    end;
  end;

  imp.Enabled := False;
  CargarDatosImportados;

  if os.Count > 0 then Begin  // Pasamos al sgte. Laboratorio
    //Inc(k);
    //if Length(Trim(D.Cells[0, k])) > 0 then D.Row := k;
    imp.Enabled := True; detalleOS.Enabled := True;
  end;

  D.ColCount := 5;
  D.ColWidths[1] := 250; D.ColWidths[2] := 180; D.ColWidths[3] := 280;

  for k := 1 to D.RowCount do Begin
    if Length(Trim(D.cells[0, k-1])) = 0 then Break;
    if D.cells[0, k-1] = idl_lab then Begin
      D.Row := k-1;
      Break;
    end;
  end;

  D.Refresh;

  if (Length(Trim(D.cells[3, D.Row])) > 0) and (os.Count < 1) then Begin
    //facturacion.SeleccionarLaboratorio(D.cells[3, D.Row]);  // Activamos Via de trabajo
    idlab.Text   := D.cells[0, D.Row];
    idprof.Text  := D.cells[0, D.Row];
    idl.Caption  := D.cells[0, D.Row];
    l.Caption    := D.cells[1, D.Row];
    prof.Caption := D.cells[1, D.Row];
    idprof_audit.Text := idl.Caption;
    idl.Refresh; l.Refresh;
  end;

  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  if os.Count = 0 then Begin   // Importación total
    Panel44.Visible := False; D.Enabled := True; detalleOS.Visible := False;
    ActiveControl := periodoImp;
  end else Begin
    Panel44.Visible := False;
    D.Enabled       := True;
    ActiveControl   := D;
  end;

  imp.Enabled := False;
  if tls > 0 then Begin
    detalleOS.Caption := '&Facturar Ordenes Auditoria';
    detalleOS.Visible := True;
    detalleOS.Enabled := True;
  end;

  For i := 1 to D.RowCount do Begin  // Sincronizamos el laboratorio
    if Length(Trim(D.Cells[0, i])) = 0 then Break;
    if D.Cells[0, i] = la then Begin
      D.Row := i;
      Break;
    end;
  end;

  // Direccionamos - 20/03/2012
  facturacion.DireccionarLaboratorio(periodoImp.Text, D.Cells[0, D.Row]);
end;

