  CargarDeterminacionesMontoFijo;
end;

procedure TfmObsociales.FiltrarCodigosRecientes;
// Objetivo...: Cargamos los análisis con montos fijos
var
  m, l: integer;
  codigoanter: string;

  procedure Agregar(item: integer);
  var
    i, it: integer;
    cod, peranter: string;
  begin
    // Prorrateamos el periodo mas nuevo
    cod := A.Cells[1, item];
    //if (cod = '1017') then utiles.msgError('s');
    peranter := ''; it := 0;
    for i := 1 to A.RowCount do begin
      if (length(trim(A.Cells[0, i])) = 0) then break;
      if (A.Cells[1, i] = cod) then begin
        if (copy(A.Cells[4, i], 4, 4) + copy(A.Cells[4, i], 1, 2) > peranter) then begin
          it := i;
          peranter := copy(A.Cells[4, i], 4, 4) + copy(A.Cells[4, i], 1, 2);
        end;
      end;
    end;

    // Visualizamos el periodo mas nuevo
    //if (cod = '1017') then utiles.msgError(A.Cells[5, it]);
    if (length(trim(A.Cells[5, it])) = 0) then begin
      inc(m);
      B.cells[0, m] := utiles.sLlenarIzquierda(inttostr(m), 3, '0');
      B.cells[1, m] := A.cells[1, it];
      B.cells[2, m] := A.cells[2, it];
      B.cells[3, m] := A.cells[3, it];
      B.cells[4, m] := A.Cells[4, it];
      B.cells[5, m] := A.Cells[5, it];
      B.cells[6, m] := A.Cells[0, it];
    end;
  end;

begin
  // Filtramos los items mas recientes en la grilla
  grid.IniciarGrilla(B);
  m := 0;
  grid.Sortgrid(A,1,1);
  codigoanter := A.cells[1, 1];
  for l := 1 to A.RowCount do begin
    if (length(trim(A.Cells[0, l])) = 0) then break;
    if (A.Cells[1, l] <> codigoanter) then begin
      Agregar(l-1);
      codigoanter := A.Cells[1, l];
    end;
  end;
  Agregar(l-1);

  grid.Sortgrid(A,0,1);

  grid.Sortgrid(B,6,1);
  grid.RegenerarItems(B, 3);

  B.Row := m;

  B.FixedRows := 1;

  //----------------------------------------------------------------------------
end;

procedure TfmObsociales.CargarDeterminacionesMontoFijo;
// Objetivo...: Cargamos los análisis con montos fijos
var
  r: TQuery;
  i, j, m, l: integer;
  codigoanter: string;
begin
  For i := 1 to A.RowCount do
    For j := 1 to A.ColCount do A.cells[j-1, i] := '';

  if factnbu.Text <> 'S' then Begin
    r := obsocial.setAnalisisMontoFijo(codos.Text);
    r.Open; r.First; i := 0;
    while not r.EOF do Begin
      Inc(i);
      nomeclatura.getDatos(r.FieldByName('codanalisis').AsString);
      A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0'); //r.FieldByName('items').AsString;
      A.cells[1, i] := r.FieldByName('codanalisis').AsString;
      A.cells[2, i] := nomeclatura.descrip;
      A.cells[3, i] := utiles.FormatearNumero(r.FieldByName('importe').AsString);
      A.Cells[4, i] := r.FieldByName('periodo').AsString;
      A.Cells[5, i] := r.FieldByName('perhasta').AsString;
      r.Next;
    end;
    r.Close; r.Free;
    it := i;
    if i = 0 then A.Row := 1 else A.row := it;
  end;

  if factnbu.Text = 'S' then Begin
    r := obsocial.setAnalisisMontoFijoNBU(codos.Text);
    r.Open; r.First; i := 0;
    while not r.EOF do Begin
      Inc(i);
      nbu.getDatos(r.FieldByName('codanalisis').AsString);
      A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0'); //r.FieldByName('items').AsString;
      A.cells[1, i] := r.FieldByName('codanalisis').AsString;
      A.cells[2, i] := nbu.Descrip;
      A.cells[3, i] := utiles.FormatearNumero(r.FieldByName('importe').AsString);
      A.Cells[4, i] := r.FieldByName('periodo').AsString;
      A.Cells[5, i] := r.FieldByName('perhasta').AsString;
      r.Next;
    end;
    r.Close; r.Free;
    it := i;
    if i = 0 then A.Row := 1 else A.row := it;
  end;

  FiltrarCodigosRecientes;

  CargarDatosFacturacion;

  if i = 0 then Begin
    CheckBox1.Checked := False;
    Panel3.Visible := False; Panel4.Visible := False;
  end else Begin
    CheckBox1.Checked := True;
    Panel3.Visible := True; Panel4.Visible := True;
    if not h then Height := h1 + 90;
    h := True;
  end;
end;

