procedure TfmFactManual.transfClick(Sender: TObject);
var
  i: Integer; ok, sel_todos: Boolean;
begin
  StatusBar1.Panels[0].Text := 'Verificando ...!'; StatusBar1.Refresh;
  facturacion.ReiniciarProcesamientoCentral;
  //facturacion.ProcesarDatosCentrales(pertrab.Text);

  sel_todos := True;
  For i := 1 to N.RowCount do Begin
    if Length(Trim(N.cells[0, i])) = 0 then Break;
    if N.cells[2, i] <> 'S' then Begin
      sel_todos := False;
      Break;
    end;
  end;

  if sel_todos then Begin
    if not copia_estructu then facturacion.CopiarEstructuras(pertrab.Text) else
      facturacion.PrepararRegistrosTransferenciaFinalTodos(pertrab.Text);
    copia_estructu := True;

    if (facturacion.interbase = 'S') then begin
      StatusBar1.Panels[0].Text := 'Iniciando Proceso ...!'; StatusBar1.Refresh; 
      facturacion.PrepararRegistrosTransferenciaFinalTodos(pertrab.Text);
    end;
  end;

  For i := 1 to N.RowCount do Begin
    if Length(Trim(N.cells[0, i])) = 0 then Break;
    if N.cells[2, i] = 'S' then Begin
      if facturacion.verificarBloqueo then begin
        utiles.msgError('El Proceso No puede Realizarse ahora porque el Servidor está ocupado, ' + CHR(13) + 'vuelva a intentarlo mas tarde');
        exit;
      end else Begin
        N.Row := i; N.Refresh;
        StatusBar1.Panels[0].Text := N.cells[0, i] + '  ' +  N.cells[1, i]; StatusBar1.Refresh;
        //facturacion.Bloquear;
        if not sel_todos then facturacion.PrepararRegistrosTransferenciaFinal(pertrab.Text, N.cells[0, i]);
        facturacion.TransferenciaFinal(pertrab.Text, N.cells[0, i], N.cells[1, i]);
        //facturacion.QuitarBloqueo;
        StatusBar1.Panels[0].Text := ' '; ok := True;
      end;
    end;
  end;

  StatusBar1.Panels[0].Text := 'Guardando/Finalizando Transacción'; StatusBar1.Refresh;
  facturacion.CerrarTransferenciaFinal;

  CheckBox5Click(Sender);
  N.Row := 1;
  transf.Enabled := False;
  if ok then Begin
    Seleccion.Enabled := False; Todos.Enabled := False; Ninguno.Enabled := False; CheckBox5.Checked := False;
    if not unifPeriodos.Checked then
      if utiles.msgSiNo('Procesar Datos Centrales,', 'de todos los Laboratorios ?') then ActiveControl := general else
        facturacion.ReiniciarProcesamientoIndividual;
  end;
end;

procedure TfmFactManual.SeleccionClick(Sender: TObject);
begin
