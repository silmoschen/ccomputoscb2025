procedure TfmFactManual.btnProcesarUnifClick(Sender: TObject);
var
  l, lper: TStringList; i, j, m: Integer; pt: String;
begin
  // En primera Instancia Retransferimos todos los datos
  if utiles.msgSiNo('Este Proceso Unificará los Períodos Indicados, los Mismos Previamente deben haber sido' + chr(13) +
                    'Transferido a través del Proceso Transferencia Final de Datos en el Período Correspondiente' + chr(13) +
                    'Seguro para Proceder ?') then Begin

  Refresh;
  lper         := TStringList.Create;
  pertrab.Text := unifdesde.Text;
  For m := 1 to 500 do Begin
    StatusBar1.Panels[0].Text := 'Procesando Datos Per.: ' + pertrab.Text + ' ...!'; StatusBar1.Refresh;
    Label89.Caption := 'P.P.: ' + pertrab.text; label89.Refresh;
    lper.Add(pertrab.text);
    grid.IniciarGrilla(N); i := 0;
    l := facturacion.setDatosImportados(pertrab.Text);
    borrarMovLab.Enabled := False;
    for j := 1 to l.Count do Begin
      if facturacion.verificicarSiExisteLaboratorio(pertrab.Text, l.Strings[j-1]) then Begin
        profesional.getDatos(l.Strings[j-1]);
        if Length(Trim(profesional.codigo)) > 0 then Begin
          facturacion.getDatosImportados(pertrab.Text, profesional.codigo);
          Inc(i);
          N.cells[0, i] := profesional.codigo;
          N.cells[1, i] := profesional.nombre;
          N.cells[3, i] := facturacion.FechaHoraImport;
          N.cells[4, i] := facturacion.DirectorioImport;
          N.cells[5, i] := facturacion.UsuarioImport;
          if facturacion.ModoImport = 'I' then N.cells[6, i] := 'Importado' else N.cells[6, i] := 'Ing. Manual';
          N.cells[7, i] := facturacion.transfImport;
          if Not Seleccion.Enabled then Seleccion.Enabled := True;
          if Not Todos.Enabled then Todos.Enabled := True;
          if Not Ninguno.Enabled then Ninguno.Enabled := True;
          if Not borrarMovLab.Enabled then borrarMovLab.Enabled := True;
        end;
      end;
    end;
    l.Destroy;

    //TodosClick(Self);
    //transfClick(Self);

    pt := utiles.SumarPeriodo(pertrab.Text, '1');

    if (Copy(pt, 4, 4) + Copy(pt, 1, 2)) > (Copy(unifhasta.Text, 4, 4) + Copy(unifhasta.Text, 1, 2)) then Break;
    pertrab.Text := pt; pertrab.Refresh;
  end;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;

  // Ahora Relizamos Unificación

  unifperiodos.Checked := False;
  StatusBar1.Panels[0].Text := 'Realizando Integración ...!'; StatusBar1.Refresh;
  if lper.Count > 0 then Begin
    facturacion.UnificarPeriodosFacturados(lper);
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    if utiles.msgSiNo('Procesar Datos Unificados,', 'de todos los Períodos ?') then ActiveControl := unificado;
  end else
    individual.Checked := True;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;

  End;

  if individual.Checked then individual.SetFocus;
end;

procedure TfmFactManual.unificadoClick(Sender: TObject);
var
  l: TStringList;
  i: integer;
