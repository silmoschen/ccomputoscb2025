    fmEleObraSociales.CargarDatos(2);
    fmEleObraSociales.EleIndividual := True;
    fmEleObraSociales.ShowModal;
    os.Caption := fmEleObraSociales.F.Cells[0, fmEleObraSociales.F.Row];
    Refresh;
    {if (infEstMedicoCabecera.Checked) then Begin
      if Length(Trim(fmEleObraSociales.F.Cells[0, fmEleObraSociales.F.Row])) > 0 then Begin
        if not Assigned(fmEleMedicosCabecera) then Application.CreateForm(TfmEleMedicosCabecera, fmEleMedicosCabecera);
        fmEleMedicosCabecera.codos := fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row];
        fmEleMedicosCabecera.ShowModal;
        Refresh;
        fadesde.SetFocus;
      end
      else utiles.msgError('No hay Obra Social Seleccionada ...!');
    end else}
      fadesde.SetFocus;
  end;

  if (infautrechpac.Checked) then Begin
    if not Assigned(fmEleObraSociales) then Application.CreateForm(TfmEleObraSociales, fmEleObraSociales);
    fmEleObraSociales.CargarDatos(2);
    fmEleObraSociales.EleIndividual := True;
    fmEleObraSociales.ShowModal;
    os.Caption := fmEleObraSociales.F.Cells[0, fmEleObraSociales.F.Row];
    Refresh;
    if (infautrechpac.Checked) then Begin
      if Length(Trim(fmEleObraSociales.F.Cells[0, fmEleObraSociales.F.Row])) > 0 then Begin
        padron.conectar(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row]);
        Application.CreateForm(TfmListAfiliados, fmListAfiliados);
        fmListAfiliados.introSalir := True;
        fmListAfiliados.ShowModal;
        if fmListAfiliados.seleccionOK then
          nrodoc := padron.tabla.FieldByName('nrodoc').AsString;
        fmListAfiliados.Release; fmListAfiliados := Nil;
        Refresh;
        fadesde.SetFocus;
      end
      else utiles.msgError('No hay Obra Social Seleccionada ...!');
    end else
      fadesde.SetFocus;
  end;
end;

