<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BEWsValidaAfiSoapBinding">
                    <security mode="Transport" />
                </binding>
                <binding name="BEWsValidaAfiSoapBinding1" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://aswe.santafe.gov.ar/proxy.php/iapos/afiliados"
                binding="basicHttpBinding" bindingConfiguration="BEWsValidaAfiSoapBinding"
                contract="IAPOS.BEWsValidaAfiSoapPort" name="BEWsValidaAfiSoapPort" />
        </client>
    </system.serviceModel>
</configuration>