procedure TfmFactManual.listarClick(Sender: TObject);
var
  i, j: Integer; salida: char;
begin
  StatusBar1.Panels[0].Text := 'Procesando Datos a Facturar ...!'; StatusBar1.Refresh;
  if (length(trim(ncopias.Caption)) = 0) then ncopias.Caption := '1';

  if CheckBox2.Visible then Begin   // Excluir Laboratorios Inscriptos en I.V.A.
    facturacion.SC         := True;
    facturacion.ExcluirLab := CheckBox2.Checked;
  end;

  administNum.getDatosNF(administNum.Ncodnumer);
  salida := 'P';
  if Length(Trim(periodo.Text)) = 7 then Begin
    if Dispositivo.Impresor.Checked then
      if (administNum.NimpRapida = 1) then salida := 'T' else salida := 'I';

  end;

  if (exporta_afip) then salida := 'P';
  facturacion.exporta_afip := exporta_afip;

  if salida <> 'P' then
    if utiles.msgSiNo('Prepare el Formulario y Verifique la Impresora,' + chr(13) + 'y Oprima Intro para Iniciar Proceso.') then Begin

      Refresh;
      facturacion.LineasPag     := StrToInt(Trim(altoFact.Text));
      facturacion.lineas_blanco := StrToInt(Trim(lineassepfact.Text));
      if (salida = 'I') then nimpresora.Caption := inttostr(administNum.Nimpresora);
      if (length(trim(nimpresora.Caption)) = 0) then nimpresora.Caption := '0';
      facturacion.IniciarFacturacion(salida, strtoint(nimpresora.Caption));

      facturacion.periodo := Copy(fecha.Text, 1, 2) + '/' + Copy(utiles.sExprFecha2000(fecha.Text), 1, 4);
      For i := 1 to fmEleObraSocialesAgrupadas.F.RowCount do
        if fmEleObraSocialesAgrupadas.F.cells[2, i] = 'S' then Begin
          StatusBar1.Panels[0].Text := 'Fact.: ' + fmEleObraSocialesAgrupadas.F.cells[1, i] + '  ' + fmEleObraSocialesAgrupadas.F.cells[0, i]; StatusBar1.Refresh;
          administNum.getDatosNF(fmEleccionFactura.codnumer.Caption);  // Nro. siguiente
          sucursal.Caption := administNum.NFExpendio;
          numero.Caption   := utiles.sLlenarIzquierda(administNum.getNroSiguienteNF(fmEleccionFactura.codnumer.Caption), 8, '0');
          sucursal.Refresh; numero.Refresh;

          if not factblanco.Checked then Begin    // Impresión sobre Formularios Preimpresos
            for j := 1 to strtoint(ncopias.caption) do begin
              if facturacion.FacturarObraSociales(periodofact.Text, fmEleObraSocialesAgrupadas.F.cells[1, i], fecha.Text, fechavto.Text, fechavto1.Text, fechavto2.Text, observaciones.Text, tc.Caption, tipo.Caption, sucursal.Caption, numero.Caption, StrToFloat(porc1.Text), StrToFloat(porc2.Text), salida, fmEleObraSocialesAgrupadas.F.cells[3, i]) then
                if salida <> 'P' then
                  if (j = 1) then administNum.ActNuemeroActualNF(numero.Caption);
            end;
          end;

          if factblanco.Checked then Begin    // Impresión sobre Formularios en Blanco
            if facturacion.FacturarObraSocialesFormBlanco(periodofact.Text, fmEleObraSocialesAgrupadas.F.cells[1, i], fecha.Text, fechavto.Text, fechavto1.Text, fechavto2.Text, observaciones.Text, tc.Caption, tipo.Caption, sucursal.Caption, numero.Caption, StrToFloat(porc1.Text), StrToFloat(porc2.Text), salida,
                                                          titulo.Text, direccion.Text, localidad.Text, telefono.Text, nrocuit.Text, suss.Text, ibrutos.Text, iva.Text) then
                                                            if salida <> 'P' then administNum.ActNuemeroActualNF(numero.Caption);
          end;

          StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
        end;

      facturacion.ListarFacturacion(salida);
    end;

  if salida = 'P' then Begin
    For i := 1 to fmEleObraSocialesAgrupadas.F.RowCount do
      if fmEleObraSocialesAgrupadas.F.cells[2, i] = 'S' then Begin
        StatusBar1.Panels[0].Text := 'Fact.: ' + fmEleObraSocialesAgrupadas.F.cells[1, i] + '  ' + fmEleObraSocialesAgrupadas.F.cells[0, i]; StatusBar1.Refresh;
        administNum.getDatosNF(fmEleccionFactura.codnumer.Caption);  // Nro. siguiente
        sucursal.Caption := administNum.NFExpendio;
        numero.Caption   := utiles.sLlenarIzquierda(administNum.getNroSiguienteNF(fmEleccionFactura.codnumer.Caption), 8, '0');
        sucursal.Refresh; numero.Refresh;

        if not factblanco.Checked then Begin    // Impresión sobre Formularios Preimpresos
          for j := 1 to strtoint(ncopias.caption) do begin
            if facturacion.FacturarObraSociales(periodofact.Text, fmEleObraSocialesAgrupadas.F.cells[1, i], fecha.Text, fechavto.Text, fechavto1.Text, fechavto2.Text, observaciones.Text, tc.Caption, tipo.Caption, sucursal.Caption, numero.Caption, StrToFloat(porc1.Text), StrToFloat(porc2.Text), salida, fmEleObraSocialesAgrupadas.F.cells[3, i]) then
                if salida <> 'P' then
                  if (j = 1) then administNum.ActNuemeroActualNF(numero.Caption);
          end;
        end;

        if factblanco.Checked then Begin    // Impresión sobre Formularios en Blanco
          if facturacion.FacturarObraSocialesFormBlanco(periodofact.Text, fmEleObraSocialesAgrupadas.F.cells[1, i], fecha.Text, fechavto.Text, fechavto1.Text, fechavto2.Text, observaciones.Text, tc.Caption, tipo.Caption, sucursal.Caption, numero.Caption, StrToFloat(porc1.Text), StrToFloat(porc2.Text), salida,
                                                        titulo.Text, direccion.Text, localidad.Text, telefono.Text, nrocuit.Text, suss.Text, ibrutos.Text, iva.Text) then
                                                          if salida <> 'P' then administNum.ActNuemeroActualNF(numero.Caption);
        end;

        StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
      end;

    if (exporta_afip) then salida := 'A';

    facturacion.ListarFacturacion(salida);
  end;

  Panel15.Enabled := False;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  ActiveControl   := ob;
end;

