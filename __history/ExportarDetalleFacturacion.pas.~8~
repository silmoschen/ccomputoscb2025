unit ExportarDetalleFacturacion;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ExtCtrls, ComCtrls, CFTP, IdAntiFreezeBase, IdAntiFreeze,
  IdComponent, IdTCPConnection, IdTCPClient, IdExplicitTLSClientServerBase,
  IdFTP, IdBaseComponent, IdIntercept, IdLogBase, IdLogDebug, IdFTPCommon, CUtiles,
  CUtilidadesArchivos, CBDT, Contnrs,
  CFacturacionCCB, Mask;

type
  TfmExportarDetalleFacturacion = class(TForm)
    StatusBar1: TStatusBar;
    Panel1: TPanel;
    Label1: TLabel;
    modulo: TLabel;
    btnIniciar: TButton;
    btnCerrar: TButton;
    periodo: TMaskEdit;
    IdLogDebug1: TIdLogDebug;
    IdFTP1: TIdFTP;
    procedure periodoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure btnIniciarClick(Sender: TObject);
    procedure btnCerrarClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
    con: Cardinal;
    AbortTransfer, TransferrignData: Boolean;
    BytesToTransfer: LongWord;
    STime: TDateTime;
    function  procesarUrl(url: string): TStringList;
    procedure conectarFTP;
    procedure desconectarFTP;
    procedure ChageDir(DirName: String);
  public
    { Public declarations }
    exportok: boolean;
  end;

var
  fmExportarDetalleFacturacion: TfmExportarDetalleFacturacion;

implementation

uses HTTPCliente, uploadftp;

{$R *.dfm}

function TfmExportarDetalleFacturacion.procesarUrl(url: string): TStringList;
var
  l: TStringList;
  i: integer;
begin
  fmClientHTML.Edit1.text := url;
  fmClientHTML.btnDispararClick(self);
  l := TStringList.Create;
  for i := 1 to fmClientHTML.memoHTML.Lines.Count do
    l.Add(fmClientHTML.memoHTML.Lines[i-1]);
  result := l;
end;

procedure TfmExportarDetalleFacturacion.conectarFTP;
begin
  if IdFTP1.Connected then try
    if TransferrignData then IdFTP1.Abort;
    IdFTP1.Quit;
    finally
  end else with IdFTP1 do try
    {$IFDEF VER140}
    User := usuario.Text;
    {$ENDIF}
    {$IFDEF VER185}
    UserName := ftp.usuario;
    {$ENDIF}
    Password := ftp.pass;
    Host     := ftp.ftp;
    Connect;
    //Self.ChageDir('');  11/12/2013 - actualizado
  finally
  end;
end;

procedure TfmExportarDetalleFacturacion.ChageDir(DirName: String);
begin
  try
    IdFTP1.ChangeDir(DirName);
    {$IFDEF VER140}
    IdFTP1.TransferType := ftASCII;
    {$ENDIF}
    {$IFDEF VER185}
    IdFTP1.TransferType := ftASCII;
    {$ENDIF}
  finally
  end;
end;

procedure TfmExportarDetalleFacturacion.DesconectarFTP;
begin
  if IdFTP1.Connected then try
    IdFTP1.Disconnect;
    finally
  end
end;

procedure TfmExportarDetalleFacturacion.btnCerrarClick(Sender: TObject);
begin
  Release; fmExportarDetalleFacturacion := nil;
  Close;
end;

procedure TfmExportarDetalleFacturacion.btnIniciarClick(Sender: TObject);
var
  l: TStringlist;
  i: integer;
  id, reporte, tipo, iduser, archivo, arch: string;
  c: boolean;
  x: textfile;
begin
  if not (utiles.msgSiNo('Seguro para Iniciar Exportación de Facturación ?')) then exit;

  StatusBar1.Panels[0].Text := 'Exportando Datos ...!'; StatusBar1.Refresh;
  facturacion.conectar;
  facturacion.exportarDetalleFacturacion(periodo.Text);
  facturacion.desconectar;

  arch := '\temp\detalle_fact' + StringReplace(periodo.text, '/', '_', [rfReplaceAll, rfIgnoreCase]) + '.json';


  if (utiles.msgSiNo('Esta Opción Transferirá los Archivos Procesados a un Servidor Remoto.' + chr(13) + 'Seguro para Proceder ?')) then begin
    Refresh;
    c := false;

    ftp.conectar;
    ftp.getDatos(2);   // facturación

    if (ftp.__error <> '') then begin
      utiles.msgError(ftp.__error);
      btnIniciar.Enabled := false;
      exit;
    end;

    conectarFTP;
    if IdFTP1.Connected then begin
      StatusBar1.Panels[0].Text := 'Transfiriendo Datos ...!'; StatusBar1.refresh;
      IdFTP1.TransferType := ftBinary;
      archivo := dbs.DirSistema + arch;
      IdFTP1.Put(archivo, ExtractFileName(archivo));

      // Transferimos los archivos
      l := utilesarchivos.setListaArchivos(archivo, '*.json');
      for i := 1 to l.Count do Begin
        StatusBar1.Panels[0].Text := 'Transfiriendo ' + ExtractFileName(l.Strings[i-1]) +  ' ...!'; StatusBar1.Refresh;
        IdFTP1.Put(l.Strings[i-1], ExtractFileName(l.Strings[i-1]));
        exportok := true;
      End;
    end;

    ChageDir(idftp1.RetrieveCurrentDir);
    desconectarFTP;

    StatusBar1.Panels[0].Text := 'Actualizando Detalle Facturación ...!'; StatusBar1.Refresh;
    procesarUrl(ftp.host + '/api/facturaciondetalle/sincro/' + StringReplace(periodo.text, '/', '_', [rfReplaceAll, rfIgnoreCase]));

    btnCerrar.SetFocus;

    StatusBar1.Panels[0].Text := 'Trabajo Terminado';
    Refresh;

    Close;
  end;

end;

procedure TfmExportarDetalleFacturacion.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  fmClientHTML.Release; fmClientHTML := nil;
  //Release; fmExportarDetalleFacturacion := nil;
end;

procedure TfmExportarDetalleFacturacion.FormShow(Sender: TObject);
begin
  periodo.Text := utiles.setPeriodoActual;
  periodo.SetFocus;

  Application.CreateForm(TfmClientHTML, fmClientHTML);
  fmClientHTML.FormActivate(self);
end;

procedure TfmExportarDetalleFacturacion.periodoKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_ESCAPE then Close;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then Begin
      if utiles.verificarPeriodo(periodo.Text) then Begin
        btnIniciar.SetFocus;
      End;
  End;

end;

end.
