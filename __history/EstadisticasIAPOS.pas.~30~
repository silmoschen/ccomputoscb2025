  uref.desconectar;
  uref.Destroy; uref := nil;
  configform.Guardar(fmEstadisticasIAPOS, redim);
  Release; fmEstadisticasIAPOS := Nil;
end;

procedure TfmEstadisticasIAPOS.FormShow(Sender: TObject);
begin
  uref := TTUBReferente.Create;
  uref.conectar;
  if not configform.Setear(fmEstadisticasIAPOS) then begin
    width := 486; height := 338; top := 25;
  end;
  S.Cells[0, 0] := 'Período'; S.Cells[1, 0] := 'Unidad de Referencia';
  E.Cells[0, 0] := 'Período'; E.Cells[1, 0] := 'Obra Social'; E.Cells[2, 0] := 'Tot. Un. NBU'; E.Cells[3, 0] := 'Total Análisis';
  R.Cells[0, 0] := 'Id.Prof.'; R.Cells[1, 0] := 'Nombre del Profesional'; R.Cells[2, 0] := 'Tot.Fact.'; R.Cells[3, 0] := 'Tot.Pagado';
  R.Cells[4, 0] := 'F. Pago'; R.Cells[5, 0] := 'Débitos';
  profesional.conectar;
  periodo1.setFocus;
  salida := 'P';
  redim := false;
end;

