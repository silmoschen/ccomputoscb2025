procedure TfmEstadisticas.RadioButton4Click(Sender: TObject);
begin
  profobsoc.Caption := '&Obra Social'; RadioButton1.Checked := False; RadioButton2.Checked := False; RadioButton3.Checked := False; profobsoc.Enabled := True; practicasFact.Checked := False;
end;

procedure TfmEstadisticas.profobsocClick(Sender: TObject);
begin
  id.Caption := ''; des.Caption := '';
  if practicasFact.Checked then Begin
    obsocial.conectar;
    fmEleObraSociales.CargarDatos(1);
    fmEleObraSociales.ShowModal;
    obsocial.desconectar;
  end else
  if profobsoc.Caption = '&Obra Social' then Begin
    obsocial.conectar;
    Application.CreateForm(TfmListObrasSociales, fmListObrasSociales);
    fmListObrasSociales.introSalir := True;
    fmListObrasSociales.ShowModal;
    if fmListObrasSociales.seleccionOK then Begin
       id.Caption  := obsocial.tabla.FieldByName('codos').AsString;
       des.Caption := Copy(obsocial.tabla.FieldByName('nombre').AsString, 1, 35);
       ActiveControl := dispSalida;
    end;
    fmListObrasSociales.Release; fmListObrasSociales := nil;
    obsocial.desconectar;
  end;
  if profobsoc.Caption = '&Profesionales' then Begin
    profesional.conectar;
    Application.CreateForm(TfmEleProfesional, fmEleProfesional);
    fmEleProfesional.CargarDatos;
    fmEleProfesional.ShowModal;
    lista         := fmEleProfesional.lista;
    Refresh;
    Application.CreateForm(TfmListObrasSociales, fmListObrasSociales);
    obsocial.conectar;
    fmEleObraSociales.CargarDatos(1);
    fmEleObraSociales.ShowModal;
    listaos := fmEleObraSociales.lista;
    obsocial.desconectar;
    fmListObrasSociales.Release; fmListObrasSociales := nil;
    ActiveControl := dispSalida;
    fmEleProfesional.Release; fmEleProfesional := nil;
    profesional.desconectar;
  end;
  dispSalida.SetFocus;
end;

