      '''' + copy(fila, 8, 5) + '''' + ', ' +
      '''' + 'N' + '''' + ');');

		end;

    for i := 1 to csv.Count -2 do
		begin
			fila := csv.Strings[i];

      writeln(salida, 'update medicos set estado = ' + '''' + 'N' + '''' + ' where codos = ' + '''' + codos.Text + '''' + ' and idprof = ' + '''' + copy(fila, 1, 2) + copy(fila, 4, 3) + copy(fila, 8, 5) + '''' + ';');

