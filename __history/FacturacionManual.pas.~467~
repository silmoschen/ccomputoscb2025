procedure TfmFactManual.BuscarProfClick(Sender: TObject);
begin
  Application.CreateForm(TfmListProfesionalesLiq, fmListProfesionalesLiq);
  fmListProfesionalesLiq.introSalir := True;
  fmListProfesionalesLiq.on2        := True;
  if (factglobal.Caption = 'S') then fmListProfesionalesLiq.__global := true;
  fmListProfesionalesLiq.ShowModal;

  Refresh;
  if fmListProfesionalesLiq.seleccionOK then Begin
    if PageControl1.ActivePage = TabSheet1 then Begin
      idprof.Text := profesional.tperso.FieldByName('idprof').AsString; Refresh;
      if Length(Trim(idprof.Text)) > 0 then Begin
        ActiveControl := codos;
        DatosProfesional;
        CheckBox1.Checked := False;
      end else utiles.msgError('Debe proporcionar la Indentificación del Laboratorio ...!');
    end;
    if PageControl1.ActivePage = TabSheet2 then Begin
      idlab.Text  := profesional.tperso.FieldByName('idprof').AsString;
      profesional.getDatos(idlab.Text);
      if individual.Checked then idprof.Text := idlab.Text;
      Refresh;
      DatosProfesional;
      ActiveControl := dispSalida;
    end;
    if PageControl1.ActivePage = TabSheet8 then Begin
      idprofaudit.Text  := profesional.tperso.FieldByName('idprof').AsString;
      Refresh;
      DatosProfesionalAudit;
      ordenaudit.SetFocus;
    end;
  end else Begin
    if PageControl1.ActivePage = TabSheet1 then idprof.SetFocus;
    if PageControl1.ActivePage = TabSheet2 then idlab.SetFocus;
    if PageControl1.ActivePage = TabSheet8 then idprofaudit.SetFocus;
  end;
  fmListProfesionalesLiq.Release; fmListProfesionalesLiq := nil;

  if (factglobal.Caption = 'S') then profesional.FiltrarLaboratoriosFacturacionGlobal else profesional.FiltrarLaboratoriosActivos;
end;

