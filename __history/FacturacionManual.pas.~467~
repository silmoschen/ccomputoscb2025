      end;
      if profesional.Buscar(idprof_audit.Text) then Begin
        if factBarras.Checked then ok := True else
          if utiles.msgSiNo('El Nro. de Auditoria ' + nroauditoria.Text + ' es Correcto,' + chr(13) + 'Desea Facturarlo en el Laboratorio:' + chr(13) + idprof_audit.Text + ' - ' + l.Caption + '  ?') then ok := True;
