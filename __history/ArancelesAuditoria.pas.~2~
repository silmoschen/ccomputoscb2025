procedure TfmArancelesDiferenciales.CargarDatosObraSocial;
Begin
  obsocial.getDatos(codos.Text);
  nos.Caption := obsocial.Nombre;
  CargarAranceles;
  periodo.SetFocus;
end;

procedure TfmArancelesDiferenciales.RegistrarItems;
Begin
  if (obsocial.Buscar(codos.Text)) and (utiles.verificarPeriodo(periodo.Text)) and (utiles.Sionoct(aplicar.Text, 'SN', '')) and (Length(Trim(ub.Text)) > 0) and (Length(Trim(ug.Text)) > 0) and (Length(Trim(rieub.Text)) > 0) and (Length(Trim(rieug.Text)) > 0) then Begin
    auditoriacb.RegistrarArancelDiferencial(codos.Text, periodo.Text, aplicar.Text, StrToFloat(ub.Text), StrToFloat(ug.Text), StrToFloat(rieub.Text), StrToFloat(rieug.Text), StrToFloat(porcentaje.Text));
    CargarAranceles;
    periodo.Text := ''; aplicar.Text := ''; ub.Text := ''; ug.Text := ''; rieub.Text := ''; rieug.Text := '';
    codos.SetFocus;
  end else
    utiles.msgError('Controle, hay Datos Incorrectos ...!');
end;

procedure TfmArancelesDiferenciales.CargarAranceles;
var
  l: TStringList;
  i: Integer;
  j: array[1..5] of byte;
begin
  grid.IniciarGrilla(AR);
  i := 0;
  l := auditoriacb.setArancelDiferencial(codos.Text);
  For i := 1 to l.Count do Begin
    j[1] := Pos(';1', l.Strings[i-1]);
    j[2] := Pos(';2', l.Strings[i-1]);
    j[3] := Pos(';3', l.Strings[i-1]);
    j[4] := Pos(';4', l.Strings[i-1]);
    j[5] := Pos(';5', l.Strings[i-1]);
    AR.Cells[0, i] := Copy(l.Strings[i-1], 1, 7);
    AR.Cells[1, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[1]+2, (j[2]-j[1]) - 2));
    AR.Cells[2, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[2]+2, (j[3]-j[2]) - 2));
    AR.Cells[3, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[3]+2, (j[4]-j[3]) - 2));
    AR.Cells[4, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[4]+2, (j[5]-j[4]) - 2));
    AR.Cells[5, i] := Copy(l.Strings[i-1], j[5]+2, 1);
    AR.Cells[6, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], j[5]+3, 15));
    AR.Row := i;
  end;
end;

procedure TfmArancelesDiferenciales.CargarDeterminacionesMontoFijo;
// Objetivo...: Cargamos los análisis con montos fijos
var
  r: TQuery;
  i, j: integer;
begin
  For i := 1 to A.RowCount do
    For j := 1 to A.ColCount do A.cells[j-1, i] := '';

  if obsocial.factnbu <> 'S' then Begin
    r := auditoriacb.setAnalisisMontoFijo(codos.Text);
    r.Open; r.First; i := 0;
    while not r.EOF do Begin
      Inc(i);
      nomeclatura.getDatos(r.FieldByName('codanalisis').AsString);
      A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
      A.cells[1, i] := r.FieldByName('codanalisis').AsString;
      A.cells[2, i] := nomeclatura.descrip;
      A.cells[3, i] := utiles.FormatearNumero(r.FieldByName('importe').AsString);
      A.Cells[4, i] := r.FieldByName('periodo').AsString;
      A.Cells[5, i] := r.FieldByName('perhasta').AsString;
      r.Next;
    end;
    r.Close; r.Free;
    it := i;
    if i = 0 then A.Row := 1 else A.row := it;
  end;

  if obsocial.factnbu = 'S' then Begin
    r := obsocial.setAnalisisMontoFijoNBU(codos.Text);
    r.Open; r.First; i := 0;
    while not r.EOF do Begin
      Inc(i);
      nbu.getDatos(r.FieldByName('codanalisis').AsString);
      A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0'); //r.FieldByName('items').AsString;
      A.cells[1, i] := r.FieldByName('codanalisis').AsString;
      A.cells[2, i] := nbu.Descrip;
      A.cells[3, i] := utiles.FormatearNumero(r.FieldByName('importe').AsString);
      A.Cells[4, i] := r.FieldByName('periodo').AsString;
      A.Cells[5, i] := r.FieldByName('perhasta').AsString;
      r.Next;
    end;
    r.Close; r.Free;
    it := i;
    if i = 0 then A.Row := 1 else A.row := it;
  end;
end;

procedure TfmArancelesDiferenciales.CargarDatosAnalisis;
begin
  if obsocial.factnbu <> 'S' then Begin
    nomeclatura.getDatos(codanalisis.Text);
    des.Caption := nomeclatura.descrip;
  end;
  if obsocial.factnbu = 'S' then Begin
    nbu.getDatos(codanalisis.Text);
    des.Caption := nbu.descrip;
  end;
end;

procedure TfmArancelesDiferenciales.CargarGrilla;
var
  i, l, j: integer;
begin
  modifica := BuscarAnalisis(codanalisis.Text);

  For j := 1 to A.RowCount do Begin
    it := j;
    if Length(Trim(A.Cells[0, j])) = 0 then Break;
  end;

  if not modifica then i := it else i := A.row;

  l := obtenerlinea(codanalisis.Text, periodoaf.Text);  // Buscamos la Ranura para Mantener el orden con los códigos
  if l > 0 then Begin
    if not modifica then Begin
      if l > 1 then l := l + 1;
      A.Row := l;
      grid.InsertarLinea(A, 3);
      i := l;
    end;

    if modifica then Begin
      A.Row := l;
      i     := l;
    end;
  end;

  A.cells[0, i] := utiles.sLlenarIzquierda(IntToStr(i), 3, '0');
  A.cells[1, i] := codanalisis.Text;
  A.cells[2, i] := des.Caption;
  A.cells[3, i] := importe.Text;
  if Length(Trim(periodoaf.Text)) = 7 then A.cells[4, i] := periodoaf.Text else A.Cells[4, i] := '';
  if Length(Trim(periodohasta.Text)) = 7 then A.cells[5, i] := periodohasta.Text else A.Cells[5, i] := '';
  modifica := False;
  A.row    := i;
end;

function  TfmArancelesDiferenciales.BuscarAnalisis(xcodanalisis: string): boolean;
var
  i: integer;
begin
  Result := False;
  For i := 1 to A.RowCount do
    if A.cells[0, i] = xcodanalisis then Begin
      Result := True;
      Break;
    end;
end;

function  TfmArancelesDiferenciales.ObtenerLinea(xcodanalisis, xperiodo: String): Integer;
// Objetivo...: Determinar Ranura
var
  i, j, k: Integer;
Begin
  j := 0; k := 0;
  For i := 1 to A.RowCount do Begin
    if Length(Trim(A.Cells[0, i])) = 0 then Break;
    if Trim(A.Cells[1, i]) = Trim(xcodanalisis) then Begin
      if Length(Trim(xperiodo)) = 7 then k := i;

      if Copy(A.Cells[4, i], 4, 4) + Copy(A.Cells[4, i], 1, 2) = Copy(xperiodo, 4, 4) + Copy(xperiodo, 1, 2) then Begin
        j := i;
        modifica := True;
        Break;
      end;

      if Copy(A.Cells[4, i], 4, 4) + Copy(A.Cells[4, i], 1, 2)  > Copy(xperiodo, 4, 4) + Copy(xperiodo, 1, 2) then Begin
        if i > 0 then j := i-1;
        Break;
      end;
    end;
  end;

  if j > 0 then  Result := j else Result := k;
end;

procedure TfmArancelesDiferenciales.ActualizarAnalisisMontoFijo;
// Objetivo...: Actualizar análisis con monto fijo
var
  i, j: integer;
begin
  For i := 1 to A.RowCount do Begin
    if Length(Trim(A.cells[0, i])) = 0 then Break;
    j := i;
  end;

  For i := 1 to A.RowCount do Begin
    if Length(Trim(A.cells[0, i])) = 0 then Break;
    if obsocial.Factnbu <> 'S' then auditoriacb.GrabarAnalisisMontoFijo(codos.Text, A.cells[0, i], A.cells[1, i], A.cells[4, i], A.cells[5, i], StrToFloat(A.cells[3, i]), j);
  end;
end;


