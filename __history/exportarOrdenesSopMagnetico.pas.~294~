procedure TfmExportarOrdenesSoporteMagnetico.numeroKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if (Key = VK_RETURN) then begin
    if (length(trim(numero.Text)) > 0) then begin
      numero.Text := utiles.sLlenarIzquierda(numero.Text, 8, '0');
      fecha.SetFocus;
    end;
  end;
end;

procedure TfmExportarOrdenesSoporteMagnetico.periodoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if (Key = VK_RETURN) then begin
    if (utiles.verificarPeriodo(periodo.Text)) then begin
      listaOs.SetFocus;
      cargarObrasSociales;
    end;
  end;
end;

procedure TfmExportarOrdenesSoporteMagnetico.reglasExportChange(
  Sender: TObject);
begin
  reglaNumero.ItemIndex := reglasExport.ItemIndex;
end;

procedure TfmExportarOrdenesSoporteMagnetico.sucursalKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if (Key = VK_RETURN) then begin
    if (length(trim(sucursal.Text)) > 0) then begin
      sucursal.Text := utiles.sLlenarIzquierda(sucursal.Text, 4, '0');
      numero.SetFocus;
    end;
  end;
end;

procedure TfmExportarOrdenesSoporteMagnetico.tipoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if (Key = VK_RETURN) then begin
    if (length(trim(tipo.Text)) > 0) then begin
      sucursal.SetFocus;
    end;
  end;

end;

