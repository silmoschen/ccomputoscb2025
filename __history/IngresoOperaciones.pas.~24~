procedure TfmIngreso.GuardarClick(Sender: TObject);
var
  i, j, it, h, ultimoItems, ultlist: Integer; total: Real;
begin

  StatusBar1.Panels[0].Text := 'Registrando Operaciones ...!'; StatusBar1.Refresh;
  if tipomov = 'Ajustes Individuales' then Begin    // Debitos y Creditos Personales
    it := CantidadDeItemsIngresados(A);
    For i := 1 to A.RowCount do Begin
      if Length(Trim(A.Cells[0, i])) = 0 then Break;
      For j := 1 to A.ColCount do Begin
        if Length(Trim(A.Cells[j, i])) = 0 then A.Cells[j, i] := '0';
        //if StrToFloat(A.Cells[j, i]) <> 0 then
          distribucionos.GuardarAjustesIndividuales(periodo.Caption, codos.Caption, Id.Cells[j, 0], utiles.sLlenarIzquierda(IntToStr(i), 3, '0'), A.Cells[0, i], fecha.Caption, 'S', perLiq.Caption, nrodist.Caption, StrToFloat(Trim(A.Cells[j, i])), it);
      end;
    end;

    distribucionos.FinalizarTransaccion;

    distribucionos.AjustarNumeroDeItems(periodo.Caption, codos.Caption, nrodist.Caption, i);

    // Actualizamos el total de Retenciones del Profesional
    total := 0;
    For i := 1 to A.ColCount do Begin
      For j := 1 to A.RowCount do Begin
        if Length(Trim(A.Cells[i, j])) = 0 then Break;
        total := total + StrToFloat(A.Cells[i, j]);
      end;
      if total <> 0 then facturacion.RegistrarNetoACobrarProfesional(periodo.Caption, Id.Cells[i, 0], codos.Caption, total);
      total := 0;
    end;
  end;

  if tipomov = 'Débitos y Créditos Personales' then Begin   // Debitos y Creditos Personales
    distribucionos.BorrarDCProfFijos(perliq.Caption, nrodist.Caption);                        // Reajuste
    it := CantidadDeItemsIngresados(D);                      // Ajustes Fijos
    For i := 1 to D.RowCount do Begin
      if Length(Trim(D.Cells[0, i])) = 0 then Break;
      For j := 1 to D.ColCount do Begin
        if Length(Trim(D.Cells[j, i])) = 0 then D.Cells[j, i] := '0';
        if Length(Trim(Ir.Cells[j, 0])) > 0 then distribucionos.GuardarDCProf(perLiq.Caption, nrodist.Caption, Ir.Cells[j, 0], utiles.sLlenarIzquierda(IntToStr(i), 3, '0'), Ir.Cells[0, i], D.Cells[0, i] , StrToFloat(Trim(D.Cells[j, i])), it, 'F');
      end;
    end;
  end;
  ultimoItems := i;

  distribucionos.FinalizarTransaccion;

  if (__c = false) then exit else begin

    if tipomov = 'Débitos y Créditos Personales' then Begin    // Debitos y Creditos Personales
      distribucionos.BorrarDCProfManuales(perliq.Caption, nrodist.Caption);  // Reajuste
      it := it + CantidadDeItemsIngresados(M);                 // Ajustes Manuales
      For i := 1 to M.RowCount do Begin
        if Length(Trim(M.Cells[0, i])) = 0 then Break;
        Inc(ultimoItems);
        For j := 1 to M.ColCount do Begin
          if Length(Trim(M.Cells[j, i])) = 0 then M.Cells[j, i] := '0';
          if Length(Trim(Ir.Cells[j, 0])) > 0 then distribucionos.GuardarDCProf(perLiq.Caption, nrodist.Caption, Ir.Cells[j, 0], utiles.sLlenarIzquierda(IntToStr(ultimoItems), 3, '0'), Ir.Cells[0, i], M.Cells[0, i] , StrToFloat(Trim(M.Cells[j, i])), it, 'M');
        end;
      end;
    end;

    distribucionos.FinalizarTransaccion;

  end;

  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

