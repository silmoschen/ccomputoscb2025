procedure TfmFactManual.IntegrarDatosAuditoria;
// Objetivo...: Integrar con los datos de la Auditoria
var
  r: TObjectList;
  objeto: TTAuditoriaCCB;
  i, j: Integer;
  f, modif: Boolean;
  retiva, perorden: string;
Begin
  auditoriacb.getDatos(nroauditoria.Text);

  if PageControl1.ActivePage = TabSheet1 then Begin
    if Length(Trim(auditoriacb.IdFact)) = 0 then f := True else
      if utiles.msgSiNo('La Orden ' + nroauditoria.Text + ' ya está Facturada,' + chr(13) + 'Realizar Nuevamente la Operación ?') then Begin
        f       := True;
        modif   := True;
      end;
    if (Copy(utiles.sExprFecha2000(auditoriacb.Fecha), 1, 4) + Copy(utiles.sExprFecha2000(auditoriacb.Fecha), 5, 2)) > (Copy(periodo.Text, 4, 4) + Copy(periodo.Text, 1, 2)) then Begin
      utiles.msgError('La Fecha de la Orden es Posterior al Período de Facturación, Orden Rechazada ...!');
      f := True;
    end;
  end else Begin           // Facturando desde Importación
    f := True;
    if Length(Trim(auditoriacb.IdFact)) > 0 then Begin
      modif   := True;
      id_int.Caption := id.Text; id_int.Refresh;
    end;
  end;

  if f then Begin
    codos.Text     := auditoriacb.Codos;
    nrodoc.Caption := auditoriacb.Nrodoc;
    if codos.Text <> codosanter then Begin
      obsocial.getDatos(codos.Text);
      os.Caption     := obsocial.Nombre;
      //padron.desconectar;
      //padron.conectar(codos.Text);
      codosanter := codos.Text;
    end;
    padron.getDatos(codos.Text, Nrodoc.Caption);
    pac.Caption    := padron.Nombre;
    nrodoc.Caption := auditoriacb.Nrodoc;
    retiva := padron.Retiva;
    gravadoiva.Caption := padron.Retiva;

    if not factOrden.Checked then WriteLn(archivo, auditoriacb.Nroauditoria + '    ' + pac.Caption);

    if Length(Trim(nrodoc.Caption)) > 0 then Begin
      if not paciente.BuscarPorNroDocumento(idprofaudit.Text, nrodoc.Caption) then Begin

        codpac.Text := utiles.sLlenarIzquierda(paciente.Nuevo(idprof.Text), 4, '0');
        if pac.Caption <> '*** INEXISTENTE ***' then
          paciente.Grabar(idprof.Text, codpac.Text, pac.Caption, nrodoc.Caption, retiva)
        else begin
          codpac.Text := '0000';
          utiles.msgError(retiva + ' ' + codpac.Text);
        end;
      end else Begin
        Randomize;
        //utiles.msgError(codpac.Text + '  ' + pac.Caption + '   ' + nrodoc.Caption);

        // Anulado 12/12/2914
        //pac.Caption    := paciente.Nombre;
        nrodoc.Caption := auditoriacb.Nrodoc;
        codpac.Text := '-' + Trim(IntToStr(Random(999)));     // Generamos un Id. si no tiene nro. de documento

        //utiles.msgError(codpac.Text + '  ' + pac.Caption + '   ' + nrodoc.Caption);
      end;
    end;

    { Cargamos las determinaciones }
    r := auditoriacb.setItemsHistorial(nroauditoria.Text, False);
    i := 0; j := 0; id_f := '';
    for i := 1 to r.Count do Begin
      objeto := TTAuditoriaCCB(r.Items[i-1]);
      if objeto.Estado = 'A' then Begin
        if j = 0 then Begin
          if detalleOS.Caption = '&Facturar Ordenes Auditoria' then id.Text := utiles.sLlenarIzquierda(IntToStr(StrToInt(id.Text) + 1), 4, '0');
          id_f    := id.Text;
        end;
        Inc(j);
        A.Cells[0, j] := utiles.sLlenarIzquierda(IntToStr(j), 3, '0');
        A.Cells[1, j] := objeto.Codigo;
        if (obsocial.FactNBU = 'N') or (Length(trim(A.Cells[1, j])) = 4) then Begin
          nomeclatura.getDatos(A.Cells[1, j]);
          A.Cells[2, j] := nomeclatura.descrip;
        end else begin
          if obsocial.FactNBU = 'S' then Begin
            nbu.getDatos(A.Cells[1, j]);
            A.Cells[2, j] := nbu.descrip;  
          end;
        end;
        A.Cells[3, j] := id.Text;
        A.Cells[4, j] := pac.Caption;
        A.Cells[5, j] := codpac.Text;
        A.Cells[6, j] := auditoriacb.Codosfact;
        A.Cells[7, j] := os.Caption;

        //20/11/2019
        A.cells[9, j] := retiva;

        // 07/05/2020
        A.cells[10,j] := FloatToStr(objeto.montoCoseguro);

        {
        if (objeto.montoCoseguro > 0) then begin
          utiles.msgError(A.cells[10,j]);
          exit;
        end;
        }
        

        // 25/11/2019 - período en el que se debe facturar la orden
        perorden := copy(objeto.Fecha, 5, 2) + '/' + copy(objeto.Fecha, 1, 4);
        A.cells[8, j] := perorden;

        // 25/06/2018 - Ajustes para Jerárquicos
        facturacion.NRO_AFILIADO := objeto.Nrodoc;
        facturacion.NRO_AUTORIZACION := objeto.Nroautorizacion;
        facturacion.FECHA_ORDEN := objeto.Fecha;
      end;
    end;
    r.Free; r := Nil;

    // 25/06/2018 - Ajustes para Jerárquicos
    facturacion.REGLA_EXPORTACION := obsocial.getRegla(auditoriacb.Codosfact);
    facturacion.NRO_AUDITORIA := nroauditoria.Text;

    // Registramos el Laboratorio que la Facturo
    auditoriacb.MarcarAuditoriaComoFacturada(nroauditoria.Text, id.Text, '01/' + Copy(periodoaudit.Text, 1, 2) + '/' + Copy(periodoaudit.Text, 6, 2), idprofaudit.Text);
  end;

  finalizarClick(nil);
  guardar.Enabled   := True;
  guardarClick(nil);
  nroauditoria.Text := '';
end;

