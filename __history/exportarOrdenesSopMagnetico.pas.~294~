procedure TfmExportarOrdenesSoporteMagnetico.generarArchivoR10;
var
  importe, archivo, tipo, sucursal, numero, nrocuit, idprof: string;
  arch: TextFile;
  i: integer;
  total, monto1, monto2: real;
  init: boolean;
  r: TQuery;
begin

  if not (DirectoryExists(dbs.DirSistema + '\work\exportsopmag')) then utilesarchivos.CrearDirectorio(dbs.DirSistema + '\work\exportsopmag');

  empresa.conectar;
  empresa.getDatos;

  r := facturacion.exportarReglaFacturasDetalle(periodo.Text);

  //============================================================================
  // Tratamiento Responsables Inscriptos

  r.Open; r.first;

  r := datosdb.Filtrar(r, 'tipo <> ' + '''' + 'C' + '''');

  while not r.Eof do begin
    if ( (r.FieldByName('tipo').asstring <> tipo) or (r.FieldByName('sucursal').asstring <> sucursal) or (r.FieldByName('numero').asstring <> numero) or (r.FieldByName('idprof').asstring <> idprof) ) then begin  // La primera vez

      if (init) then closeFile(arch);

      archivo := dbs.DirSistema + '\work\exportsopmag\' + idos.Text + '_' + '_' + utiles.StringRemplazarCaracteres(periodo.Text, '/', '_') + '_' +
      r.FieldByName('idprof').asstring + '_' + r.FieldByName('tipo').asstring + '_' + r.FieldByName('sucursal').asstring + '_' + r.FieldByName('numero').asstring + '.txt';
      AssignFile(arch, archivo);
      rewrite(arch);
      init := true;

      tipo := r.FieldByName('tipo').asstring;
      sucursal := r.FieldByName('sucursal').asstring;
      numero := r.FieldByName('numero').asstring;
      idprof := r.FieldByName('idprof').asstring;

    end;

    StatusBar1.Panels[0].Text := 'Procesando ' + tipo + ' ' + sucursal + '-' + numero; StatusBar1.Refresh;

    nrocuit := empresa.cuit;

    //monto1 := 0;
    if (r.FieldByName('tipo').asstring <> 'C') then begin
      profesional.getDatos(r.FieldByName('idprof').asString);
      nrocuit := profesional.Nrocuit;
      //monto1 := r.FieldByName('iva').AsFloat * (obsocial.retencioniva * 0.01);
    end;

    //monto1 := r.FieldByName('iva').AsFloat * (obsocial.retencioniva * 0.01);
    //monto2 := monto1 + r.FieldByName('monto').asfloat;
    monto2 := r.FieldByName('montofinal').asfloat;

    write(arch, utiles.StringRemplazarCaracteres(nrocuit, '-', '') + ';'); // nro. de cuit
    write(arch, r.FieldByName('op2').asstring + ';'); // nro de afiliado
    write(arch, utiles.sExprFecha2000(r.FieldByName('op1').asstring) + ';'); // fecha de prestación
    write(arch, '0' + ';'); // nro de bono
    write(arch, r.FieldByName('codigo').asstring + ';'); // codigo de práctica
    write(arch, '4' + ';'); // componente
    write(arch, '1' + ';'); // cantidad
    write(arch, utiles.StringRemplazarCaracteres(r.FieldByName('op3').asstring, '-', '') + ';'); // nro de afiliado
    importe := utiles.FormatearNumero(floattostr(monto2));
    write(arch, utiles.StringRemplazarCaracteres(importe, ',', '.') + ';');  // arancel total
    write(arch, utiles.StringRemplazarCaracteres(importe, ',', '.') + ';');  // arancel total
    write(arch, '4' + ';'); // valor fijo 4
    write(arch, '3' + ';'); // valor fijo 3
    writeLn(arch, '0'); // ambulatorio

    r.next;

  end;

  if (init) then closeFile(arch);

  //============================================================================

  // Tratamiento Responsables Monotributo

  r.Close; r.free;
  init := false;

  r := facturacion.exportarReglaFacturasDetalleRM(periodo.Text);
  r.Open;
  r := datosdb.Filtrar(r, 'tipo = ' + '''' + 'C' + '''');
  r.first;

  while not r.Eof do begin
    if ( (r.FieldByName('tipo').asstring <> tipo) or (r.FieldByName('sucursal').asstring <> sucursal) or (r.FieldByName('numero').asstring <> numero) ) then begin  // La primera vez

      if (init) then closeFile(arch);

      archivo := dbs.DirSistema + '\work\exportsopmag\' + idos.Text + '_' + '_' + utiles.StringRemplazarCaracteres(periodo.Text, '/', '_') + '_' +
      '000000' + '_' + r.FieldByName('tipo').asstring + '_' + r.FieldByName('sucursal').asstring + '_' + r.FieldByName('numero').asstring + '.txt';
      AssignFile(arch, archivo);
      rewrite(arch);
      init := true;

      tipo := r.FieldByName('tipo').asstring;
      sucursal := r.FieldByName('sucursal').asstring;
      numero := r.FieldByName('numero').asstring;
      idprof := r.FieldByName('idprof').asstring;

    end;

    StatusBar1.Panels[0].Text := 'Procesando ' + tipo + ' ' + sucursal + '-' + numero; StatusBar1.Refresh;

    nrocuit := empresa.cuit;

    //monto1 := 0;
    if (r.FieldByName('tipo').asstring <> 'C') then begin
      profesional.getDatos(r.FieldByName('idprof').asString);
      nrocuit := profesional.Nrocuit;
      //monto1 := r.FieldByName('iva').AsFloat * (obsocial.retencioniva * 0.01);
    end;

    //monto1 := r.FieldByName('iva').AsFloat * (obsocial.retencioniva * 0.01);
    //monto2 := monto1 + r.FieldByName('monto').asfloat;
    monto2 := r.FieldByName('montofinal').asfloat;

    write(arch, utiles.StringRemplazarCaracteres(nrocuit, '-', '') + ';'); // nro. de cuit
    write(arch, r.FieldByName('op2').asstring + ';'); // nro de afiliado
    write(arch, utiles.sExprFecha2000(r.FieldByName('op1').asstring) + ';'); // fecha de prestación
    write(arch, '0' + ';'); // nro de bono
    write(arch, r.FieldByName('codigo').asstring + ';'); // codigo de práctica
    write(arch, '4' + ';'); // componente
    write(arch, '1' + ';'); // cantidad
    write(arch, utiles.StringRemplazarCaracteres(r.FieldByName('op3').asstring, '-', '') + ';'); // nro de afiliado
    importe := utiles.FormatearNumero(floattostr(monto2));
    write(arch, utiles.StringRemplazarCaracteres(importe, ',', '.') + ';');  // arancel total
    write(arch, utiles.StringRemplazarCaracteres(importe, ',', '.') + ';');  // arancel total
    write(arch, '4' + ';'); // valor fijo 4
    write(arch, '3' + ';'); // valor fijo 3
    writeLn(arch, '0'); // ambulatorio

    r.next;

  end;

  if (init) then closeFile(arch);


  //============================================================================

  r.close; r.free;

  empresa.desconectar;

  StatusBar1.Panels[0].Text := '';

end;

