procedure TfmFactManual.btnBuscarOrdenesClick(Sender: TObject);
var
  i, j, k: integer;
  agrega: boolean;
begin
  if (profesional.Buscar(idprofaudit.Text)) then begin
    profesional.getDatos(idprofaudit.Text);
    Application.CreateForm(TfmSeleccionOrdenes, fmSeleccionOrdenes);
    fmSeleccionOrdenes.idprof.Caption := profesional.codigo;
    fmSeleccionOrdenes.nprofesional.Caption := profesional.nombre;
    fmSeleccionOrdenes.ShowModal;
    Refresh;
    FAudit.Enabled      := false;
    btnFacturar.Enabled := false;

    j := 0; itemsaudit := 0;
    for i := 1 to FAudit.RowCount do begin
      if (length(trim(FAudit.Cells[0, i])) = 0) then break;
      j := i;
    end;

    for i := 1 to fmSeleccionOrdenes.S.RowCount do begin
      if (length(trim(fmSeleccionOrdenes.S.Cells[0, i])) = 0) then break;
      if (fmSeleccionOrdenes.S.Cells[1, i] = 'S') then begin
        agrega := true;

        for k := 1 to FAudit.RowCount do begin
          if (length(trim(FAudit.Cells[3, k])) = 0) then break;          
          if (fmSeleccionOrdenes.S.Cells[7, i] = FAudit.Cells[3, k]) then begin
            agrega := false;
            break;
          end;
        end;
           
        if (agrega) then begin
          Inc(j);
          Inc(itemsaudit);
          FAudit.Cells[0, j]  := utiles.sLlenarIzquierda(inttostr(j), 3, '0');
          FAudit.Cells[1, j]  := idprofaudit.Text;
          FAudit.Cells[2, j]  := profaudit.Caption;
          FAudit.Cells[3, j]  := fmSeleccionOrdenes.S.Cells[7, j];
        end;
        FAudit.Enabled      := true;
        btnFacturar.Enabled := true;
      end;
    end;
    if (j > 0) then begin
      btnRegistrarClick(Self);
    end;
    fmSeleccionOrdenes.Release; fmSeleccionOrdenes := Nil;
    ordenaudit.setFocus;
  end else
    utiles.msgError('El Profesional Seleccionado es Incorrecto ...!');
end;

