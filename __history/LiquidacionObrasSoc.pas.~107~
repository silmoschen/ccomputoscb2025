procedure TfmLiquidacionOS.emitirClick(Sender: TObject);
var
  salto: ShortInt;
  ss: char; ldat, condlist: Boolean;
  i: integer;
begin
  if not Assigned(fmEleProfesional) then Application.CreateForm(TfmEleProfesional, fmEleProfesional);
  if not Assigned(Dispositivo) then Application.CreateForm(TDispositivo, Dispositivo);

  l.Clear;

  distribucionos.LiquidarRetencionesSeparadas := false;

  if (listCoseguros.Checked) then begin
    StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
    auditoriacb.ListarCoseguros('', '', per.Text, salida);
    per.setFocus;
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    exit;
  end;

  if (recMontos.Checked) then begin
    StatusBar1.Panels[0].Text := 'Recalculando Coseguros ...!'; StatusBar1.Refresh;

    for i := 1 to S.RowCount do begin
      if (length(trim(S.Cells[0, i])) = 0) then break;
      if (S.Cells[6, i] = 'S') then begin
        StatusBar1.Panels[0].Text := 'Recalculando Coseguro: ' + S.Cells[5, i] + '-' + S.Cells[1, i]; StatusBar1.Refresh;
        auditoriacb.ListarCoseguros(S.Cells[1, i], S.Cells[5, i], per.Text, 'R');
      end;
    end;

    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  end;

  distribucionos.LineasPag := StrToInt(altopag.Text);
  distribucionos.salto     := StrToInt(lineassep.Text);
  if CheckBox3.Checked then distribucionos.ConceptoSaldo := concepto.Text else distribucionos.ConceptoSaldo := '';
  distribucionos.BecasGan  := becasgan.Checked;
  if salida = 'I' then
    if not Assigned(fmConfigImpresora) then Application.CreateForm(TfmConfigImpresora, fmConfigImpresora);
  if (RadioButton1.Checked) or (RadioButton2.Checked) or (RadioButton3.Checked) then Begin

    CargarLiqGanancias;
    ldat := False;
    if (Length(Trim(pergan.Text)) < 7) then Begin
      pergan.Text := '';
      ldat := True;
    end else Begin
      if (utiles.verificarPeriodo(pergan.Text)) and ((disgan.Text = '01') or (disgan.Text = '02')) then ldat := True;
    end;

    if distribucionos.verificarPeriodo(per.Text + nrodistinf.Text) and (ldat) then Begin
      StatusBar1.Panels[0].Text := 'Generando Informe Distribución ...!'; StatusBar1.Refresh;
      salida := 'P';
      if Dispositivo.Impresor.Checked then
        if impresiontxt.Checked then salida := 'T' else salida := 'I';
      if salida = 'I' then Begin
        fmConfigImpresora.seleccionar_impresora := IntToStr(impresora);   // Indice Impresora
        fmConfigImpresora.FormShow(Self);                   // Load Seteos
      end;

      distribucionos.PeriodoGanancias     := pergan.Text;   // Para recuperar los periodos de ganancias
      distribucionos.LiquidacionGanancias := disgan.Text;
      distribucionos.LiqIndi_Ganancias    := liqIndi.Checked;
      distribucionos.verFormulaGanancias  := verFormula.Checked;

      if RadioButton1.Checked then
        if osiva.Checked then distribucionos.ExcluirObrasSocialesInscriptas := 1 else distribucionos.ExcluirObrasSocialesInscriptas := 0;

      if RadioButton3.Checked then begin
        distribucionos.LiquidarRetencionesSeparadas := true;
        if osiva.Checked then distribucionos.ExcluirObrasSocialesInscriptas := 1 else distribucionos.ExcluirObrasSocialesInscriptas := 0;
      end;

      if RadioButton2.Checked then distribucionos.ExcluirObrasSocialesInscriptas := 2;

      if not (liq1.Checked) and not (liq2.Checked) then distribucionos.AplicarMinimoGanancias := 1;
      if liq1.Checked then distribucionos.AplicarMinimoGanancias := 1;
      if liq2.Checked then distribucionos.AplicarMinimoGanancias := 2;

      // Inicilizamos los montos si todos los profesionales son seleccionados  // 12/08/2014
      distribucionos.__liqTodos := false;
      if (fmEleProfesional.selectAll) then begin
        distribucionos.InicializarMontos(per.Text, nrodistinf.Text, fmEleProfesional.selectAll);
        distribucionos.__liqTodos := fmEleProfesional.selectAll;
      end;

      distribucionos.PrepararDirectorio(per.Text + nrodistinf.Text);
      if ruptura.Checked then salto := 1 else salto := 0;
      condlist := False;
      if profesional.Buscar(idLab.Text) then condlist := True;
      if fmEleProfesional.cantidadSel > 0 then condlist := True;

      if not condlist then utiles.msgError('No se ha Seleccionado Ningun Laboratorio ...!') else Begin

        if Length(Trim(idLab.Text)) > 0 then DatosProfesional;
        distribucionos.LineasPag := StrToInt(altopag.Text);
        distribucionos.salto     := StrToInt(lineassep.Text);
        distribucionos.ConfigurarInforme(RadioButton1.Caption, StrToInt(cantcopias.Text), salto);
        if fmEleProfesional.lista = Nil then begin
          l.Clear;
          l.Add(idlab.Text);
        end else
          if (Length(Trim(idlab.Text)) = 0) or (fmEleProfesional.lista.Count > 1) or (l = Nil) then l := fmEleProfesional.lista else l.Add(idlab.Text);

        distribucionos.InfDistribucionProfesional(per.Text + nrodistinf.Text, per.Text + nrodistinf.Text, l, listadist, salida, CheckBox2.Checked, unifganancias.Checked, recMontos.Checked, liqganancias.Text, nrodistinf.Text);

      end;

      StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    end else
     utiles.msgError('No se Encontraron Operaciones Registradas en este Período o' + chr(13) + 'Los Parámetros son Incorrectos ...!');
  end;

  if salida = 'T' then ss := 'I' else ss := salida;
  if (ss = 'I') and Assigned(fmConfigImpresora) then Begin
    fmConfigImpresora.seleccionar_impresora := IntToStr(impresora);   // Indice Impresora
    fmConfigImpresora.FormShow(Self);                   // Load Seteos
  end;
  if totFact.Checked then
    facturacion.InformeTotalObrasSociales(per.Text, lista, salida);
  if totProf.Checked then
    facturacion.InformeTotalProfesionales(per.Text, lista, salida, labivains.Checked);
  if resProf.Checked then
    facturacion.InformeResumenProfesionales(per.Text, lista, salida, labivains.Checked);
  if listPagos.Checked then
    distribucionos.ListarObrasSocialesLiquidadas(lista, per.Text, nrodistinf.Text, salida);
  if listUH.Checked then
    facturacion.InformeResumenProfesionalesUnidadesHonorarios(per.Text, lista, salida, labivains.Checked);

  if listResumen.Checked then Begin
    utiles.msgError('Antes de Generar este Informe, Asegúrese haber Emitido los Informes Correspondientes a las Liquidaciones, Incluyendo las que Retienen I.V.A.', 'Advertencia');
    if not recMontos.Checked then distribucionos.ListarResumenLisquidacion(per.Text + nrodistinf.Text, nrodistinf.Text, salida, recMontos.Checked) else Begin
      RecalcularMontos;
      StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
      distribucionos.ListarResumenLisquidacion(per.Text + nrodistinf.Text, nrodistinf.Text, 'N', recMontos.Checked);
      distribucionos.ListarResumenLisquidacion(per.Text + nrodistinf.Text, nrodistinf.Text, salida, False);
      StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
      recMontos.Checked         := False;
    end;
  end;

  if listResumenRet.Checked then Begin
    utiles.msgError('Antes de Generar este Informe, Asegúrese haber Emitido los Informes Correspondientes a las Liquidaciones, Incluyendo las que Retienen I.V.A.', 'Advertencia');
