unit CExportObrasSociales;

interface

uses SysUtils, CListar, CUtiles, DBTables, Contnrs, CIDBFM, Forms, CBDT, DB;

type

TTExportObrasSociales = class
  Periodo, Idprof, Codos, Fecha, Tipo, Sucursal, Numero: string;
  tabla: TTable;
 public
  { Declaraciones Públicas }
  constructor Create;

  procedure   Registrar(xperiodo, xidprof, xcodos, xfecha, xtipo, xsucursal, xnumero: string);
  procedure   Borrar(xperiodo, xidprof, xcodos: string);
  function    Buscar(xperiodo, xidprof, xcodos: string): boolean;
  procedure   getDatos(xperiodo, xidprof, xcodos: string);

  procedure   conectar;
  procedure   desconectar;

  destructor  Destroy; override;
 private
  { Declaraciones Privadas }
  u, ud: real;
  per: string;
  conexiones: shortint;
end;

function ExportObrasSociales: TTExportObrasSociales;

implementation

var
  xExportObrasSociales: TTExportObrasSociales = nil;

constructor TTExportObrasSociales.Create;
var
  dbconexion: string;
begin
  inherited Create;
  tabla := datosdb.openDB('OBSOCIAL_EXPORT_SOPMAG', '', '', dbconexion);
end;

destructor TTExportObrasSociales.Destroy;
begin
  inherited Destroy;
end;

procedure TTExportObrasSociales.Registrar(xperiodo, xidprof, xcodos, xfecha, xtipo, xsucursal, xnumero: string);
// Objetivo...: Grabar Atributos del Objeto
begin
  if Buscar(xperiodo, xidprof, xcodos) then tabla.Edit else tabla.Append;
  tabla.FieldByName('periodo').AsString  := xperiodo;
  tabla.FieldByName('codos').AsString    := xcodos;
  tabla.FieldByName('fecha').AsString    := xfecha;
  tabla.FieldByName('tipo').AsString     := xtipo;
  tabla.FieldByName('sucursal').AsString := xsucursal;
  tabla.FieldByName('numero').AsString   := xnumero;
  try
    tabla.Post;
  except
    tabla.Cancel;
  end;
  datosdb.closeDB(tabla); tabla.Open;
end;

procedure TTExportObrasSociales.Borrar(xperiodo, xidprof, xcodos: string);
// Objetivo...: Eliminar un Objeto
begin
  if Buscar(xperiodo, xidprof, xcodos) then
    begin
      tabla.Delete;
      datosdb.closeDB(tabla); tabla.Open;
    end;
end;

function TTExportObrasSociales.Buscar(xcodigo, xperiodo: string): boolean;
// Objetivo...: Buscar el Objeto solicitado
begin
  result := datosdb.Buscar(tabla, 'periodo', 'idprof', 'codos', xperiodo, xidprof, xcodos);
end;

procedure TTExportObrasSociales.getDatos(xperiodo, xidprof, xcodos: string);
// Objetivo...: Retornar/Iniciar Atributos
begin
  if Buscar(xperiodo, xidprof, xcodos) then begin
    periodo   := tabla.FieldByName('periodo').AsString;
    idprof    := tabla.FieldByName('idprof').AsString;
    codos     := tabla.FieldByName('codos').AsString;
    tipo      := tabla.FieldByName('tipo').AsString;
    sucursal  := tabla.FieldByName('sucursal').AsString;
    numero    := tabla.FieldByName('numero').AsString;
    fecha     := tabla.FieldByName('fecha').AsString;
  end else   begin
    periodo := ''; idprof := ''; sucursal := ''; codos := ''; numero := ''; fecha := '';
  end;
end;

procedure TTExportObrasSociales.conectar;
// Objetivo...: Abrir tablas de persistencia
begin
  if conexiones = 0 then Begin
    if not tabla.Active then tabla.Open;
  end;
  Inc(conexiones);
end;

procedure TTExportObrasSociales.desconectar;
// Objetivo...: cerrar tablas de persistencia
begin
  if conexiones > 0 then Dec(conexiones);
  if conexiones = 0 then datosdb.closeDB(tabla);
end;

{===============================================================================}

function ExportObrasSociales: TTExportObrasSociales;
begin
  if xExportObrasSociales = nil then
    xExportObrasSociales := TTExportObrasSociales.Create;
  Result := xExportObrasSociales;
end;

{===============================================================================}

initialization

finalization
  xExportObrasSociales.Free;


end.
