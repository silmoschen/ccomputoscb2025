procedure TfmFactManual.detalleOSClick(Sender: TObject);
var
  i, j, retoma, k, cant_ordenes: Integer; idlant: String; lista: TStringList;
begin
  periodo.Text := periodoImp.Text;
  if detalleOS.Caption = '&Consultar Obras Sociales Fact.' then if Length(Trim(D.Cells[0, D.Row])) > 0 then begin
    DDblClick(Sender);
    exit;
  end;
  if detalleOS.Caption = '&Facturar Ordenes Auditoria' then Begin
    StatusBar1.Panels[0].Text := 'Conectando Módulo Auditoría'; StatusBar1.Refresh;

    auditoriacb.conectar;
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;

    cant_ordenes := 0; retoma := 0;
    for k := 1 to OA.RowCount do Begin
      if Length(Trim(OA.Cells[0, k])) = 0 then Break;
      Inc(cant_ordenes);
    end;

    //  verificar el laboratorio que facturo la orden
    AssignFile(archivo, dbs.DirSistema + '\control_audit.txt');
    Rewrite(archivo);
    For i := 1 to OA.RowCount do Begin
      if Length(Trim(OA.Cells[0, i])) = 0 then Break;
      if OA.Cells[2, i] <> 'F' then Begin
      StatusBar1.Panels[0].Text := 'Facturando Orden ' + OA.Cells[1, i] + '  ' + IntToStr(i) + ' de ' + IntToStr(cant_ordenes) + '   Id.Int.: ' + id.Text; StatusBar1.Refresh;
      nroauditoria.Text := OA.Cells[1, i]; nroauditoria.Enabled := False; nroauditoria.Refresh;
      if OA.Cells[0, i] <> idlant then Begin
        idprof.Text  := OA.Cells[0, i];
        DatosProfesional;
        idlant := OA.Cells[0, i];

        if recordenes.Checked then Begin
          retoma := 5000;
          facturacion.BorrarOrdenesPorId(IntToStr(retoma - 1), periodoImp.Text, idprof.Text);
        end else
          retoma := facturacion.ObtenerUltimoId(periodoImp.Text, idprof.Text);

        id.Text := IntToStr(retoma);    // Las ordenes provenientes de Auditoria se Registran a partir del 5000

        idl.Caption := OA.Cells[0, i]; idl.Refresh;
        l.Caption   := profesional.Nombre; l.Refresh;
        idprof_audit.Text := idl.Caption;
      end;
      if auditoriacb.Buscar(nroauditoria.Text) then Begin
        auditoriacb.getDatos(nroauditoria.Text);
        if Length(Trim(auditoriacb.Nroderivacion)) = 0 then Begin // Si No tiene derivación solo se Integra
          IntegrarDatosAuditoria;
          OA.Cells[2, i] := 'F'; OA.Refresh;
        end else Begin
          if (Length(Trim(auditoriacb.Nroderivacion)) > 0) and (profesional.Nivel2 = 'S') then Begin    // Si tiene derivación y el profesional está autorizado a facturar Nivel 2
            IntegrarDatosAuditoria;
            OA.Cells[2, i] := 'F'; OA.Refresh;
          end;
          if (Length(Trim(auditoriacb.Nroderivacion)) > 0) and (profesional.Nivel2 <> 'S') then Begin    // Si tiene derivación y el profesional está autorizado a facturar Nivel 2
            OA.Cells[2, i] := 'N'; OA.Refresh;
          end;
        end;
      end else
        OA.Cells[2, i] := 'X';
      facturacion.MarcarOrdenAuditoria(periodoImp.Text, OA.Cells[3, i], OA.Cells[0, i], OA.Cells[2, i]);
      OA.Row := i;
      OA.Refresh;
      fmFactManual.Refresh;
      end;
    end;
    padron.desconectar;

    // Borramos sobrante
    if id_f > '5000' then
      if retoma > 0 then facturacion.BorrarOrdenesPorId(id_f, periodoImp.Text, idprof.Text);

    closeFile(archivo);
    id_int.Caption := '';

    {
    if i > 0 then

      if utiles.msgSiNo('Presentar Informe de Control ?') then Begin
        lista := TStringList.Create;
        For j := 1 to OA.RowCount do Begin
          if Length(Trim(OA.Cells[0, j])) = 0 then Break;
          lista.Add(OA.Cells[0, j] + OA.Cells[1, j] + OA.Cells[2, j]);
        end;
        facturacion.lineas_audit := StrToInt(nroordenes.Text);
        facturacion.ListarOrdenesAuditoriaFacturadas(lista, 'P');
        if utiles.msgSiNo('Generar una Copia Impresa ?') then facturacion.ListarOrdenesAuditoriaFacturadas(lista, 'I');
      end;
      }

    auditoriacb.desconectar;
    if (TabSheet8.TabVisible) then begin
      auditonline.desconectar;
      auditonline.conectar;
    end;
    detalleOS.Visible := False;
    periodoImp.SetFocus;

    if (fact_auditoria) and (detalleOS.Caption = '&Facturar Ordenes Auditoria') then Begin
      act_ordenes.Checked     := False;
      grid.IniciarGrilla(OA);
      PageControl1.ActivePage := TabSheet8;
    end;

    detalleOS.Caption := '&Consultar Obras Sociales Fact.';
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  end;
end;

