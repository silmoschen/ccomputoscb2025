procedure TForm1.Button3Click(Sender: TObject);
var
  narchivo, salida: textfile;
  linea, n: string;
  lineas, bloque: integer;
begin
  lineas := 0; bloque := 1;
  assignfile(narchivo, archivo.text);
  assignfile(salida, 'salida_pami' + inttostr(bloque) + '.sql');
  reset(narchivo);
  rewrite(salida);
  Label4.Caption := 'segmento ' + inttostr(bloque); Label4.Refresh;

  writeln(salida, 'update bioqafil set inactivo = ' + '''' + 'S' + '''' + ' where codos = ' + '''' + codos.Text + '''' + ';');

  while not EOF(narchivo) do begin
    readln(narchivo, linea);
    n := trimright(copy(linea, 32, 35));
    n := utiles.StringRemplazarCaracteres(n, '''' + '''' + '''', ' ');
    n := utiles.StringRemplazarCaracteres(n, '''' + '`' + '''', ' ');

    if (length(trim(copy(linea, 25, 9))) > 0) then begin
      writeln(salida, 'insert into bioqafil (codos, nrodoc, nombre, id_beneficio, fechanac, tipo_doc, id_parentesco, direccion, sexo, inactivo) values (' +
            '"' + codos.Text + '"' + ', ' + '"' + trim(copy(linea, 83, 8)) + '"' + ', ' +
            '"' + n + '"' + ', ' + '"' + copy(linea, 5, 12) + '"' + ', ' + '"' + copy(linea, 78, 2) + '/' + copy(linea, 76, 2) + '/' + copy(linea, 72, 4) + '"' + ', ' + '"' + copy(linea, 80, 3) + '"' + ', ' +
            '"' + copy(linea, 17, 2) {copy(linea, 11, 2)} + '"' + ', ' + '"' + '' + '"' + ', ' + '"' + copy(linea, 98, 1) + '"' + ', ""' + ');');
      label3.Caption := linea; label3.Refresh;
    end;

    inc(lineas);
    if (lineas > strtoint(tope.Text)) then begin
      closeFile(salida);
      Inc(bloque);
      assignfile(salida, 'salida_pami' + inttostr(bloque) + '.sql');
      rewrite(salida);
      Label4.Caption := 'segmento ' + inttostr(bloque); Label4.Refresh;
      lineas := 0;
    end;
  end;

  closeFile(narchivo);

  assignfile(narchivo, archivo.text);
  assignfile(narchivo, archivo.text);
  reset(narchivo);

  while not EOF(narchivo) do begin
      readln(narchivo, linea);
      writeln(salida, 'update bioqafil set inactivo = "" where codos = ' + '''' + codos.Text + '''' + ' and nrodoc = ' + '"' + trim(copy(linea, 83, 8)) + '";');
  end;

  closeFile(narchivo);
  closeFile(salida);

  close;
end;

procedure TForm1.Button4Click(Sender: TObject);
var
  narchivo, salida: textfile;
  linea, codigo, retiva: string;
  lineas, bloque: integer;
begin
  lineas := 0; bloque := 1;
  assignfile(narchivo, archivo.text);
  assignfile(salida, 'salida_federada' + inttostr(bloque) + '.sql');
  reset(narchivo);
  rewrite(salida);
  Label4.Caption := 'segmento ' + inttostr(bloque); Label4.Refresh;
  while not EOF(narchivo) do begin
    readln(narchivo, linea);

    if (copy(linea, 54, 2) = 'G1') then codigo := '121029' else codigo := '121129';
    if (copy(linea, 78, 1) = 'O') then retiva := 'S' else retiva := 'N';

    if (length(trim(copy(linea, 22, 5))) > 0) then begin
      writeln(salida, 'insert ignore into bioqafil (codos, nrodoc, nombre, sexo, tipo_doc, retiva) values (' +
            '"' + codigo + '"' + ', ' + '"' + trim(copy(linea, 64, 8)) + '"' + ', ' +
            '"' + trim(copy(linea, 19, 30)) + '"' + ', ' + '"' + copy(linea, 18, 1) + '"' + ', ' + '"' + copy(linea, 60, 3) + '"' + ', ' + '"' + retiva + '"' + ');');

      label3.Caption := linea; label3.Refresh;
    end;
    inc(lineas);
    if (lineas > strtoint(tope.Text)) then begin
      closeFile(salida);
      Inc(bloque);
      assignfile(salida, 'salida_federada' + inttostr(bloque) + '.sql');
      rewrite(salida);
      Label4.Caption := 'segmento ' + inttostr(bloque); Label4.Refresh;
      lineas := 0;
    end;
  end;
  closeFile(narchivo);
  closeFile(salida);
end;

procedure TForm1.Button5Click(Sender: TObject);
