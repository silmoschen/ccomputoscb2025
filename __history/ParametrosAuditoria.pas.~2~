procedure TfmParametrosAuditoria.FormShow(Sender: TObject);
begin
  if not configform.Setear(fmParametrosAuditoria) then Begin
    Height := 334; Width := 494;
  end;
  D.Cells[0, 0] := 'Cód.'; D.Cells[1, 0] := 'Determinación';
  M.Cells[0, 0] := 'Id.'; M.Cells[1, 0] := 'Nombre del Médico'; M.Cells[2, 0] := 'C.Cap.'; M.Cells[3, 0] := 'Vigencia';
  C.Cells[0, 0] := 'Período'; C.Cells[1, 0] := 'C.Cap.';
  auditoriacb.conectar;
  medcab.conectar;
  codosmc.setFocus;
end;

procedure TfmParametrosAuditoria.BuscarOSClick(Sender: TObject);
begin
  Application.CreateForm(TfmListObrasSociales, fmListObrasSociales);
  fmListObrasSociales.introSalir := True;
  fmListObrasSociales.expresion.CharCase := ecUpperCase;
  fmListObrasSociales.ShowModal;
  Refresh;
  if fmListObrasSociales.seleccionOK then Begin
    codosex.Text := obsocial.tabla.FieldByName('codos').AsString;
    CargarDatosObraSocial2;
  end;
  fmListObrasSociales.Release; fmListObrasSociales := nil;
end;

procedure TfmParametrosAuditoria.BuscarDetClick(Sender: TObject);
begin
  if (obsocial.Factnbu = 'N') then begin
    Application.CreateForm(TfmListNomeclador, fmListNomeclador);
    fmListNomeclador.introSalir := True;
    fmListNomeclador.ShowModal;
    Refresh;
    if fmListNomeclador.seleccionOK then Begin
      codex.Text := nomeclatura.tabla.FieldByName('codigo').AsString;
      CargarDet;
    end;
    fmListNomeclador.Release; fmListNomeclador := nil;
  end;
  if (obsocial.Factnbu = 'S') then begin
    Application.CreateForm(TfmListNBU, fmListNBU);
    fmListNBU.introSalir := True;
    fmListNBU.ShowModal;
    Refresh;
    if fmListNBU.seleccionOK then Begin
      codex.Text := nbu.tabla.FieldByName('codigo').AsString;
      CargarDet;
    end;
    fmListNBU.Release; fmListNBU := nil;
  end;
end;

procedure TfmParametrosAuditoria.codosexKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_ESCAPE then Close;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if not obsocial.Buscar(codosex.Text) then BuscarOSClick(Sender) else CargarDatosObraSocial2;
end;

procedure TfmParametrosAuditoria.codexKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_UP then codosex.SetFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if not nomeclatura.Buscar(codex.Text) then BuscarDetClick(Sender) else CargarDet;
end;

procedure TfmParametrosAuditoria.DKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_DELETE then begin
    if Length(trim(D.Cells[0, D.Row])) > 0 then Begin
      if (utiles.msgSiNo('Seguro para Borrar Determinación ' + D.Cells[0, D.Row] + ' - ' + D.Cells[1, D.Row] + ' ?')) then begin
        auditoriacb.BorrarDetRechazada(codosex.Text, D.Cells[0, D.Row]);
        CargarDetRech;
      end;
    end;
  end;
end;

procedure TfmParametrosAuditoria.BuscarOSMCClick(Sender: TObject);
begin
  Application.CreateForm(TfmListObrasSociales, fmListObrasSociales);
  fmListObrasSociales.introSalir := True;
  fmListObrasSociales.expresion.CharCase := ecUpperCase;
  fmListObrasSociales.ShowModal;
  Refresh;
  if fmListObrasSociales.seleccionOK then Begin
    codosmc.Text := obsocial.tabla.FieldByName('codos').AsString;
    CargarDatosObraSocial3;
  end;
  fmListObrasSociales.Release; fmListObrasSociales := nil;

end;

procedure TfmParametrosAuditoria.BuscarMedicoCabeceraClick(
  Sender: TObject);
begin
  Application.CreateForm(TfmListMedicos, fmListMedicos);
  fmListMedicos.introSalir := True;
  //fmListMedicos.expresion.Text := nprofesional.Text;
  fmListMedicos.ShowModal;
  if fmListMedicos.seleccionOK then Begin
    idprofmc.Text := medico.tabla.FieldByName('idprof').AsString;
    CargarMedicosCabecera1;
  end;
  fmListMedicos.Release; fmListMedicos := nil;
end;

procedure TfmParametrosAuditoria.codosmcKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_ESCAPE then Close;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if not obsocial.Buscar(codosmc.Text) then BuscarOSMCClick(Sender) else CargarDatosObraSocial3;
end;

procedure TfmParametrosAuditoria.idprofmcKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_UP then codosmc.SetFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then Begin
    if Length(Trim(idprofmc.Text)) = 0 then BuscarMedicoCabeceraClick(Self) else Begin
      idprofmc.Text := utiles.sLlenarIzquierda(idprofmc.Text, 4, '0');
      if not medico.Buscar(idprofmc.Text) then BuscarMedicoCabeceraClick(Sender) else CargarMedicosCabecera1;
    end;
  end;
end;

procedure TfmParametrosAuditoria.cantcapitasKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_UP then idprofmc.SetFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if Length(Trim(cantcapitas.Text)) > 0 then periodo.SetFocus;
end;

procedure TfmParametrosAuditoria.MKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_DELETE then
    if Length(trim(M.Cells[0, M.Row])) > 0 then Begin
      if utiles.msgSiNo('Seguro para Eliminar Médico ' + M.Cells[1, M.Row] + ' ?') then Begin
        medcab.BorrarMedicoCabecera(codosmc.Text, M.Cells[0, M.Row]);
        CargarMedicosCabecera;
      end;
    end;
end;

procedure TfmParametrosAuditoria.FormResize(Sender: TObject);
begin
  StatusBar1.Panels[0].Width := Width - (Width div 5);
end;

procedure TfmParametrosAuditoria.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  auditoriacb.desconectar;
  medcab.desconectar;
  configform.Guardar(fmParametrosAuditoria, redim);
  Release; fmParametrosAuditoria := Nil;
end;

procedure TfmParametrosAuditoria.Panel1Resize(Sender: TObject);
begin
  redim := True;
end;

procedure TfmParametrosAuditoria.periodoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_UP then cantcapitas.SetFocus;
  if (Key = VK_RETURN) or (Key = VK_DOWN) then
    if utiles.verificarPeriodo(periodo.Text) then Begin
      if (obsocial.Buscar(codosmc.Text)) and (medico.Buscar(idprofmc.Text)) and (Length(Trim(cantcapitas.Text)) > 0) and (utiles.verificarPeriodo(periodo.Text)) then Begin
        medcab.RegistrarMedicoCabecera(codosmc.Text, idprofmc.Text, StrToInt(cantcapitas.Text));
        medcab.RegistrarCapita(codosmc.Text, idprofmc.Text, periodo.Text, StrToFloat(cantcapitas.Text));
        CargarMedicosCabecera;
        CargarCapitas;
        idprofmc.Text := ''; Label97.Caption := ''; cantcapitas.Text := ''; periodo.Text := '';
        idprofmc.SetFocus;
      end;
    end;

end;

procedure TfmParametrosAuditoria.CKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key = VK_DELETE then
    if Length(trim(C.Cells[0, C.Row])) > 0 then Begin
      if utiles.msgSiNo('Seguro para Eliminar Período ' + C.Cells[0, C.Row] + ' ?') then Begin
        medcab.BorrarCapita(codosmc.Text, idprofmc.Text, C.Cells[0, C.Row]);
        CargarCapitas;
      end;
    end else
     utiles.msgError('El Registro Seleccionado es Incorrecto ...!');
end;

end.
