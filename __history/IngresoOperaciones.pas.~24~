function  TfmIngreso.CantidadDeItemsIngresados(STG: TStringGrid): Integer;
var
  i: Integer;
Begin
  For i := 1 to STG.RowCount do
    if Length(Trim(STG.Cells[0, i])) = 0 then Break;
  Result := i - 1;
end;

function  TfmIngreso.NumeroDeColumna(STG: TStringGrid; xid: String): Integer;
var
  i: Integer;
Begin
  Result := -1;
  For i := 1 to STG.ColCount do Begin
    if Trim(STG.Cells[i, 0]) = Trim(xid) then Begin
      Result := i;
      Break;
    end;
  end;
end;

function  TfmIngreso.NumeroDeFila(STG: TStringGrid; xid: String): Integer;
var
  i: Integer;
Begin
  Result := -1;
  For i := 1 to STG.RowCount do Begin
    if Trim(STG.Cells[0, i]) = Trim(xid) then Begin
      Result := i;
      Break;
    end;
  end;
end;

procedure TfmIngreso.CargarProfesionales(SG: TStringGrid; ColInicio: Integer; filtro: Boolean);
var
  r: TQuery; i, j: Integer;
begin
  SG.DefaultColWidth := anchocol;
  SG.ColWidths[0]    := 200;
  SG.Cells[0, 0]     := 'Profesional/Items';
  r := profesional.setProfesionalesAlf;
  r.Open;
  SG.ColCount := r.RecordCount + 1 + (ColInicio - 1); i := 0;
  Id.ColCount := SG.ColCount; Ir.ColCount := SG.ColCount;
  while not r.Eof do Begin
    profesional.getDatos(r.FieldByName('idprof').AsString);
    if Length(Trim(profesional.Codfact)) = 0 then Begin
      Inc(i);
      SG.Cells[i + ColInicio - 1, 0] := Copy(r.FieldByName('Nombre').AsString, 1, 23);
      Id.Cells[i + ColInicio - 1, 0] := r.FieldByName('IdProf').AsString;
      Ir.Cells[i + ColInicio - 1, 0] := r.FieldByName('IdProf').AsString;
      For j := ColInicio to SG.ColCount - 1 do SG.Cells[j, i] := '';
    end else Begin
      SG.ColCount := SG.ColCount - 1;
      Id.ColCount := Id.ColCount - 1;
      Ir.ColCount := Ir.ColCount - 1;
    end;
    r.Next;
  end;
  r.Close; r.Free;
end;

procedure TfmIngreso.CargarDebitosCreditos;
var
  r: TQuery; i, j, k: Integer; f, lj: Boolean;
  l: TStringList;
begin
  l := ventainsumos.setTotalVentaInsumosPorProfesional(perLiq.Caption);  // Venta de Reactivos

  r := debitoscreditos.setItems;
  r.Open;
  Id.RowCount := D.RowCount; Ir.RowCount := D.RowCount;
  while not r.Eof do Begin
    if r.FieldByName('importe').AsFloat > 0 then Begin  // Cargamos los items con cálculo unico
      Inc(i);
      D.Cells [0, i] := Copy(r.FieldByName('Descrip').AsString, 1, 18);
      Id.Cells[0, i] := r.FieldByName('Items').AsString;
      Ir.Cells[0, i] := r.FieldByName('Items').AsString;
      For j := 1 to D.ColCount do D.Cells[j, i] := utiles.FormatearNumero(FloatToStr(r.FieldByName('importe').AsFloat));
    end;
    r.Next;
  end;

  r.First;     // Ahora procesamos los items que van por categoría
  while not r.Eof do Begin
    if r.FieldByName('discrim').AsString = 'C' then Begin
      Inc(i);
      D.Cells[0, i]  := r.FieldByName('descrip').AsString;
      Id.Cells[0, i] := r.FieldByName('Items').AsString;
      Ir.Cells[0, i] := r.FieldByName('Items').AsString;
      For j := 1 to Id.ColCount do Begin
        profesional.getDatos(Id.Cells[j, 0]);
        debitoscreditos.getDatos(r.FieldByName('items').AsString, profesional.Idcategoria);
        D.Cells[j, i] := utiles.FormatearNumero(FloatToStr(debitoscreditos.ImporteCat));
      end;
    end;
    r.Next;
  end;

  r.First; f := False;     // Ahora procesamos los items que se aplican a ciertos profesionales
  while not r.Eof do Begin
    if r.FieldByName('discrim').AsString = 'I' then Begin
    f := False;
    For j := 1 to Id.ColCount do Begin                        // Montos Normales
      //debitoscreditos.getDatosDCProf(r.FieldByName('items').AsString, Id.Cells[j, 0], perLiq.Caption);  // Ajuste 26/12/2006
      debitoscreditos.SincronizarDCProf(r.FieldByName('items').AsString, Id.Cells[j, 0], perLiq.Caption);  // Ajuste 26/12/2006
      lj := False;
      if Length(Trim(debitoscreditos.Per_inicio)) = 1  then lj := True else
        if (Copy(perLiq.Caption, 4, 4) + Copy(perLiq.Caption, 1, 2) >= Copy(debitoscreditos.Per_inicio, 4, 4) + Copy(debitoscreditos.Per_inicio, 1, 2)) and (Copy(perLiq.Caption, 4, 4) + Copy(perLiq.Caption, 1, 2) <= Copy(debitoscreditos.Per_final, 4, 4) + Copy(debitoscreditos.Per_final, 1, 2)) then lj := True;

      lj := True;
      if lj then Begin
        if debitoscreditos.MontoN > 0 then Begin
          //if debitoscreditos.BuscarDCProf(r.FieldByName('items').AsString, Id.Cells[j, 0], perLiq.Caption) then Begin
            if debitoscreditos.MontoN > 0 then Begin
              if not f then Begin
                Inc(i);
                D.Cells[0, i]  := r.FieldByName('descrip').AsString;
                Id.Cells[0, i] := r.FieldByName('Items').AsString;
                Ir.Cells[0, i] := r.FieldByName('Items').AsString;
                f := True;
              end;
              D.Cells[j, i] := utiles.FormatearNumero(FloatToStr(debitoscreditos.MontoN));
            end;
          //end;
        end;
      end;
    end;

    // Verificamos los Meses intermedios
    f := False;
    For j := 1 to Id.ColCount do Begin                        // Montos Normales
      if debitoscreditos.BuscarMes(r.FieldByName('items').AsString, Id.Cells[j, 0], Copy(perLiq.Caption, 1, 2)) then Begin
        debitoscreditos.getDatosMes(r.FieldByName('items').AsString, Id.Cells[j, 0], Copy(perLiq.Caption, 1, 2));
        if not f then Begin
          Inc(i);
          D.Cells[0, i]  := r.FieldByName('descrip').AsString + ' (monto dif.)';
          Id.Cells[0, i] := r.FieldByName('Items').AsString;
          Ir.Cells[0, i] := r.FieldByName('Items').AsString;
          f := True;
        end;
        if debitoscreditos.MontoD > 0 then D.Cells[j, i] := utiles.FormatearNumero(FloatToStr(debitoscreditos.MontoD));
      end;
    end;
   end;
   r.Next;
  end;
  r.Close; r.Free;

  // Venta de Reactivos
  for i := 1 to D.RowCount do Begin
    if Length(Trim(D.Cells[0, i])) = 0 then Break;
    if D.Cells[0, i] = 'Venta Reactivos Centro' then Break;
  end;
  j := i;

  //l := ventainsumos.setTotalVentaInsumosPorProfesional(perLiq.Caption);
  for i := 1 to l.Count do Begin
    for k := 1 to Ir.ColCount do
      if Ir.Cells[k, 0] = Copy(l.Strings[i-1], 1, 6) then Break;
    D.Cells[0, j] := 'Venta Reactivos Centro';
    D.Cells[k, j] := utiles.FormatearNumero(Copy(Trim(l.Strings[i-1]), 7, 20));
  end;

  AnularEntradasErroneas(D);
end;

procedure TfmIngreso.CargarAjustesPersonales;
// Objetivo...: Cargar Ajustes Personales, si es que existen
var
  r: TQuery;
  q: TIBQuery;
Begin
  if (distribucionos.interbase = 'N') then begin
    r := distribucionos.setItemsAjustesIndividuales(periodo.Caption, codos.Caption, nrodist.Caption);
    r.Open;
    while not r.Eof Do Begin
      A.Cells[0, r.FieldByName('Items').AsInteger] := r.FieldByName('Concepto').AsString;
      A.Cells[NumeroDeColumna(Id, r.FieldByName('idprof').AsString), r.FieldByName('Items').AsInteger] := utiles.FormatearNumero(r.FieldByName('importe').AsString);
      r.Next;
    end;
    r.Close; r.Free;
  end;
  if (distribucionos.interbase = 'S') then begin
    q := distribucionos.setItemsAjustesIndividualesIB(periodo.Caption, codos.Caption, nrodist.Caption);
    q.Open;
    while not q.Eof Do Begin
      A.Cells[0, q.FieldByName('Items').AsInteger] := q.FieldByName('Concepto').AsString;
      A.Cells[NumeroDeColumna(Id, q.FieldByName('idprof').AsString), q.FieldByName('Items').AsInteger] := utiles.FormatearNumero(q.FieldByName('importe').AsString);
      q.Next;
    end;
    q.Close; q.Free;
  end;
end;

procedure TfmIngreso.CargarDetalleDebitosCreditos;
// Objetivo...: Cargar Debitos Creditos Profesionales
var
  r: TQuery; c, f, fa, nf: Integer;
  q: TIBQuery;
Begin
  if (distribucionos.interbase = 'N') then begin
    r := distribucionos.setItemsDCProf(perLiq.Caption, nrodist.Caption);
    r.Open; r.First; f := 0;
    while not r.Eof Do Begin  // Items Manuales
      if r.FieldByName('tipomov').AsString = 'M' then Begin

        // Verificamos si el items ya esta cargado e identificamos la fila
        f := 0;
        for nf := 1 to M.RowCount do Begin
          if Length(Trim(M.Cells[0, nf])) = 0 then Break;
          if M.Cells[0, nf] = r.FieldByName('DescriPaj').AsString then Break;
        end;
        f := nf;

        M.Cells[0, f] := r.FieldByName('DescriPaj').AsString;
        c := NumeroDeColumna(Ir, r.FieldByName('Idprof').AsString);
        if (c >= 0) and (f >= 0) then
          if r.FieldByName('importeaj').AsFloat <> 0 then M.Cells[c, f] := utiles.FormatearNumero(r.FieldByName('importeaj').AsString) else D.Cells[NumeroDeColumna(Ir, r.FieldByName('Idprof').AsString), NumeroDeFila(Ir, r.FieldByName('Idajuste').AsString)] := '';
      end;
      r.Next;
    end;

    r.Close; r.Free;
  end;

  if (distribucionos.interbase = 'S') then begin
    q := distribucionos.setItemsDCProfIB(perLiq.Caption, nrodist.Caption);
    q.Open; q.First; f := 0;
    while not q.Eof Do Begin  // Items Manuales
      if q.FieldByName('tipomov').AsString = 'M' then Begin

        // Verificamos si el items ya esta cargado e identificamos la fila
        f := 0;
        for nf := 1 to M.RowCount do Begin
          if Length(Trim(M.Cells[0, nf])) = 0 then Break;
          if M.Cells[0, nf] = q.FieldByName('DescriPaj').AsString then Break;
        end;
        f := nf;

        M.Cells[0, f] := q.FieldByName('DescriPaj').AsString;
        c := NumeroDeColumna(Ir, q.FieldByName('Idprof').AsString);
        if (c >= 0) and (f >= 0) then
          if q.FieldByName('importeaj').AsFloat <> 0 then M.Cells[c, f] := utiles.FormatearNumero(q.FieldByName('importeaj').AsString); // else D.Cells[NumeroDeColumna(Ir, q.FieldByName('Idprof').AsString), NumeroDeFila(Ir, q.FieldByName('Idajuste').AsString)] := '';
      end;
      q.Next;
    end;

    q.Close; q.Free;
  end;
end;

procedure TfmIngreso.EliminarItems;
var
  SG: TStringGrid;
  borrado: Boolean;
begin
  if objeto = 'A' then SG := A;
  if objeto = 'D' then SG := D;
  if objeto = 'M' then SG := M;
  if Length(Trim(SG.Cells[0, SG.Row])) = 0 then utiles.msgError('El Items Debe tener una Descripción Asociada ...!') else Begin
    if BorradoDirecto then borrado := True else
      borrado := utiles.BajaRegistro('Seguro para Eliminar Items ' + SG.Cells[0, SG.Row] + ' ?');

    if borrado then
      grid.BorrarRenglon_SinRenumerar(SG);

    // Ajustes Finales
    if (objeto = 'M') and (Length(Trim(M.Cells[0, 1])) = 0) then distribucionos.BorrarDCProfManuales(perLiq.Caption, nrodist.Caption);
    if (objeto = 'A') and (Length(Trim(A.Cells[0, 1])) = 0) then distribucionos.AjustarNumeroDeItems(periodo.Caption, codos.Caption, nrodist.Caption, 0);
  end;
end;

procedure TfmIngreso.AnularEntradasErroneas(SG: TStringGrid);
var
  i, j, k, l, m: Integer;
  lb: array[1..10] of Integer;
Begin
  k := 0;
  For i := 1 to SG.RowCount do Begin
    if Length(Trim(SG.Cells[0, i])) = 0 then Break;
    l := 0;
    for j := 1 to SG.ColCount - 1 do l := l + Length(Trim(SG.Cells[j, i]));
    if l = 0 then Begin
      Inc(k);
      lb[k] := j;
    end;
  end;

  m := 0;
  for i := 1 to k do Begin
    SG.Row := k-m;
    grid.BorrarRenglon_SinRenumerar(SG);
    Inc(m);
  end;
end;

procedure TfmIngreso.FormShow(Sender: TObject);
var
  i, j, n: Integer;
begin
  Caption := tipomov;
  configform.Setear(fmIngreso);
  if FileExists(dbs.DirSistema + '\iop.ini') then Begin
    AssignFile(archivo, dbs.DirSistema + '\iop.ini');
    reset(archivo);
    ReadLn(archivo, n);
    P3.Height := n;
    closeFile(archivo);
  end else
    P3.Height := 145;

  if tipomov = 'Ajustes Individuales' then Begin
    Refresh;
    // Cargamos los débitos y créditos personales
    CargarProfesionales(D, 1, False); StatusBar1.Panels[0].Text := 'Cargando Profesionales'; StatusBar1.Refresh;
    CargarDebitosCreditos; StatusBar1.Panels[0].Text := 'Cargando Débitos y Créditos Individuales'; StatusBar1.Refresh;
    CargarDetalleDebitosCreditos; StatusBar1.Panels[0].Text := 'Cargando Detalle de Débitos y Créditos Individuales'; StatusBar1.Refresh;

    A.Visible := True;
    StatusBar1.Panels[0].Text := 'Cargando Ajustes Individuales'; StatusBar1.Refresh;
    CargarProfesionales(A, 1, True); StatusBar1.Panels[0].Text := 'Verificando Profesionales'; StatusBar1.Refresh;
    CargarAjustesPersonales; StatusBar1.Panels[0].Text := 'Cargando Ajustes Personales'; StatusBar1.Refresh;
    ActiveControl := A;
    A.Refresh;
    Panel7.Visible := True;
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  end;
  if tipomov = 'Débitos y Créditos Personales' then Begin
    PG.Visible := True;
    StatusBar1.Panels[0].Text := 'Cargando Débitos y Créditos Individuales'; StatusBar1.Refresh;
    D.Refresh;
    CargarProfesionales(D, 1, False);
    CargarProfesionales(M, 1, False);
    CargarDebitosCreditos;
    CargarDetalleDebitosCreditos;
    //CargarDebitosCreditos;
    for i := 1 to D.RowCount do if Length(Trim(D.Cells[0, i])) = 0 then Break;
    D.Row := i;
    for i := 1 to M.RowCount do if Length(Trim(M.Cells[0, i])) = 0 then Break;
    M.Row := i;
    ActiveControl  := M;
    Panel7.Visible := False;
    Label7.Visible := False;
    Panel3.Height  := 15;
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  end;

  if A.Visible then grid.RecuperarAnchoColumnas(fmIngreso, A);
  if D.Visible then grid.RecuperarAnchoColumnas(fmIngreso, D);
  if M.Visible then grid.RecuperarAnchoColumnas(fmIngreso, M);

  D.Refresh; M.Refresh;
  redim := False;
end;

