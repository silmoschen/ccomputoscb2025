    Label1: TLabel;
    Label2: TLabel;
    host: TMaskEdit;
    nftp: TMaskEdit;
    usuario: TMaskEdit;
    Label3: TLabel;
    pass: TMaskEdit;
    btnRegistrar: TButton;
