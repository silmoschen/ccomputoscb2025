function TfmObsociales.GrabarDatos: Boolean;
// Objetivo...: Grabar datos obra social
var
  p: Real;
  t: Char;
  l: Boolean;
begin
  if utiles.Sionoct(catlab.Text, 'SN', 'Las opciones son S/N ...!') then Begin
    l := False;
    if factnbu.Text = 'N' then Begin
      perNBU.Text := '';
      l := True;
    end else
      if utiles.verificarPeriodo(perNBU.Text, '') then l := True;
    if (Length(Trim(codos.Text)) > 0) and (Length(Trim(descrip.Text)) > 0) and (Length(Trim(catlab.Text)) > 0) and (utiles.Sionoct(retieneiva.Text, 'SN', '')) and (utiles.Sionoct(factnbu.Text, 'SN', '')) and (l) then Begin
      if Length(Trim(cobertura.Text)) = 0 then p := 0 else p := StrToFloat(cobertura.Text);
      if topes.Checked then t := 'S' else t := 'N';
      obsocial.GrabarOS(codos.Text, descrip.Text, catlab.Text, t, capitada.Text, StrToFloat(ub.Text), StrToFloat(ug.Text), StrToFloat(rieub.Text), StrToFloat(rieug.Text), p, StrToFloat(topemin.Text), StrToFloat(topemax.Text), StrToFloat(retencioniva.Text), retieneiva.Text, factnbu.Text, perNBU.Text, exportfact.Text, chkRuptura.Checked);
      obsocial.GuardarArancel(codos.Text, periodo.Text, t, StrToFloat(ub.Text), StrToFloat(ug.Text), StrToFloat(rieub.Text), StrToFloat(rieug.Text));
      obsocial.FijarPosicionFiscal(codos.Text, periodo.Text, StrToFloat(retencioniva.Text));
      Result := True;
    end else Begin
      utiles.msgError('No se Suministraron Suficientes Datos ...!');
      Result := False;
    end;
    CargarDeterminacionesMontoFijo;
  end;
end;

