procedure TfmExportarNBU.Button1Click(Sender: TObject);
var
  t: TTable;
  a, b: TextFile;
  valor, valor1: string;
begin
  AssignFile(a, 'c:\script_NBU.sql');
  AssignFile(b, 'c:\script_NBU1.sql');
  rewrite(a);
  rewrite(b);
  t := datosdb.openDB('nbu', '', '', 'datos');
  t.Open;
  while not t.Eof do begin
    writeln(a, 'insert into nbu(codigo, descrip, unidad) values (' + '''' + utiles.StrQuitarCaracteresEspeciales(t.FieldByName('codigo').AsString) + '''' + ', ' + '''' + utiles.StrQuitarCaracteresEspeciales(trimright(t.FieldByName('descrip').AsString)) + '''' + ', ' + valor1 + ');');
