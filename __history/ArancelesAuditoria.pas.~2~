procedure TfmArancelesDiferenciales.AKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if Key = VK_INSERT then Begin
    grid.InsertarLineasSinRenumerar(A);
    modifica := True;
    Inc(it);
  end;
  if Key = VK_DELETE then
    if utiles.BajaRegistro('Seguro que desea Eliminar Análisis ' + A.cells[1, A.Row] + ' ?') then Begin
      if obsocial.Factnbu <> 'S' then auditoriacb.BorrarAnalisisMontoFijo(codos.Text, A.cells[0, A.row]);
      grid.BorrarRenglon_SinRenumerar(A);
      Dec(it);
    end;
  if Key = VK_RETURN then Begin
    ADblClick(Sender);
    ActiveControl := codanalisis;
  end;
end;

end.
