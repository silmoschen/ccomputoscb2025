unit actualizaciones_auditoria;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  ComCtrls, ExtCtrls, StdCtrls, Mask;

type
  TfmActualizacionesAuditoria = class(TForm)
    StatusBar1: TStatusBar;
    PageControl1: TPageControl;
    TabSheetSincronizar: TTabSheet;
    TabSheetParametros: TTabSheet;
    PanelSincronizar: TPanel;
    PanelParametros: TPanel;
    GroupBoxTipo: TGroupBox;
    tsftp: TRadioButton;
    tftp: TRadioButton;
    GroupBoxRemoto: TGroupBox;
    LabelHost: TLabel;
    LabelFtp: TLabel;
    LabelUsuario: TLabel;
    LabelPassword: TLabel;
    LabelDir: TLabel;
    LabelPuerto: TLabel;
    host: TMaskEdit;
    ftp: TMaskEdit;
    usuario: TMaskEdit;
    contrasenia: TMaskEdit;
    ftpPasivo: TCheckBox;
    dirremoto: TMaskEdit;
    puerto: TMaskEdit;
    btnAplicar: TButton;
    chkNBUIndividual: TCheckBox;
    chkUnidadesNBU: TCheckBox;
    PanelBotones: TPanel;
    btnProcesar: TButton;
    btnIniciar: TButton;
    procedure FormResize(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure btnProcesarClick(Sender: TObject);
    procedure btnAplicarClick(Sender: TObject);
    procedure btnIniciarClick(Sender: TObject);
    procedure tsftpClick(Sender: TObject);
    procedure tftpClick(Sender: TObject);
  private
    { Private declarations }
    procedure loadTrans(tipo: integer);
    procedure SubirPorFTP(Archivos: TStrings);
  public
    { Public declarations }
  end;

var
  fmActualizacionesAuditoria: TfmActualizacionesAuditoria;

implementation

uses CNomeclatura_ObraSocial, CBDT, CUtiles, CSFTP, IdFTP, IdFTPCommon, HTTPCliente;

{$R *.DFM}

procedure TfmActualizacionesAuditoria.loadTrans(tipo: integer);
var
  archivo: TextFile;
  v1, v2, v3, v4, v5, v6, v7, x: string;
begin
  host.Text := '';
  ftp.Text := '';
  usuario.Text := '';
  contrasenia.Text := '';
  ftpPasivo.Checked := false;
  dirremoto.Text := '';
  puerto.Text := '22';
  x := '';

  if (tipo = 1) then begin
    if not (FileExists(dbs.DirSistema + '\ftpsauditoria.ini')) then exit;
    AssignFile(archivo, dbs.DirSistema + '\ftpsauditoria.ini');
    x := '1';
  end;

  if (tipo = 2) then begin
    if not (FileExists(dbs.DirSistema + '\ftpauditoria.ini')) then exit;
    AssignFile(archivo, dbs.DirSistema + '\ftpauditoria.ini');
    x := '1';
  end;

  if (x = '') then exit;

  reset(archivo);
  readln(archivo, v1);
  readln(archivo, v2);
  readln(archivo, v3);
  readln(archivo, v4);
  readln(archivo, v5);
  readln(archivo, v6);
  v7 := '';
  if not Eof(archivo) then readln(archivo, v7);
  v6 := '';
  if not Eof(archivo) then readln(archivo, v6);
  host.Text := v1;
  ftp.Text := v2;
  usuario.Text := v3;
  contrasenia.Text := v4;
  if (v5 = 'S') then ftpPasivo.Checked := true;
  dirremoto.Text := v6;
  if Trim(v7) <> '' then
    puerto.Text := Trim(v7)
  else if tipo = 1 then
    puerto.Text := '22'
  else
    puerto.Text := '21';

  closeFile(archivo);
end;

procedure TfmActualizacionesAuditoria.FormShow(Sender: TObject);
var
  archivo: TextFile;
  v7: string;
  tipo: integer;
begin
  tipo := 2;
  if not (FileExists(dbs.DirSistema + '\ftpauditoriasel.ini')) then tftp.Checked := true else begin
    AssignFile(archivo, dbs.DirSistema + '\ftpauditoriasel.ini');
    reset(archivo);
    readln(archivo, v7);
    closeFile(archivo);
    if (v7 = '1') then begin
      tipo := 1;
      tsftp.Checked := true;
    end else begin
      tipo := 2;
      tftp.Checked := true;
    end;
  end;
  loadTrans(tipo);
end;

function DirRemotoAuditoria(const archivoIni: string): string;
var
  archivo: TextFile;
  linea: string;
  i: integer;
begin
  Result := '';
  if not FileExists(archivoIni) then Exit;
  AssignFile(archivo, archivoIni);
  Reset(archivo);
  try
    for i := 1 to 6 do begin
      if Eof(archivo) then Exit;
      ReadLn(archivo, linea);
    end;
    Result := linea;
  finally
    CloseFile(archivo);
  end;
end;

procedure GuardarParametrosRemotos(const archivoIni: string; host, ftp, usuario, contrasenia, puerto, dirActualizaciones: string; pasivo: Boolean);
var
  archivo: TextFile;
  dirAuditoria: string;
begin
  dirAuditoria := DirRemotoAuditoria(archivoIni);
  AssignFile(archivo, archivoIni);
  Rewrite(archivo);
  WriteLn(archivo, host);
  WriteLn(archivo, ftp);
  WriteLn(archivo, usuario);
  WriteLn(archivo, contrasenia);
  if pasivo then WriteLn(archivo, 'S') else WriteLn(archivo, 'N');
  WriteLn(archivo, dirAuditoria);
  WriteLn(archivo, puerto);
  WriteLn(archivo, dirActualizaciones);
  CloseFile(archivo);
end;

procedure TfmActualizacionesAuditoria.btnAplicarClick(Sender: TObject);
var
  archivo: TextFile;
begin
  AssignFile(archivo, dbs.DirSistema + '\ftpauditoriasel.ini');
  rewrite(archivo);
  if (tsftp.Checked) then writeln(archivo, '1') else writeln(archivo, '2');
  closeFile(archivo);

  if (tsftp.Checked) then
    GuardarParametrosRemotos(dbs.DirSistema + '\ftpsauditoria.ini', host.Text, ftp.Text, usuario.Text, contrasenia.Text, puerto.Text, dirremoto.Text, ftpPasivo.Checked);

  if (tftp.Checked) then
    GuardarParametrosRemotos(dbs.DirSistema + '\ftpauditoria.ini', host.Text, ftp.Text, usuario.Text, contrasenia.Text, puerto.Text, dirremoto.Text, ftpPasivo.Checked);

  host.SetFocus;
end;

procedure TfmActualizacionesAuditoria.SubirPorFTP(Archivos: TStrings);
var
  Cliente: TIdFTP;
  Datos: TFileStream;
  i: Integer;
  Nombre, Ruta, Remoto: string;

  procedure Enviar(const Local, Destino: string);
  begin
    Datos := TFileStream.Create(Local, fmOpenRead or fmShareDenyNone);
    try
      Cliente.TransferType := ftBinary;
      Cliente.Put(Datos, Destino, False);
    finally
      Datos.Free;
    end;
  end;

begin
  Ruta := StringReplace(Trim(dirremoto.Text), '\', '/', [rfReplaceAll]);
  if Ruta = '' then
    raise Exception.Create('Falta indicar el directorio remoto.');
  if Ruta[Length(Ruta)] = '/' then
    Delete(Ruta, Length(Ruta), 1);

  Cliente := TIdFTP.Create(nil);
  try
    Cliente.Passive := True;
    Cliente.ReadTimeout := 160000;
    {$IFDEF VER140}
    Cliente.User := usuario.Text;
    {$ELSE}
    Cliente.UserName := usuario.Text;
    {$ENDIF}
    Cliente.Password := contrasenia.Text;
    Cliente.Host := ftp.Text;
    Cliente.Port := StrToIntDef(Trim(puerto.Text), 21);
    StatusBar1.Panels[0].Text := 'Conectando FTP ...!';
    StatusBar1.Refresh;
    Cliente.Connect;
    StatusBar1.Panels[0].Text := 'Directorio remoto ' + Ruta;
    StatusBar1.Refresh;
    try
      Cliente.ChangeDir(Ruta);
    except
      on E: Exception do
        raise Exception.Create(E.ClassName + ': ' + E.Message +
          ' | No se pudo acceder al directorio remoto ' + Ruta);
    end;
    for i := 0 to Archivos.Count - 1 do begin
      Nombre := ExtractFileName(StringReplace(Archivos[i], '/', '\', [rfReplaceAll]));
      Remoto := Ruta + '/' + Nombre;
      StatusBar1.Panels[0].Text := 'Transfiriendo ' + Nombre + ' ...!';
      StatusBar1.Refresh;
      try
        Enviar(Archivos[i], Nombre);
      except
        on E: Exception do
          if Pos('Could not create file', E.Message) > 0 then begin
            try
              Enviar(Archivos[i], Remoto);
            except
              on E2: Exception do
                raise Exception.Create(E2.ClassName + ': ' + E2.Message +
                  ' | ' + Remoto + ' | Sin permiso de escritura o el servidor rechazó el archivo');
            end;
          end else
            raise Exception.Create(E.ClassName + ': ' + E.Message + ' | ' + Nombre);
      end;
    end;
    if Cliente.Connected then
      Cliente.Disconnect;
  finally
    Cliente.Free;
  end;
end;

procedure TfmActualizacionesAuditoria.btnIniciarClick(Sender: TObject);
var
  Dir: string;
  Archivos: TStringList;
  SR: TSearchRec;
  i: Integer;
  Ok: Boolean;
  Fallo, Respuesta: string;
begin
  if not utiles.msgSiNo('Seguro para Transferir Datos ?') then Exit;

  Dir := dbs.DirSistema + '\auditoria\online\sincro';
  if not DirectoryExists(Dir) then begin
    utiles.msgError('No existe la carpeta de sincronización ...!');
    Exit;
  end;

  Archivos := TStringList.Create;
  try
    if FindFirst(Dir + '\*.*', faAnyFile, SR) = 0 then
    try
      repeat
        if (SR.Attr and faDirectory) = 0 then
          Archivos.Add(Dir + '\' + SR.Name);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;

    if Archivos.Count = 0 then begin
      utiles.msgError('No hay archivos para transferir ...!');
      Exit;
    end;

    if tsftp.Checked and (SFTPBuscarCliente(dbs.DirSistema) = '') then begin
      utiles.msgError('No se encuentra PSCP.EXE. Copie las herramientas SFTP a la carpeta tools\putty.');
      Exit;
    end;

    StatusBar1.Panels[0].Text := 'Transfiriendo Datos ...!';
    StatusBar1.Refresh;
    Ok := True;
    Fallo := '';

    try
      if tsftp.Checked then begin
        for i := 0 to Archivos.Count - 1 do begin
          StatusBar1.Panels[0].Text := 'Transfiriendo ' + ExtractFileName(Archivos[i]) + ' ...!';
          StatusBar1.Refresh;
          if not SFTPSubirArchivo(dbs.DirSistema, ftp.Text, usuario.Text, contrasenia.Text,
            puerto.Text, dirremoto.Text, Archivos[i]) then
            Ok := False;
        end;
      end else
        SubirPorFTP(Archivos);
    except
      on E: Exception do begin
        Ok := False;
        Fallo := E.ClassName + ': ' + E.Message;
      end;
    end;

    if Fallo <> '' then begin
      StatusBar1.Panels[0].Text := Fallo;
      utiles.msgError(Fallo);
    end else if not Ok then
      utiles.msgError('No se pudieron transferir todos los archivos ...!')
    else begin
      StatusBar1.Panels[0].Text := 'Importando datos remotos ...!';
      StatusBar1.Refresh;
      try
        Application.CreateForm(TfmClientHTML, fmClientHTML);
        try
          fmClientHTML.cbURL.Text := host.Text + '/operaciones/importar_nbu_os.php';
          fmClientHTML.FormActivate(Self);
          fmClientHTML.btnGoClick(Self);
          Respuesta := Trim(fmClientHTML.memoHTML.Lines.Text);
        finally
          fmClientHTML.Release;
          fmClientHTML := nil;
        end;
        if UpperCase(Respuesta) = 'OK' then
          StatusBar1.Panels[0].Text := 'Actualización Remota Correcta'
        else if Respuesta = '' then
          StatusBar1.Panels[0].Text := 'El servidor no devolvió respuesta'
        else
          StatusBar1.Panels[0].Text := Respuesta;
      except
        on E: Exception do
          StatusBar1.Panels[0].Text := E.ClassName + ': ' + E.Message;
      end;
    end;
    StatusBar1.Refresh;
  finally
    Archivos.Free;
  end;
end;

procedure TfmActualizacionesAuditoria.tsftpClick(Sender: TObject);
begin
  loadTrans(1);
end;

procedure TfmActualizacionesAuditoria.tftpClick(Sender: TObject);
begin
  loadTrans(2);
end;

procedure TfmActualizacionesAuditoria.FormResize(Sender: TObject);
begin
  StatusBar1.Panels[0].Width := Trunc(StatusBar1.ClientWidth * 0.8);
  StatusBar1.Panels[1].Width := StatusBar1.ClientWidth - StatusBar1.Panels[0].Width;
end;

procedure TfmActualizacionesAuditoria.btnProcesarClick(Sender: TObject);
begin
  if chkNBUIndividual.Checked then begin
    StatusBar1.Panels[0].Text := 'Procesando ...!';
    StatusBar1.Refresh;
    nomeclaturaos.GenerarNomencladosOS;
  end;
  if chkUnidadesNBU.Checked then begin
    StatusBar1.Panels[0].Text := 'Procesando ...!';
    StatusBar1.Refresh;
    nomeclaturaos.GenerarNomencladosOSUn;
  end;
  if chkNBUIndividual.Checked or chkUnidadesNBU.Checked then begin
    StatusBar1.Panels[0].Text := 'Trabajo Realizado';
    StatusBar1.Refresh;
  end;
end;

end.
