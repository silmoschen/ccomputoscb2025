procedure TfmEstadisticas.btnEmitir1Click(Sender: TObject);
begin
  if salida <> 'X' then Begin
    salida := 'P';
    if Dispositivo.Impresor.Checked then salida := 'I';
  end;

  StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
  auditoriacb.conectar;
  auditoriacb.Entidad       := Entidad.Text;
  if infDetAutorizadas.Checked then
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarOrdenesAutorizadas(fmEleObraSociales.lista, fadesde.Text, fahasta.Text, salida, CheckBox5.Checked);
  if infDetRechazadas.Checked then
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarOrdenesRechazadas(fmEleObraSociales.lista, fadesde.Text, fahasta.Text, salida, CheckBox5.Checked);
  if infTabularOS.Checked then
    auditoriacb.ListarTotalesDiariosOS(fadesde.Text, fahasta.Text, salida, '1');
  if infTabularInd.Checked then
    auditoriacb.ListarTotalesDiariosOS(fadesde.Text, fahasta.Text, salida, '2');
  if infEstMedico.Checked then Begin
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarEstadisticaMedicos(fmEleMedicos.lista, fadesde.Text, fahasta.Text, salida);
  end;
  if (infEstMedicoCabecera.Checked) and (obsocial.Buscar(fmEleMedicosCabecera.codos)) then Begin
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarEstadisticaMedicosCabecera(fmEleMedicosCabecera.lista, fmEleMedicosCabecera.codos, fadesde.Text, fahasta.Text, salida);
  end;
  if (infEstDiagnostico.Checked) and (obsocial.Buscar(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row])) then Begin
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarEstadisticaDiagnostico(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row], fadesde.Text, fahasta.Text, salida);
  end;
  if (infEstMedicoDiagnostico.Checked) and (obsocial.Buscar(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row])) then Begin
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarEstadisticaMedicoDiagnostico(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row], fadesde.Text, fahasta.Text, salida);
  end;

  if (infautrechpac.Checked) and (obsocial.Buscar(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row])) then Begin
    if (utiles.ctrlFecha(fadesde.Text, '')) and (utiles.ctrlFecha(fahasta.Text, '')) then auditoriacb.ListarEstadisticaPaciente(fmEleObraSociales.F.Cells[1, fmEleObraSociales.F.Row], nrodoc, fadesde.Text, fahasta.Text, salida);
  end;

  auditoriacb.desconectar;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  salida := 'P';

  btnSalir1.setFocus;
end;

