procedure TfmFactManual.btnExportarTotalesRIClick(Sender: TObject);
var
  r: TQuery;
  list, listprof: TStringList;
  a, ossel: string;
  i: integer;
begin
  if (fmEleObraSociales.cantidadSel = 0) then begin
    utiles.msgError('No hay Obra Social Seleccionada ...!');
    exit;
  end;

  for i := 1 to  fmEleObraSociales.F.RowCount do begin
    if (fmEleObraSociales.F.Cells[2, i] = 'S') then begin
      ossel := fmEleObraSociales.F.Cells[1, i];
      break;
    end;
  end;


  list := TStringList.Create;
  r := obsocial.getReglas;
  r.Open;
  while not r.Eof do begin
    if (r.FieldByName('codos').AsString = ossel) then list.Add(r.FieldByName('codos').AsString);
    r.next;
  end;
  r.Close; r.free;

  if (list.Count = 0) then begin
    utiles.msgError('La Obra Social Seleccionada No Admite Exportación ...!');
