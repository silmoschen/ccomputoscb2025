procedure TfmLiquidacionOS.ConsultarMontosProfesionales1Click(
  Sender: TObject);
begin
  if Length(Trim(S.Cells[5, S.Row])) > 0 then Begin
    StatusBar1.Panels[0].Text := 'Generando Consulta ...!'; StatusBar1.Refresh;
    Application.CreateForm(TfmConsultarObSoc, fmConsultarObSoc);
    fmConsultarObSoc.codos.Caption   := S.Cells[5, S.Row];
    fmConsultarObSoc.nos.Caption     := S.Cells[2, S.Row];
    fmConsultarObSoc.perfact.Caption := periodo.Text;
    fmConsultarObSoc.perliq.Caption  := S.Cells[1, S.Row];
    fmConsultarObSoc.totos.Caption   := S.Cells[4, S.Row];
    fmConsultarObSoc.ShowModal;

    fmConsultarObSoc.Release; fmConsultarObSoc := Nil;
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    codos.SetFocus;
  end else
    utiles.msgError('El Registro Seleccionado es Incorrecto ...!');
end;

procedure TfmLiquidacionOS.btnRecalcularOSClick(Sender: TObject);
var
  i, j: Integer;
  t: TStringList;
begin
  if utiles.msgSiNo('Seguro para Ajustar Totales Obras Sociales ?') then Begin
    j := S.Row;
    t := TStringList.Create;
    for i := 1 to S.RowCount do Begin
      if Length(Trim(S.Cells[0, i])) = 0 then Break;
      StatusBar1.Panels[0].Text := 'Recalculando ' + S.Cells[2, i] + ' ...!'; StatusBar1.Refresh;
      t.Clear;
      t.Add(S.Cells[5, i]);
      S.Cells[4, i] := utiles.FormatearNumero(FloatToStr(facturacion.setRecalcularProfesionalesLiquidacion(S.Cells[1, i], t, False)));
      S.Row := i;
      facturacion.IngresarMontoFacturadoObraSocial(S.Cells[1, i], S.Cells[5, i], S.Cells[1, i], StrToFloat(S.Cells[4, i]));
      S.Refresh;
    end;
    S.Row := 1;
    StatusBar1.Panels[0].Text := '';
  end;
  codos.SetFocus;
end;

end.


