    valor1 := StringReplace(valor, ',', '.', [rfReplaceAll, rfIgnoreCase]);
    writeln(b, 'update nbu set unidad = ' +  valor1 + ' where codigo = ' + '''' + t.FieldByName('codigo').AsString + '''' + ';');
    t.Next;
  end;
  t.Close;
  closeFile(a);
  closeFile(b);
  Close;
end;

