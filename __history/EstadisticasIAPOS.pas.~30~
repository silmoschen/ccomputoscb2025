procedure TfmEstadisticasIAPOS.Button2Click(Sender: TObject);
begin
  if (obsocial.Buscar(codos1.Text)) and (utiles.verificarPeriodo(periodo1.Text, ''))  then begin
    StatusBar1.Panels[0].Text := 'Generando Informe ...!'; StatusBar1.Refresh;
    facturacion.conectar;
    facturacion.ProcesarDatosCentrales(periodo1.Text);
    estadisticaCCB.InicidenciaPorDeterminacion_Detallada(periodo1.Text, codos1.Text, '', salida, true, true, false, CheckBox1.Checked);
    StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
    facturacion.desconectar;
    estadisticaCCB.Listar(salida);
    codos1.setFocus;
  end else
    utiles.msgError('La Obra Social o el Período son Incorrectos ...!');
end;

