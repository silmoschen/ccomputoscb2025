procedure TfmEstadisticasIAPOS.Button7Click(Sender: TObject);
begin
  Application.CreateForm(TfmAjustarDebitos, fmAjustarDebitos);
  fmAjustarDebitos.montofact.Text := R.Cells[2, R.Row];
  fmAjustarDebitos.pago.Text  := R.Cells[3, R.Row];
  fmAjustarDebitos.monto.Text := R.Cells[5, R.Row];
  fmAjustarDebitos.ShowModal;
  R.Cells[5, R.Row]           := utiles.FormatearNumero(fmAjustarDebitos.monto.Text);
  R.Cells[3, R.Row]           := utiles.FormatearNumero(fmAjustarDebitos.pago.Text);
  R.Cells[2, R.Row]           := utiles.FormatearNumero(fmAjustarDebitos.montofact.Text);
  estadisticaccb.AjustarDebito(codos1.Text, perliq.Caption, R.Cells[0, R.Row], StrToFloat(R.Cells[5, R.Row]), StrToFloat(R.Cells[3, R.Row]));
  fmAjustarDebitos.Release; fmAjustarDebitos := nil;
end;

procedure TfmEstadisticasIAPOS.Button8Click(Sender: TObject);
var
  i: integer;
begin
  Application.CreateForm(TfmAjustarFechas, fmAjustarFechas);
  fmAjustarFechas.fecha.Text := R.Cells[4, R.Row];
  fmAjustarFechas.ShowModal;
  if (fmAjustarFechas.CheckBox1.Checked) then begin
    for i := 1 to R.RowCount do begin
      if (length(trim(R.Cells[0, i])) = 0) then break;
      R.Cells[4, i] := fmAjustarFechas.fecha.text;
      estadisticaccb.AjustarFecha(copy(E.Cells[1, E.Row], 1, 6), perliq.Caption, R.Cells[0, i], R.Cells[4, i]);
    end;
  end else begin
    R.Cells[4, R.Row]  := fmAjustarFechas.fecha.text;
    estadisticaccb.AjustarFecha(copy(E.Cells[1, E.Row], 1, 6), perliq.Caption, R.Cells[0, R.Row], R.Cells[4, R.Row]);
  end;
  fmAjustarFechas.Release; fmAjustarFechas := nil;
end;

procedure TfmEstadisticasIAPOS.Button9Click(Sender: TObject);
var
  i: integer;
begin
  if (utiles.msgSiNo('Seguro para Sincronizar Montos Pagados con Montos Facturados ?')) then begin
    for i := 1 to R.RowCount do begin
      if (length(trim(R.Cells[0, i])) = 0) then break;
      R.Cells[3, i] := R.Cells[2, i];
      estadisticaccb.AjustarPago(copy(E.Cells[1, E.Row], 1, 6), perliq.Caption, R.Cells[0, i], StrToFloat(R.Cells[3, i]));
    end;
  end;
  E.setFocus;
end;

