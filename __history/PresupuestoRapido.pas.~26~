unit PresupuestoRapido;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, Grids, StdCtrls, Editv, Buttons, Mask, ExtCtrls, Menus;

type
  TfmPresupuestoRapido = class(TForm)
    Panel2: TPanel;
    ScrollBox: TScrollBox;
    Panel9: TPanel;
    GroupBox3: TGroupBox;
    Label10: TLabel;
    Label39: TLabel;
    codanalisis: TMaskEdit;
    buscarAnalisis: TBitBtn;
    Panel6: TPanel;
    Label2: TLabel;
    Label3: TLabel;
    codos: TMaskEdit;
    BuscarOS: TBitBtn;
    nos: TLabel;
    Panel3: TPanel;
    Panel1: TPanel;
    Label15: TLabel;
    des: TLabel;
    total: TLabel;
    Label1: TLabel;
    tot9984: TLabel;
    PopupMenu: TPopupMenu;
    InsertarItems1: TMenuItem;
    ModificarItems1: TMenuItem;
    N1: TMenuItem;
    BorrarItems1: TMenuItem;
    Panel10: TPanel;
    F: TStringGrid;
    Label11: TLabel;
    precio: TEditValid;
    Panel4: TPanel;
    Label4: TLabel;
    preciofinal: TLabel;
    Label5: TLabel;
    retiva: TLabel;
    Label6: TLabel;
    totalf: TLabel;
    Panel5: TPanel;
    btnImprimir: TButton;
    Label67: TLabel;
    UB: TLabel;
    Label68: TLabel;
    UG: TLabel;
    RIEUG: TLabel;
    Label70: TLabel;
    Label71: TLabel;
    RIEUB: TLabel;
    Label7: TLabel;
    NNBU: TLabel;
    btnCerrar: TButton;
    Label9: TLabel;
    Unnbu: TLabel;
    Panel7: TPanel;
    t1: TEdit;
    t2: TEdit;
    t3: TEdit;
    Label8: TLabel;
    Label12: TLabel;
    Label13: TLabel;
    procedure codosKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure BuscarOSClick(Sender: TObject);
    procedure cerrarClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure buscarAnalisisClick(Sender: TObject);
    procedure codanalisisKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure precioKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure FKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
