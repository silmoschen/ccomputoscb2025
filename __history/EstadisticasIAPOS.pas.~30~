procedure TfmEstadisticasIAPOS.DatosObraSocial;
begin
  obsocial.getDatos(codos.Text);
  os.Caption := obsocial.Nombre;
  CargarUnidades;
  periodo.setFocus;
end;

procedure TfmEstadisticasIAPOS.DatosObraSocial1;
begin
  obsocial.getDatos(codos1.Text);
  os1.Caption := obsocial.Nombre;
  Button1.setFocus;
end;

procedure TfmEstadisticasIAPOS.EDblClick(Sender: TObject);
begin
  CargarTotales;
end;

procedure TfmEstadisticasIAPOS.EKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (Key = VK_DELETE) then
    if (length(trim(E.Cells[0, E.Row])) > 0) then begin
      if (utiles.msgSiNo('Seguro para Borrar Total Obra Social ' + E.Cells[1, E.Row] + ' ?')) then begin
        estadisticaccb.BorrarTotalesInicidenciaPorDeterminacion_Detallada(perliq.Caption, copy(E.Cells[1, E.Row], 1, 6));
        TabSheet2Show(Self);
      end;
    end else
      utiles.msgError('El Registro Seleccionado es Incorrecto ...!');
end;

procedure TfmEstadisticasIAPOS.CargarUnidades;
var
  l: TObjectList;
  objeto: TTUBReferente;
  i: integer;
begin
  grid.IniciarGrilla(S);
  l := uref.getObjects(codos.Text);
  for i := 1 to l.Count do begin
    objeto := TTUBReferente(l.Items[i-1]);
    S.Cells[0, i] := objeto.Periodo;
    S.Cells[1, i] := utiles.FormatearNumero(FloatToStr(objeto.Unidad));
    S.Row         := i;
  end;
  l.Destroy; l := Nil;
end;

procedure TfmEstadisticasIAPOS.CheckBox2Click(Sender: TObject);
begin
  if (CheckBox2.Checked) then begin
    porcentaje.Enabled := true;
    btnRecalcular.Enabled := true;
  end else begin
    porcentaje.Enabled := false;
    btnRecalcular.Enabled := false;
  end;
end;

procedure TfmEstadisticasIAPOS.CargarTotales;
var
  l, t: TStringList;
  i, p: Integer;
  x: real;
Begin
  StatusBar1.Panels[0].Text := 'Prorratenado Montos Pagos a Profesionales ...!'; StatusBar1.Refresh;
  grid.IniciarGrilla(R);
  t := TStringList.Create;
  t.Add(copy(E.Cells[1, E.Row], 1, 6));
  l := facturacion.setTotalProfesionalesLiquidacion(perliq.Caption, t, False);
  For i := 1 to l.Count do Begin
    profesional.getDatos(Copy(l.Strings[i-1], 1, 6));
    p := Pos(';1', l.Strings[i-1]);
    R.Cells[0, i] := Copy(l.Strings[i-1], 1, 6);
    R.Cells[1, i] := profesional.nombre;
    R.Cells[2, i] := utiles.FormatearNumero(Copy(l.Strings[i-1], p+2, 10));
    estadisticaccb.getDatos(copy(E.Cells[1, E.Row], 1, 6), perLiq.Caption, profesional.codigo);

    // 29-05-2017


    if (estadisticaccb.Pago = -100000) then begin
      R.Cells[3, i] := R.Cells[2, i];
      estadisticaccb.AjustarDebito(codos1.Text, perliq.Caption, profesional.codigo, estadisticaccb.Debito, StrToFloat(R.Cells[3, i]));
    end else
      R.Cells[3, i] := utiles.FormatearNumero(FloatToStr(estadisticaccb.Pago));
    R.Cells[4, i] := estadisticaccb.Fepago;
    R.Cells[5, i] := utiles.FormatearNumero(FloatToStr(estadisticaccb.Debito));
    R.Cells[6, i] := copy(E.Cells[1, E.Row], 1, 6);
  end;

  x := 0;
  For i := 1 to R.RowCount do Begin
    if Length(Trim(R.Cells[0, i])) = 0 then Break;
    x := x + StrToFloat(R.Cells[2, i]);
  end;
  totos.Caption := utiles.FormatearNumero(FloatToStr(x));
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
  E.SetFocus;
end;

procedure TfmEstadisticasIAPOS.codos1KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (Key = VK_RETURN) or (Key = VK_DOWN) then begin 
    if (obsocial.Buscar(codos1.Text)) then DatosObraSocial1 else BuscarOS1Click(Self);
