procedure TfmFactManual.importMailClick(Sender: TObject);
var
  conectar: Boolean;
  con: Cardinal;
begin
  if importMail.Checked then Begin
    detalleOS.Caption := '&Consultar Obras Sociales Fact.';
    utilesarchivos.BorrarArchivos(facturacion.setDirectorioImportacion, '*.bck');

    DriveComboBox1.Enabled := False;
    imp.Enabled            := False;
    conectar               := False;

    Application.CreateForm(TAutoForm, AutoForm);
    Application.CreateForm(TConfigureAutoForm, ConfigureAutoForm);
    Application.CreateForm(TAboutForm, AboutForm);
    Application.CreateForm(TRasDialerForm, RasDialerForm);
    Application.CreateForm(TTimeAutoForm, TimeAutoForm);
    if Length(Trim(RasDialerForm.setIPAdress)) = 0 then   // Si No esta conectado
      if utiles.msgSiNo('Conectarse a Internet y', 'Consultar Facturaciones Enviadas ?') then Begin
        RasDialerForm.ShowModal;
        con := RasDialerForm.hRasConn;
        if Length(Trim(RasDialerForm.setIPAdress)) > 0 then conectar := True;
      end;

    if Length(Trim(RasDialerForm.setIPAdress)) > 0 then Begin
      Application.CreateForm(TfmMain, fmMain);
      fmMain.dirDestino := facturacion.setDirectorioImportacion;
      fmMain.conexionAutomatica := True;
      fmMain.ShowModal;

      ImportarDatos;

      if conectar then   // Si solo nos conectamos a Internet para transferir
        if utiles.msgSiNo('Desea Cerrar la Conexión a Internet en este Momento  ?') then Begin
          StatusBar1.Panels[0].Text := 'Desconectando ...!'; Refresh;
          Application.CreateForm(TRasDialerForm, RasDialerForm);
          RasDialerForm.hRasConn := con;
          RasDialerForm.CancelButtonClick(Sender);
          StatusBar1.Panels[0].Text := ''; Refresh;
        end;
      fmMain.Release; fmMain := nil;
    end;

    AutoForm.Release; AutoForm := nil;
    ConfigureAutoForm.Release; ConfigureAutoForm := nil;
    AboutForm.Release; AboutForm := nil;
    RasDialerForm.Release; RasDialerForm := nil;
    TimeAutoForm.Release; TimeAutoForm := nil;

    importMail.Checked := False;
    ActiveControl      := periodoImp;

    if (imp.Enabled) and (Length(Trim(D.Cells[0, 1])) > 0) then
      if utiles.msgSiNo('Procesar Laboratorios Importados ?') then impClick(Self);

  end else
    DriveComboBox1.Enabled := True;
end;

