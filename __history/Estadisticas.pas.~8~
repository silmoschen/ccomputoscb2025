procedure TfmEstadisticas.totFOSClick(Sender: TObject);
begin
  StatusBar1.Panels[0].Text := 'Procesando Total Facturado Obras Sociales'; StatusBar1.Refresh;
  totFOS.Enabled   := False;
  facturacion.ProcesarDatosCentrales(perAjuste.Text);
  totf.Caption := utiles.FormatearNumero(FloatToStr(facturacion.setTotalFacturado(perajuste.Text))); totf.Refresh;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;

  StatusBar1.Panels[0].Text := 'Procesando Total Facturado Profesionales'; StatusBar1.Refresh;
  totp.Caption := utiles.FormatearNumero(FloatToStr(facturacion.setTotalFacturadoProfesionales(perajuste.Text))); totp.Refresh;
  facturacion.CalcularMontosFacturacion(perajuste.Text);
  facturacion.desconectar;
  totFOS.Enabled   := True;
  StatusBar1.Panels[0].Text := ''; StatusBar1.Refresh;
end;

